774.8L53.0 774.4L54.9 776.3L55.2 778.3L55.5 780.3L55.1 782.3ZM33.6 965.8L33.5 968.1L32.1 969.1L30.5 968.4L29.5 968.3L28.0 969.6L26.7 970.2L24.8 970.1L22.2 969.2L19.9 972.8L18.8 974.0L16.5 975.6L16.3 973.7L17.7 970.8L18.4 968.8L19.7 965.8L22.3 966.9L26.0 965.8L29.5 963.8L32.3 963.7L33.3 964.9L33.6 965.8ZM22.0 937.9L17.5 940.2L16.1 939.2L12.9 939.2L13.7 936.8L14.0 934.9L14.7 932.7L15.7 929.8L18.4 930.7L20.4 931.0L23.2 932.0L26.2 932.6L27.0 935.1L24.2 936.2L22.0 937.9ZM51.0 754.0L51.5 755.4L50.4 755.6L48.8 755.4L48.0 756.5L43.8 755.7L43.3 753.8L47.3 753.7L49.9 752.8L51.0 754.0ZM43.3 984.4L40.0 984.0L38.7 983.4L36.7 981.9L36.4 980.4L35.5 978.5L38.2 979.2L40.1 981.0L43.5 982.6L43.8 983.8ZM39.3 807.0L38.0 808.3L35.7 808.9L33.5 807.9L30.8 808.3L30.5 806.2L31.6 804.4L33.6 802.3L35.1 799.4L34.9 795.4L36.1 794.5L36.7 793.1L39.3 792.2L39.9 795.2L39.3 800.5L40.9 803.7L41.2 804.7L40.9 805.9L39.3 807.0ZM196.2 1096.9L195.3 1096.9L193.2 1096.4L190.2 1096.2L190.1 1095.1L191.8 1094.8L196.8 1095.0L197.7 1095.6L196.8 1096.5ZM221.8 1078.1L220.0 1079.3L218.6 1079.3L218.1 1078.2L218.9 1077.1L220.2 1076.4L222.7 1077.0L221.8 1078.1ZM116.6 1067.8L117.7 1069.6L121.0 1070.7L122.2 1070.2L125.3 1070.0L127.3 1069.3L130.0 1069.0L133.1 1073.4L132.8 1074.8L130.3 1076.3L128.6 1076.6L127.0 1076.1L126.9 1074.8L125.8 1073.9L124.8 1074.0L123.2 1074.6L122.3 1074.5L120.7 1073.8L117.8 1073.3L117.2 1071.8L113.6 1069.8L111.7 1068.6L110.0 1068.4L108.8 1069.1L107.4 1069.7L106.5 1069.1L106.8 1067.0L107.7 1066.9L111.9 1067.2L114.4 1067.8L116.6 1067.8ZM202.8 1093.7L202.0 1093.9L200.4 1093.0L196.5 1092.2L196.8 1091.0L199.1 1089.8L200.3 1088.2L201.4 1089.0L202.3 1091.1L203.5 1092.7L202.8 1093.7Z","W":232.8,"H":1100,"lon0":-76,"lat0":-17.3,"k":0.8191520442889918,"s":28.42377260981912};
const CATL=[['tel','iPhone','#ff8c1a'],['comp','Mac','#a43bff'],['tab','iPad','#ffe600'],['wear','Watch','#00e5ff'],['aud','AirPods','#d65cff'],['exc','Exchange Planes','#2bff88'],['cp','Compra Protegida','#4cd93c']];
document.body.insertAdjacentHTML('beforeend',`<div class="ovl" id="dOvl" hidden><div class="mdl dash"><button class="x" type="button" data-close="dOvl" aria-label="Cerrar">×</button><h2>Impacto de la calculadora</h2>
 <div class="flt"><div class="segc" role="group" aria-label="Período" id="dPer"><button type="button" data-per="d">Hoy</button><button type="button" data-per="w" aria-pressed="true">Semana</button><button type="button" data-per="m">Mes</button><button type="button" data-per="q">13 semanas</button></div>
  <select id="dSt" style="max-width:280px;font-size:14px;background:var(--surface-2);color:var(--ink);border:1px solid var(--line);border-radius:12px;padding:8px 10px"><option value="">Todas las tiendas</option>${STORES.map(s=>`<option value="${s[0]}">${esc(s[1])}</option>`).join('')}</select>
  <div class="qact" style="margin-left:auto"><button type="button" id="dXls">Descargar Excel</button><button type="button" class="pri" id="dPdf">Descargar PDF</button></div></div>
 <p class="note" id="dInfo"></p><div class="kp" id="dKp"></div>
 <div class="g2"><div class="box"><h3>Ingresos y cotizaciones por semana (13 semanas)</h3><canvas id="cW"></canvas></div><div class="box"><h3>Uso diario</h3><canvas id="cD"></canvas></div></div>
 <div class="g2"><div class="box"><h3>Uso por categoría</h3><canvas id="cC"></canvas></div><div class="box"><h3>Cotizaciones por tipo</h3><canvas id="cQ"></canvas></div></div>
 <div class="box"><h3>Mapa de Chile · ingresos por tienda (de Arica a Punta Arenas)</h3><div class="map" id="dMap"></div></div>
 <div class="box"><h3>Ranking de tiendas</h3><div id="dTbl"></div></div>
 <p class="note">Las semanas van de lunes a domingo y el panel se actualiza solo con cada uso. La ubicación de cada tienda es aproximada (centro comercial o ciudad). Solo se cuenta el uso de la calculadora publicada en Claude; la copia de GitHub no envía datos.</p></div></div>`);
let DPER='w',DST='',DROWS=[],CHS={};
const dstr=d=>d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
const monday=d=>{const x=new Date(d);const k=(x.getDay()+6)%7;x.setDate(x.getDate()-k);x.setHours(0,0,0,0);return x};
function range(p){const now=new Date();if(p==='d')return [dstr(now),dstr(now)];if(p==='w')return [dstr(monday(now)),dstr(now)];if(p==='m')return [dstr(new Date(now.getFullYear(),now.getMonth(),1)),dstr(now)];const m=monday(now);m.setDate(m.getDate()-7*12);return [dstr(m),dstr(now)]}
async function loadRows(){const m=monday(new Date());m.setDate(m.getDate()-7*12);const from=dstr(m);let rows=[];
  try{const s=await DB.collection('stats').where('d','>=',from).limit(5000).get();rows=s.docs.map(x=>x.data()).filter(r=>r&&r.v>=6&&r.d)}catch(e){rows=[]}
  /* incluye lo que aún no se guarda de este equipo */
  const me=rows.find(r=>r.dev===DEV&&r.d===STAT.d);const cur={d:STAT.d,dev:DEV,store:STORE};KEYS.forEach(k=>cur[k]=STAT.c[k]||0);if(me)Object.assign(me,cur);else rows.push(cur);return rows}
const sum=(rs,k)=>rs.reduce((a,r)=>a+(Number(r[k])||0),0);
function paintDash(){const [a,b]=range(DPER);const base=DROWS.filter(r=>!DST||r.store===DST);const rs=base.filter(r=>r.d>=a&&r.d<=b);
  document.querySelectorAll('[data-per]').forEach(x=>x.setAttribute('aria-pressed',String(x.dataset.per===DPER)));
  $('dInfo').textContent=`Del ${a.split('-').reverse().join('/')} al ${b.split('-').reverse().join('/')} · ${DST?stById(DST)[1]:'todas las tiendas'} · ${new Set(rs.map(r=>r.dev)).size} equipos`;
  const K=[['open','Ingresos a la calculadora'],['int','Interacciones'],['q','Cotizaciones en cuotas'],['excq','Exchange cotizados'],['cpq','Compra Protegida cotizada'],['mailpdf','Cotizaciones enviadas por mail']];
  $('dKp').innerHTML=K.map(([k,l])=>`<div><b>${(k==='mailpdf'?sum(rs,'mail')+sum(rs,'pdf'):sum(rs,k)).toLocaleString('es-CL')}</b><span>${l}</span></div>`).join('');
  if(!window.Chart){$('dInfo').textContent+=' · No se pudieron cargar los gráficos (sin conexión).';paintMapTable(a,b,rs);return}paintCharts(a,b,base,rs);paintMapTable(a,b,rs)}
function paintCharts(a,b,base,rs){
  Chart.defaults.color='#aaa';Chart.defaults.borderColor='rgba(255,255,255,.08)';Chart.defaults.font.family='-apple-system,BlinkMacSystemFont,Helvetica,Arial,sans-serif';
  const mk=(id,cfg)=>{if(CHS[id])CHS[id].destroy();CHS[id]=new Chart($(id),cfg)};
  /* semanas */
  const m0=monday(new Date());const wk=[];for(let i=12;i>=0;i--){const s=new Date(m0);s.setDate(s.getDate()-7*i);const e=new Date(s);e.setDate(e.getDate()+6);wk.push([dstr(s),dstr(e)])}
  const wr=w=>base.filter(r=>r.d>=w[0]&&r.d<=w[1]);
  mk('cW',{type:'bar',data:{labels:wk.map((w,i)=>'S'+(i+1)+' · '+w[0].slice(8)+'/'+w[0].slice(5,7)),datasets:[{label:'Ingresos',data:wk.map(w=>sum(wr(w),'open')),backgroundColor:'#ffffff'},{label:'Cotizaciones',data:wk.map(w=>sum(wr(w),'q')+sum(wr(w),'excq')+sum(wr(w),'cpq')),backgroundColor:'#30d158'}]},options:{responsive:true,plugins:{legend:{position:'bottom'}},scales:{y:{beginAtZero:true,ticks:{precision:0}}}}});
  /* días */
  const days=[];const dA=new Date(a+'T12:00:00'),dB=new Date(b+'T12:00:00');let span=Math.round((dB-dA)/864e5);const st=span<6?new Date(dB.getTime()-6*864e5):dA;for(let d=new Date(st);d<=dB;d.setDate(d.getDate()+1))days.push(dstr(d));
  mk('cD',{type:'line',data:{labels:days.map(d=>d.slice(8)+'/'+d.slice(5,7)),datasets:[{label:'Ingresos',data:days.map(d=>sum(base.filter(r=>r.d===d),'open')),borderColor:'#fff',backgroundColor:'rgba(255,255,255,.15)',fill:true,tension:.3},{label:'Interacciones',data:days.map(d=>sum(base.filter(r=>r.d===d),'int')),borderColor:'#0a84ff',tension:.3,yAxisID:'y1'}]},options:{responsive:true,plugins:{legend:{position:'bottom'}},scales:{y:{beginAtZero:true,ticks:{precision:0}},y1:{beginAtZero:true,position:'right',grid:{display:false},ticks:{precision:0}}}}});
  const pie=(id,lab,val,col)=>mk(id,{type:'doughnut',data:{labels:lab,datasets:[{data:val,backgroundColor:col,borderColor:'#1c1c1e',borderWidth:2}]},options:{responsive:true,cutout:'55%',plugins:{legend:{position:'right'}}}});
  pie('cC',CATL.map(c=>c[1]),CATL.map(c=>sum(rs,c[0])),CATL.map(c=>c[2]));
  pie('cQ',['Cuotas','Exchange','Compra Protegida','Mail / PDF'],[sum(rs,'q'),sum(rs,'excq'),sum(rs,'cpq'),sum(rs,'mail')+sum(rs,'pdf')],['#ffffff','#2bff88','#4cd93c','#0a84ff']);
}
function paintMapTable(a,b,rs){
  /* mapa */
  const byS={};for(const r of DROWS.filter(r=>r.d>=a&&r.d<=b)){if(!r.store)continue;byS[r.store]=(byS[r.store]||0)+(Number(r.open)||0)}
  const mx=Math.max(1,...Object.values(byS));const W=CH.W,Hh=CH.H;const P=(la,lo)=>[(CH.lat0-la)*CH.s,W-(lo-CH.lon0)*CH.k*CH.s];
  $('dMap').innerHTML=`<svg viewBox="-10 -30 ${Hh+20} ${W+60}" role="img" aria-label="Mapa de Chile con tiendas"><g transform="matrix(0,-1,1,0,0,${W})"><path d="${CH.d}" fill="#2c2c2e" stroke="#636366" stroke-width="1"/></g>
   ${STORES.map(s=>{const [x,y]=P(s[3],s[4]);const v=byS[s[0]]||0;const r=v?4+10*Math.sqrt(v/mx):3;return `<g><circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="${r.toFixed(1)}" fill="${v?'#30d158':'#8e8e93'}" fill-opacity="${v?.85:.6}" stroke="${s[0]===DST?'#fff':'none'}" stroke-width="2"><title>${esc(s[1])}: ${v} ingresos</title></circle></g>`}).join('')}
   ${[['Arica',-18.48],['Antofagasta',-23.65],['La Serena',-29.9],['Santiago',-33.45],['Concepción',-36.82],['Puerto Montt',-41.47],['Coyhaique',-45.57],['Punta Arenas',-53.15]].map(([n,la])=>{const [x]=P(la,-70);return `<text x="${x.toFixed(0)}" y="${W+22}" font-size="12" fill="#aaa" text-anchor="middle">${n}</text>`}).join('')}</svg>`;
  /* tabla */
  const sr={};for(const r of rs){const k=r.store||'';const o=sr[k]||(sr[k]={open:0,int:0,q:0,excq:0,cpq:0,mail:0,dev:new Set()});['open','int','q','excq','cpq'].forEach(x=>o[x]+=Number(r[x])||0);o.mail+=(Number(r.mail)||0)+(Number(r.pdf)||0);o.dev.add(r.dev)}
  const lst=Object.entries(sr).sort((x,y)=>y[1].open-x[1].open);
  $('dTbl').innerHTML=lst.length?`<table><tr><th>Tienda</th><th>Ingresos</th><th>Interacciones</th><th>Cuotas</th><th>Exchange</th><th>Compra Prot.</th><th>Mail/PDF</th><th>Equipos</th></tr>${lst.map(([k,o])=>`<tr><td>${esc(k?(stById(k)||[0,k])[1]:'Sin tienda asignada')}</td><td>${o.open}</td><td>${o.int}</td><td>${o.q}</td><td>${o.excq}</td><td>${o.cpq}</td><td>${o.mail}</td><td>${o.dev.size}</td></tr>`).join('')}</table>`:'<p class="note">Aún no hay datos en este período.</p>'}
async function openDash(){$('dOvl').hidden=false;$('dInfo').textContent='Cargando datos…';try{await loadJS(CHARTJS)}catch(_){}
  await STAT.save();DROWS=await loadRows();paintDash()}
$('dashB').addEventListener('click',openDash);
$('dPer').addEventListener('click',e=>{const b=e.target.closest('[data-per]');if(!b)return;DPER=b.dataset.per;paintDash()});
$('dSt').addEventListener('change',e=>{DST=e.target.value;paintDash()});
function reportTables(){const [a,b]=range(DPER);const base=DROWS.filter(r=>!DST||r.store===DST);const rs=base.filter(r=>r.d>=a&&r.d<=b);
  const res=[['Período',`${a} a ${b}`],['Tienda',DST?stById(DST)[1]:'Todas'],['Ingresos a la calculadora',sum(rs,'open')],['Interacciones',sum(rs,'int')],['Cotizaciones en cuotas',sum(rs,'q')],['Exchange cotizados',sum(rs,'excq')],['Compra Protegida cotizada',sum(rs,'cpq')],['Cotizaciones por mail / PDF',sum(rs,'mail')+sum(rs,'pdf')],['Equipos activos',new Set(rs.map(r=>r.dev)).size]];
  const m0=monday(new Date());const wk=[];for(let i=12;i>=0;i--){const s=new Date(m0);s.setDate(s.getDate()-7*i);const e=new Date(s);e.setDate(e.getDate()+6);const w=base.filter(r=>r.d>=dstr(s)&&r.d<=dstr(e));wk.push(['S'+(13-i),dstr(s),dstr(e),sum(w,'open'),sum(w,'int'),sum(w,'q'),sum(w,'excq'),sum(w,'cpq'),sum(w,'mail')+sum(w,'pdf')])}
  const dd={};for(const r of rs){const o=dd[r.d]||(dd[r.d]=[r.d,0,0,0,0,0,0]);o[1]+=+r.open||0;o[2]+=+r.int||0;o[3]+=+r.q||0;o[4]+=+r.excq||0;o[5]+=+r.cpq||0;o[6]+=(+r.mail||0)+(+r.pdf||0)}
  const sr={};for(const r of rs){const k=r.store||'';const o=sr[k]||(sr[k]=[k?(stById(k)||[0,k])[1]:'Sin tienda',k?(stById(k)||[0,0,''])[2]:'',0,0,0,0,0,0]);o[2]+=+r.open||0;o[3]+=+r.int||0;o[4]+=+r.q||0;o[5]+=+r.excq||0;o[6]+=+r.cpq||0;o[7]+=(+r.mail||0)+(+r.pdf||0)}
  return {res,wk,days:Object.values(dd).sort((x,y)=>x[0]<y[0]?-1:1),stores:Object.values(sr).sort((x,y)=>y[2]-x[2]),cats:CATL.map(c=>[c[1],sum(rs,c[0])]),a,b}}
$('dXls').addEventListener('click',async()=>{try{await loadJS(XLSXJS);const T=reportTables();const wb=XLSX.utils.book_new();const add=(n,rows)=>XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet(rows),n);
  add('Resumen',[['Impacto calculadora Financiamiento Falabella'],[],['Indicador','Valor'],...T.res]);
  add('Semanas',[['Semana','Desde','Hasta','Ingresos','Interacciones','Cuotas','Exchange','Compra Protegida','Mail/PDF'],...T.wk]);
  add('Días',[['Fecha','Ingresos','Interacciones','Cuotas','Exchange','Compra Protegida','Mail/PDF'],...T.days]);
  add('Tiendas',[['Tienda','Región','Ingresos','Interacciones','Cuotas','Exchange','Compra Protegida','Mail/PDF'],...T.stores]);
  add('Categorías',[['Categoría','Ingresos'],...T.cats]);
  const out=XLSX.write(wb,{bookType:'xlsx',type:'array'});await saveFile(`Impacto_Calculadora_${T.a}_${T.b}.xlsx`,new Blob([out],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'}))}catch(e){alertNote('No se pudo generar el Excel.')}});
function alertNote(t){$('dInfo').textContent=t}
$('dPdf').addEventListener('click',async()=>{try{await loadJS(JSPDF);await loadJS(AUTOT);const T=reportTables();const {jsPDF}=window.jspdf;const doc=new jsPDF({unit:'pt',format:'a4'});
  doc.setFillColor(0,0,0);doc.rect(0,0,595,78,'F');doc.setTextColor(255,255,255);doc.setFontSize(20);doc.text('Impacto calculadora · Financiamiento Falabella',36,44);doc.setFontSize(10);doc.text(`${T.res[0][1]} · ${T.res[1][1]}`,36,62);
  doc.setTextColor(20,20,20);doc.autoTable({startY:92,head:[['Indicador','Valor']],body:T.res.slice(2),theme:'grid',headStyles:{fillColor:[30,30,30]},styles:{fontSize:10}});
  let y=doc.lastAutoTable.finalY+14;const img=(id,w,h)=>{try{const c=$(id);const u=c.toDataURL('image/png');if(y+h>800){doc.addPage();y=40}doc.setFillColor(28,28,30);doc.rect(36,y,w,h,'F');doc.addImage(u,'PNG',40,y+4,w-8,h-8);y+=h+10}catch(_){}};
  img('cW',523,200);img('cC',255,170);y-=180;const sx=36+268;try{const u=$('cQ').toDataURL('image/png');doc.setFillColor(28,28,30);doc.rect(sx,y,255,170,'F');doc.addImage(u,'PNG',sx+4,y+4,247,162)}catch(_){}y+=180;
  doc.addPage();doc.autoTable({startY:40,head:[['Semana','Desde','Hasta','Ingresos','Interacc.','Cuotas','Exchange','Compra P.','Mail/PDF']],body:T.wk,theme:'grid',headStyles:{fillColor:[30,30,30]},styles:{fontSize:9}});
  doc.autoTable({startY:doc.lastAutoTable.finalY+16,head:[['Tienda','Región','Ingresos','Interacc.','Cuotas','Exchange','Compra P.','Mail/PDF']],body:T.stores,theme:'grid',headStyles:{fillColor:[30,30,30]},styles:{fontSize:9}});
  doc.setFontSize(8);doc.setTextColor(110,110,110);doc.text('Generado el '+new Date().toLocaleString('es-CL')+'. Semanas de lunes a domingo. Ubicación de tiendas aproximada.',36,820);
  await saveFile(`Impacto_Calculadora_${T.a}_${T.b}.pdf`,doc.output('blob'))}catch(e){alertNote('No se pudo generar el PDF.')}});
})();
</script>
<script>
/* ================== PLANES: cuota inicial + cargo fijo por compañía ================== */
(function(){
const OPS=['CLARO','ENTEL','WOM'];const ON={CLARO:'Claro',ENTEL:'Entel',WOM:'WOM'};
S.pl=S.pl||null;S.plOp=S.plOp||'';
const capK=()=>String(S.capa||'').replace(/\s/g,'');
const rowsFor=(nm)=>(window.PLA&&PLA.items||[]).filter(r=>r[0]===nm&&r[5]>=9990);
function caps(){const m=model();const o=['64GB','128GB','256GB','512GB','1TB','2TB'];return [...new Set(rowsFor(m?m.name:'').map(r=>r[1]))].sort((a,b)=>o.indexOf(a)-o.indexOf(b))}
function curCap(){const cs=caps();const k=capK();return cs.includes(k)?k:(cs[0]||'')}
function plans(){const m=model();if(!m)return [];const c=curCap();return rowsFor(m.name).filter(r=>r[1]===c).map(r=>({op:r[2],pn:r[3],fee:r[4],ci:r[5],mo:r[6]||18}))}
window.plOferta=function(){const m=model();if(!m||!window.APR)return S.price;const c=curCap();const r=APR.items.find(x=>x[0]===m.name&&x[1]===c)||APR.items.find(x=>x[0]===m.name);return r&&r[2]>0?r[2]:S.price};
window.plSel=function(){if(!planOn())return null;const ps=plans();if(!ps.length)return null;let p=S.pl&&ps.find(x=>x.op===S.pl.op&&x.pn===S.pl.pn&&x.fee===S.pl.fee);
  if(!p){const op=S.plOp&&ps.some(x=>x.op===S.plOp)?S.plOp:ps.slice().sort((a,b)=>a.ci-b.ci)[0].op;p=ps.filter(x=>x.op===op).sort((a,b)=>a.ci-b.ci)[0];S.pl=p;S.plOp=op}return p};
const dd=t=>String(t||'').slice(0,10).split('-').reverse().join('/');
window.plCI=function(box){const p=plSel(),o=plOferta();if(!p)return box?'<span class="ln plop">Sin plan publicado para este modelo</span>':'<span class="plop">sin plan publicado</span>';
  return box?`<span class="ln">Cuota inicial: <b class="plci">${clp(p.ci)}</b> <span class="plop">${ON[p.op]||p.op}</span></span><span class="ln">Plan ${clp(p.fee)}/mes · 70 %: <b class="pl70">${clp(Math.round(o*.7))}</b></span>`
    :`cuota inicial <b class="plci">${clp(p.ci)}</b> ${ON[p.op]||p.op} + plan ${clp(p.fee)}/mes`};
function render(){const box=$('plBox');if(!box)return;const on=planOn();box.hidden=!on;if(!on)return;const m=model();const ps=plans();const cs=caps();
  $('plInfo').textContent=`${m.name} · planes falabella.com al ${dd(PLA.t)} · mandato ${ps[0]?ps[0].mo:18} meses`;
  $('plCaps').innerHTML=cs.length>1?cs.map(c=>`<button type="button" class="chip" data-plcap="${c}" aria-pressed="${c===curCap()}">${capLab(c)}</button>`).join(''):'';
  if(!ps.length){$('plOps').innerHTML='';$('plList').innerHTML=`<p class="hint" style="font-size:15px">Este modelo no tiene planes publicados hoy en falabella.com. Los modelos con plan son: ${[...new Set((PLA.items||[]).map(r=>r[0]))].join(', ')}.</p>`;$('pl70').innerHTML='';return}
  const sel=plSel();
  $('plOps').innerHTML=OPS.filter(op=>ps.some(p=>p.op===op)).map(op=>{const mn=ps.filter(p=>p.op===op).sort((a,b)=>a.ci-b.ci)[0];return `<button type="button" class="plop-b" data-plop="${op}" data-op="${op}" aria-pressed="${sel&&sel.op===op}"><b>${ON[op]}</b><span>Cuota inicial desde ${clp(mn.ci)}</span></button>`}).join('');
  $('plList').innerHTML=ps.filter(p=>p.op===sel.op).sort((a,b)=>a.fee-b.fee).map(p=>`<button type="button" class="plc" data-plpn="${esc(p.pn)}" data-plfee="${p.fee}" aria-pressed="${p.pn===sel.pn&&p.fee===sel.fee}"><span class="pn">${esc(p.pn)}</span><span class="fee">Cargo fijo <b>${clp(p.fee)}</b> al mes · mandato ${p.mo} meses</span><small>Cuota inicial</small><span class="ci">${clp(p.ci)}</span></button>`).join('');
  const o=plOferta(),r70=Math.round(o*.7);
  $('pl70').innerHTML=`<div><span class="k">Con Seguro Connect recuperas el 70 % del precio oferta</span><span class="big">${clp(r70)}</span>
    <div class="eq">${esc(m.name)} ${capLab(curCap())} · precio oferta <b>${clp(o)}</b><br>Con plan ${ON[sel.op]}: cuota inicial <b style="color:#ff453a">${clp(sel.ci)}</b> + cargo fijo <b>${clp(sel.fee)}</b> al mes<br>${r70>=sel.ci?`Si te lo roban o se daña, recuperas <b>${clp(r70)}</b>: más de lo que pagas de cuota inicial.`:`Si te lo roban o se daña, recuperas hasta <b>${clp(r70)}</b>.`}</div></div>
    <div><h4>Beneficios del Seguro Connect con tu plan</h4><ul>
      <li>Recuperas el 70 % del precio oferta del equipo, no solo de lo que pagaste al inicio.</li>
      <li>Daño y Robo cubre robo con violencia o por la fuerza, caídas, golpes y líquidos.</li>
      <li>Daño cubre caídas, golpes y líquidos: los accidentes más comunes.</li>
      <li>Lo pagas en la misma cuota con tu tarjeta CMR y te protege desde el primer día.</li></ul></div>`}
window.renderPlans=render;
const _rs=renderSide;renderSide=function(){_rs();render();document.body.classList.toggle('plmode',planOn())};
document.addEventListener('click',e=>{const t=e.target.closest('button');if(!t)return;
  if(t.dataset.plop){S.plOp=t.dataset.plop;S.pl=null;renderSide();renderCards();renderNeed();renderTable();return}
  if(t.dataset.plpn){const p=plans().find(x=>x.pn===t.dataset.plpn&&x.fee===+t.dataset.plfee);if(p){S.pl=p;S.plOp=p.op}renderSide();renderCards();renderNeed();renderTable();return}
  if(t.dataset.plcap){const c=t.dataset.plcap;S.pl=null;if(S.autoP&&typeof applyAuto==='function'){S.capa=capLab(c);applyAuto(c)}else S.capa=capLab(c);renderSide();renderCards();renderNeed();renderTable();return}
  if(t.dataset.mi!=null||t.dataset.grp){S.pl=null}},true);
(async()=>{for(let i=0;i<60&&!DB;i++)await new Promise(r=>setTimeout(r,250));if(!DB)return;
  try{DB.doc('config/planes_apple').onSnapshot(s=>{try{if(!s.exists)return;const d=s.data();const it=typeof d.items==='string'?JSON.parse(d.items):d.items;
    if(Array.isArray(it)&&it.length>=15&&it.every(r=>Array.isArray(r)&&typeof r[0]==='string'&&r[5]>0)){window.PLA={t:d.t||'',items:it};S.pl=null;renderSide();renderCards();renderNeed();renderTable()}}catch(_){}},()=>{})}catch(_){}})();
render();
})();
</script>
<script>
(function(){var K='calc_theme',r=document.documentElement,d=document.getElementById('tDark');
function ap(t){if(t==='dark')r.setAttribute('data-theme','dark');else r.removeAttribute('data-theme');d.setAttribute('aria-pressed',t==='dark');try{localStorage.setItem(K,t==='dark'?'dark':'')}catch(e){}}
ap('dark');
d.addEventListener('click',function(){ap(r.getAttribute('data-theme')==='dark'?'':'dark')});})();
</script>
</body></html>
