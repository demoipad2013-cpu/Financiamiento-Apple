const GROUPS=[
 {id:'tel',name:'iPhone',ico:'iphone',apple:'iphone',ge:'iphone',plans:['ge','p1','p2'],brands:['Apple']},
 {id:'comp',name:'Mac',ico:'mac',apple:'mac',ge:'mac',plans:['ge','p2'],brands:['Apple']},
 {id:'tab',name:'iPad',ico:'ipad',apple:'ipad',ge:'ipad',plans:['ge','p2'],brands:['Apple']},
 {id:'wear',name:'Watch',ico:'watch',apple:'watch',ge:'watch',plans:['ge','p2'],brands:['Apple']},
 {id:'aud',name:'AirPods',ico:'airpods',apple:'airpods',ge:'airpods',plans:['ge'],brands:['Apple']}];
const PLAN_BRANDS=['Apple','Samsung','Xiaomi','Huawei','Motorola','Vivo','Honor'];
GROUPS.forEach(g=>{if(g.apple){const c=CATS.find(c=>c.id===g.apple);c.grp=g.id;c.brand='Apple';c.geKey=g.ge;c.cat=g.name}});
const slug=s=>s.toLowerCase().replace(/[^a-z0-9]+/g,'');
function partIcoGen(g,label){const l=label.toLowerCase();
 if(/pantalla/.test(l))return g==='tel'?'ipScreen':g==='comp'?'mbScreen':g==='wear'?'wScreen':g==='vg'?(/óptica/.test(l)?'vr':'padScreen'):'padScreen';
 if(/bater/.test(l))return g==='tel'?'ipBat':g==='comp'?'mbBat':g==='tab'?'padBat':g==='wear'?'wBat':'battery';
 if(/frontal/.test(l))return g==='tab'?'padCam':'ipFront';
 if(/cámara|camara/.test(l))return g==='tab'?'padCam':g==='vg'?'camera':'ipCam3';
 if(/gráfica|grafica/.test(l))return 'gpu';
 if(/teclado/.test(l))return 'mbKeys';
 if(/trackpad/.test(l))return 'trackpad';
 if(/corona/.test(l))return 'crown';
 if(/sensor/.test(l))return g==='wear'?'wSens':'sensor';
 if(/botones|teclas|gatillos/.test(l))return 'buttons';
 if(/estuche/.test(l))return 'case';
 if(/ventilador/.test(l))return 'fan';
 if(/hdmi/.test(l))return 'hdmi';
 if(/fuente/.test(l))return 'power';
 if(/lectora/.test(l))return 'disc';
 if(/ssd|almacenamiento/.test(l))return 'ssd';
 if(/joystick|controladores/.test(l))return 'stick';
 if(/usb/.test(l))return 'port';
 if(/altavoces/.test(l))return 'speaker';
 if(/carcasa/.test(l))return 'chassis';
 if(/correa/.test(l))return 'band';
 if(/placa/.test(l))return g==='tel'?'ipBoard':'mbBoard';
 return 'board'}
GROUPS.forEach(g=>g.brands.forEach(b=>{if(b==='Apple')return;const ms=((NEW_DATA[g.id]||{})[b])||[];
  CATS.push({id:g.id+'-'+slug(b),name:b,brand:b,grp:g.id,geKey:g.ge,cat:g.name,plans:g.plans,parts:[],
   models:ms.length?ms.map(([n,gama,ps])=>({name:n,costs:[],p2:true,tech:gama?('Gama '+gama.toLowerCase()+'. Valores de repuestos referenciales por analogía de gama, sin mano de obra.'):'',parts:ps.map(p=>[p[0],partIcoGen(g.id,p[0]),p[1],p[2]])}))
    :[{name:'Modelo general',costs:[],p2:true,tech:'',parts:[]}]})}));
const grp=()=>GROUPS.find(g=>g.id===S.grp);
const catFor=(gid,brand)=>CATS.find(c=>c.grp===gid&&c.brand===brand);
const planOn=()=>S.plan&&S.grp==='tel'&&PLAN_BRANDS.includes(cat().brand);
const bp=()=>planOn()?Math.round((window.plOferta?plOferta():S.price)*0.7):S.price;
