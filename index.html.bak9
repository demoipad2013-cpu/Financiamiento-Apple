const HIDE_MODELS=['iPhone 15 Pro','iPhone 15 Pro Max','iPhone 16 Pro','iPhone 16 Pro Max'];
CATS.forEach(c=>{c.models=COSTOS[c.sheet].filter(m=>!HIDE_MODELS.includes(m.n)).map(m=>({name:m.n,costs:m.c,tech:m.t,p2:!(c.id==='mac'&&/mini|imac/i.test(m.n))}))});
{const w=CATS.find(c=>c.id==='watch');if(w){const SZ={'Apple Watch SE':['40mm','44mm'],'Apple Watch S11':['42mm','46mm'],'Apple Watch S12':['42mm','46mm']};const out=[];
  w.models.forEach(m=>{const z=SZ[m.name];if(z)z.forEach(x=>out.push({...m,name:m.name+' '+x}));else out.push(m)});w.models=out}}
{const SZ2={ipad:{'iPad Air':['11"','13"'],'iPad Pro':['11"','13"']},mac:{'MacBook Air':['13"','15"'],'MacBook Pro':['14"','16"']}};for(const [id,SZ] of Object.entries(SZ2)){const c=CATS.find(c=>c.id===id);if(!c)continue;const out=[];c.models.forEach(m=>{const z=SZ[m.name];if(z)z.forEach(x=>out.push({...m,name:m.name+' '+x}));else out.push(m)});c.models=out}}
{const TECH={"iPhone 18 Pro": "Unibody de aluminio. Chip A20 Pro. Sistema Pro de tres cámaras Fusion de 48 MP con cámara principal de apertura variable y zoom óptico de hasta x8. Cámara frontal Center Stage de 18 MP. Parte delantera con Ceramic Shield 2.", "iPhone 18 Pro Max": "Unibody de aluminio. Pantalla Super Retina XDR de 6,9\" con ProMotion. Chip A20 Pro. Sistema Pro de tres cámaras Fusion de 48 MP con cámara principal de apertura variable y zoom óptico de hasta x8. Cámara frontal Center Stage de 18 MP. Hasta 43 horas de reproducción de video.", "iPhone 17 Pro": "Unibody de aluminio. Chip A19 Pro. Sistema Pro de tres cámaras Fusion de 48 MP con zoom óptico de hasta x8. Cámara frontal Center Stage de 18 MP. Parte delantera con Ceramic Shield 2.", "iPhone 17 Pro Max": "Unibody de aluminio. Pantalla Super Retina XDR de 6,9\" con ProMotion. Chip A19 Pro. Sistema Pro de tres cámaras Fusion de 48 MP con zoom óptico de hasta x8. Cámara frontal Center Stage de 18 MP. Hasta 37 horas de reproducción de video."};CATS.find(c=>c.id==='iphone').models.forEach(m=>{if(TECH[m.name])m.tech=TECH[m.name]})}
