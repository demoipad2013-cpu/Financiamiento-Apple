const PSTOP=new Set(['celular','ceular','notebook','tablet','smartwatch','watch','apple','galaxy','samsung','xiaomi','motorola','moto','huawei','honor','zte','lenovo','asus','hp','acer','garmin','sony','bose','anker','soundcore','nintendo','de','con','y','the','gamer','gaming','kit','reloj','inteligente','audifonos','audifono','auriculares','parlante','portatil','bluetooth','inalambrico','inalambricos','consola']);
const ptok=s=>String(s).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/vivo\s*active/g,'vivoactive').replace(/smart\s*band/g,'smartband').replace(/idea\s*tab/g,'ideatab').replace(/wi[\s-]*fi/g,'wifi').replace(/\bmkw\b/g,'mario kart world').replace(/series/g,' s ').replace(/generacion|\bgen\b/g,' g ').replace(/([a-z])(\d)/g,'$1 $2').replace(/(\d)([a-z])/g,'$1 $2').replace(/[^a-z0-9]+/g,' ').split(' ').filter(w=>w&&!PSTOP.has(w));
let PTOK=new Map();const itemTok=r=>{let t=PTOK.get(r);if(!t){const a=ptok(r[2]);t={set:new Set(a),arr:a};PTOK.set(r,t)}return t};
const PDECOY={ipad:['iPad Air 13 M3','iPad Air 11 M3','iPad Air 13 M2','iPad Air 11 M2'],watch:['Watch SE 2a Gen','Watch SE 2 Gen','Watch Series 9','Watch Series 10','Watch S10','Watch Ultra 2']};
const pval=x=>S.ptype==='cmr'&&x.c?x.c:x.v;
const CAP_ORD=['64GB','128GB','256GB','512GB','1TB','2TB',''];const capLab=c=>c?c.replace(/(\d+)(GB|TB)/,'$1 $2'):'';
const runLen=(A,K)=>{let b=0;for(let p=0;p<A.length;p++)for(let i=0;i<K.length;i++){let t=0;while(p+t<A.length&&i+t<K.length&&A[p+t]===K[i+t])t++;if(t>b)b=t}return b};
const better=(a,b)=>{for(let i=0;i<a.length;i++){if(a[i]!==b[i])return a[i]>b[i]}return false};
function priceOpts(){const m=model();if(!m||!window.APR)return [];const o=APR.items.filter(r=>r[0]===m.name&&r[2]>0).map(r=>({cap:r[1],v:r[2],c:r[3]>0&&r[3]<r[2]?r[3]:0,no:r[4]||0,n:m.name+(r[1]?' '+r[1]:'')}));const ord=['64GB','128GB','256GB','512GB','1TB','2TB'];return o.sort((a,b)=>{const x=ord.indexOf(a.cap),y=ord.indexOf(b.cap);return (x<0||y<0)?a.v-b.v:x-y})}
function applyAuto(cap){const o=priceOpts();if(!S.autoP||!o.length)return false;const pick=(cap!=null&&o.find(x=>x.cap===cap))||o.find(x=>capLab(x.cap)===S.capa)||o[0];S.capa=capLab(pick.cap);const pv=pval(pick);S.price=pv;S.example=false;$('inPrice').value=pv.toLocaleString('es-CL');const eg=$('eg');if(eg)eg.hidden=true;return true}
function renderAP(){const box=$('apBox');const o=priceOpts();$('inPrice').classList.remove('cmr');box.hidden=!o.length;if(!o.length)return;
  $('inAP').checked=!!S.autoP;const cur=o.find(x=>capLab(x.cap)===S.capa)||o[0];const d=String((window.APR&&APR.t)||'').slice(0,10).split('-').reverse().join('/');
  const hasC=o.some(x=>x.c);$('inPrice').classList.toggle('cmr',!!(S.autoP&&S.ptype==='cmr'&&cur.c));if(!hasC&&S.ptype==='cmr')S.ptype='int';$('apType').hidden=false;$('apType').innerHTML=`<button type="button" data-ptype="int" aria-pressed="${S.ptype!=='cmr'}">Precio oferta</button><button type="button" data-ptype="cmr" aria-pressed="${S.ptype==='cmr'}"${cur.c?'':' disabled title="Sin precio CMR para este modelo"'}>Precio CMR</button>`;
  $('apInfo').textContent=S.autoP?`${cur.n} · ${S.ptype==='cmr'&&cur.c?'CMR ':''}${clp(pval(cur))} · falabella.com al ${d}`:`Desde ${clp(o[0].v)} en falabella.com · actívalo para completarlo solo`;
  const capsOn=o.length>1||!!o[0].cap;$('apCaps').hidden=!capsOn;
  $('apCaps').innerHTML=capsOn?o.map(x=>`<button type="button" class="chip${S.ptype==='cmr'&&x.c?' cmrc':''}" data-cap="${x.cap}" aria-pressed="${!!S.autoP&&capLab(x.cap)===S.capa}">${x.cap?capLab(x.cap):'Precio'}<small>${clp(pval(x))}</small></button>`).join(''):''}
const norName=()=>planOn()?'Equipo con plan (70 %)':(cat().brand==='Apple'?'Garantía Apple':'Garantía del fabricante');
{const ip=CATS.find(c=>c.id==='iphone').models;const add=(after,name)=>{if(ip.some(m=>m.name===name))return;const i=ip.findIndex(m=>m.name===after);ip.splice(i+1,0,{name,costs:[],tech:'',p2:true})};add('iPhone 17','iPhone 17e');add('iPhone 16','iPhone 16e')}
const PLAN={
 ge:{name:'Garantía extendida',what:'Extiende la cobertura ante fallas de fabricación después de la garantía del fabricante.',ico:'total'},
 p1:{name:'Seguro Connect Daño + Robo',what:'Cubre daño accidental (caídas, golpes, líquidos) y robo del equipo.',ico:'robo'},
 p2:{name:'Seguro Daño',what:'Cubre daño accidental: caídas, golpes y líquidos.',ico:'drop'},
 nor:{name:'Cuota normal',what:'Solo la garantía del fabricante (12 meses ante fallas de fabricación).',ico:'board'}
};

/* ================== ESTADO ================== */
const LS='protege_apple_v1';
const def=()=>({cfgV:3,ge:[],gePct:{m12:10,m24:17},p1:P1_DEF.map(r=>({a:r[0],b:r[1],m12:r[2],m24:r[3]})),p2:P2_DEF.map(r=>({a:r[0],b:r[1],m12:r[2],m24:r[3]})),presu:{...PRESU_DEF},fx:JSON.parse(JSON.stringify(FX_DEF)),ite:{...ITE_DEF},updated:''});
let CFG=def();
try{const s=JSON.parse(localStorage.getItem(LS+'_cfg')||'null');if(s&&s.p1){CFG={...def(),...s};if(!CFG.gePct||s.cfgV!==3){CFG.gePct=def().gePct;CFG.cfgV=3}}}catch(e){}
let PRICES={};try{PRICES=JSON.parse(localStorage.getItem(LS+'_prices')||'{}')}catch(e){}
const EXAMPLE={iphone:1299990,mac:1299990,ipad:699990,watch:449990,airpods:249990};
const S={grp:'tel',autoP:true,ptype:'int',plan:false,ge2:false,evt:false,pie:0,pie2:false,cat:'iphone',mi:0,price:0,example:true,n:12,cov:12,si:false,part:0,geMan:{}};

/* ================== CÁLCULO DE CUOTAS (Price Ticket Apple · tabla falabella.com) ================== */
const TERMS=[2,3,6,10,12,24];
function implied(c,n,P){let lo=1e-7,hi=.3;for(let i=0;i<80;i++){const m=(lo+hi)/2;const q=P*m/(1-Math.pow(1+m,-n));if(q<c)lo=m;else hi=m}return (lo+hi)/2}
function rateFor(n){const f=CFG.fx;const pts=TERMS.map(t=>[t,implied(f.c[t],t,f.price)]);
  if(n<=pts[0][0])return pts[0][1];
  for(let i=1;i<pts.length;i++){if(n<=pts[i][0]){const [a,ra]=pts[i-1],[b,rb]=pts[i];return ra+(rb-ra)*(n-a)/(b-a)}}
  const [a,ra]=pts[pts.length-2],[b,rb]=pts[pts.length-1];return Math.max(0,rb+(rb-ra)*(n-b)/(b-a))}
function rawQ(P,n){const f=CFG.fx;if(f.c[n])return Math.round(P*f.c[n]/f.price);const r=rateFor(n);return Math.round(P*r/(1-Math.pow(1+r,-n)))}
function iteMonth(){const r=CFG.ite;const q=rawQ(r.price,r.n);return Math.max(0,(r.ctc-q*r.n)/r.price/Math.min(r.n,12))}
function cuota(P,n,si){if(!P)return null;if(n<=1)return {q:P,ctc:P,n:1};
  if(si)return {q:Math.round(P/n),ctc:P,n,si:true};
  const q=rawQ(P,n);return {q,ctc:q*n+Math.round(P*iteMonth()*Math.min(n,12)),n}}
const tramo=(t,P)=>{const r=(t||[]).find(r=>P>=r.a&&P<=r.b);return r?{m12:r.m12||0,m24:r.m24||0}:null};

/* ================== UTILIDADES ================== */
const $=id=>document.getElementById(id);
const clp=n=>(n==null||isNaN(n))?'—':'$'+Math.round(n).toLocaleString('es-CL');
const dg=s=>{const d=String(s==null?'':s).replace(/[^\d]/g,'');return d?parseInt(d,10):0};
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
let tT;function toast(m){clearTimeout(tT);let t=document.querySelector('.toast');if(!t){t=document.createElement('div');t.className='toast';t.setAttribute('role','status');document.body.appendChild(t)}t.textContent=m;tT=setTimeout(()=>t.remove(),2600)}
const cat=()=>CATS.find(c=>c.id===S.cat), model=()=>cat().models[S.mi];
const mkey=()=>S.cat+'|'+model().name;

/* ================== RENDER ================== */
function renderCats(){
  $('cats').innerHTML=GROUPS.map(g=>`<button class="cat" type="button" data-grp="${g.id}" aria-pressed="${g.id===S.grp}">${svg(g.ico,48)}<span>${g.name}</span></button>`).join('');
  $('brands').innerHTML=grp().brands.map(b=>`<button class="bchip" type="button" data-brand="${esc(b)}" aria-pressed="${b===cat().brand}">${esc(b)}</button>`).join('');
  $('models').innerHTML=cat().models.map((m,i)=>`<button class="mchip" type="button" data-mi="${i}" aria-pressed="${i===S.mi}">${esc(m.name)}</button>`).join('');
}
function loadPrice(){S.price=0;S.pie=0;S.example=false;$('inPrice').value='';const p=$('inPie');if(p)p.value='';if(S.autoP)applyAuto(null);pieHint()}
function renderSide(){
  const c=cat(),m=model();$('mTitle').textContent=m.name;
  $('outN').textContent=S.pie2?'Pie + 2':(S.n===1?'Contado':S.n);$('inN').value=S.n;
  $('qn').innerHTML=[1,3,6,12,18,24,36,48].map(n=>`<button class="chip" type="button" data-n="${n}" aria-pressed="${!S.pie2&&n===S.n}">${n===1?'Contado':n}</button>`).join('')+`<button class="chip p2" type="button" data-n="p2" aria-pressed="${S.pie2}">Pie + 2 cuotas</button>`;
  renderAP();$('inSI').closest('label').hidden=S.pie2;$('ge2Row').hidden=S.grp!=='tel';$('inGe2').checked=!!S.ge2;$('planRow').hidden=!(S.grp==='tel'&&PLAN_BRANDS.includes(c.brand));$('inPlan').checked=!!S.plan;$('planCI').innerHTML=planOn()&&S.price?ciBox():'';document.querySelector('label[for=inPrice]').textContent=planOn()?'Precio oferta del equipo':'Precio';$('evtRow').hidden=!EVT_CATS.includes(S.cat);$('inEvt').checked=S.evt;$('evtLab').textContent='−'+evtPct()+' %';
  document.querySelectorAll('.segc button[data-m]').forEach(b=>b.setAttribute('aria-pressed',String(+b.dataset.m===S.cov)));
  $('inSI').checked=S.si;$('eg').hidden=!S.example;
  const av=avail();
  $('mNote').innerHTML=`${esc(c.cat)} · Protecciones disponibles: ${av.map(k=>PLAN[k].name).join(', ')}.`;
}
function avail(){const c=cat(),m=model();return c.plans.filter(k=>(k!=='p2'||m.p2)&&!(k==='ge'&&planOn()))}
function protVal(k){const P=bp();if(!P)return null;
  if(k==='ge')return geVal(S.cov);
  return segVal(k,S.cov,P)}
/* Tarifario CONNECT (Excel del usuario): prima en UF por tramo [desde, hasta, UF 12 m, UF 24 m]. Folleto con UF de referencia 25/09/2024. */
const UF_P1=[[50001, 70000, 0.7968, 1.1608], [70001, 100000, 1.1249, 1.628], [100001, 150000, 1.575, 2.2953], [150001, 200000, 1.978, 2.8558], [200001, 225000, 2.2806, 3.311], [225001, 250000, 2.5428, 3.6916], [250001, 275000, 2.8049, 4.0722], [275001, 300000, 3.0671, 4.4528], [300001, 325000, 3.3867, 4.9242], [325001, 350000, 3.6534, 5.3119], [350001, 375000, 3.9201, 5.6996], [375001, 400000, 4.1868, 6.0874], [400001, 450000, 4.2948, 6.2251], [450001, 500000, 4.7885, 6.9407], [500001, 550000, 5.3322, 7.741], [550001, 600000, 5.8306, 8.4645], [600001, 650000, 6.0684, 8.8032], [650001, 700000, 6.5463, 9.4964], [700001, 800000, 7.3966, 10.7298], [800001, 900000, 8.3528, 12.1177], [900001, 1100000, 9.609, 13.9328], [1100001, 1300000, 12.0371, 17.456], [1300001, 1500000, 13.7714, 19.965], [1500001, 1750000, 16.04, 23.2481], [1750001, 2000000, 17.3993, 25.2232], [2000001, 2250000, 20.4461, 29.654], [2250001, 2500000, 22.7148, 32.9372]];
const UF_P2=[[0, 10000, 0.0844, 0.1146], [10001, 20000, 0.1593, 0.2321], [20001, 35000, 0.2625, 0.3868], [35001, 40000, 0.3807, 0.5554], [40001, 50000, 0.4648, 0.678], [50001, 70000, 0.6656, 0.966], [70001, 100000, 0.9375, 1.361], [100001, 150000, 1.2562, 1.8149], [150001, 200000, 1.7062, 2.4821], [200001, 225000, 1.9786, 2.8595], [225001, 250000, 2.206, 3.1882], [250001, 275000, 2.4334, 3.5169], [275001, 300000, 2.6608, 3.8456], [300001, 325000, 2.888, 4.1912], [325001, 350000, 3.1154, 4.5212], [350001, 375000, 3.3428, 4.8512], [375001, 400000, 3.5702, 5.1813], [400001, 450000, 3.462, 5.0147], [450001, 500000, 3.8599, 5.5911], [500001, 550000, 4.2587, 6.1628], [550001, 600000, 4.6568, 6.7387], [600001, 650000, 4.9311, 7.1588], [650001, 700000, 5.3194, 7.7225], [700001, 800000, 5.8685, 8.5143], [800001, 900000, 7.2091, 10.4362], [900001, 1100000, 7.7434, 11.2103], [1100001, 1300000, 9.3372, 13.5324], [1300001, 1500000, 10.4902, 15.2139], [1500001, 1750000, 12.2808, 17.803], [1750001, 2000000, 13.9307, 20.2052], [2000001, 2250000, 15.6931, 22.7677], [2250001, 2500000, 17.2681, 25.0364], [2500001, 2750000, 19.0483, 27.6199], [2750001, 3000000, 20.8285, 30.2022]];
const UF_DEF=41274.20; /* UF del 05/11/2026 según SII */
function segVal(k,cv,P){const t=tramo(CFG[k],P);if(!t)return {v:0,src:'out'};
  if((CFG.segMode||'uf')==='uf'){const r=(k==='p1'?UF_P1:UF_P2).find(r=>P>=r[0]&&P<=r[1]);const uf=Number(CFG.uf)||UF_DEF;if(r){const pu=cv===12?r[2]:r[3];return {v:Math.round(pu*uf/100)*100,src:'uf',pu,uf}}}
  return {v:t['m'+cv],src:'tab'}}
/* Garantía extendida publicada en falabella.com (precio normal, sin descuento), leída desde la ficha de cada producto el 06/11/2026. Se usa la referencia de precio más cercana (±20 %); en Apple Watch, el tramo de precio que indica Falabella. */
const GE_REF={
 iphone:{m12:[['iPhone 17e',739990,84990],['iPhone 16',999990,84990],['iPhone 17',1049990,109990],['iPhone Air',1299990,109990],['iPhone 17 Pro',1349990,129990],['iPhone 17 Pro Max',1499990,129990],['iPhone Duo',2499990,199990]],
         m24:[['iPhone 17e',669990,114990],['iPhone 16',999990,124990],['iPhone 17',1049990,139990],['iPhone Air',1299990,139990],['iPhone 18 Pro',1539990,249990],['iPhone 18 Pro Max',1699990,249990]]},
 ipad:{m12:[['iPad A16 128 GB',539990,93990],['iPad A16 256 GB',639990,96990],['iPad Air 11" M4',879990,99990],['iPad Air 13" M3',939990,99990]],
       m24:[['iPad A16 128 GB',539990,149990],['iPad A16 256 GB',639990,161990],['iPad Air 11" M4',879990,169990],['iPad Air 13" M3',939990,169990]]},
 mac:{m12:[['MacBook Neo',789990,144990],['Mac mini M4',1119990,174990],['MacBook Air 13" M5 512 GB',1499990,174990],['iMac 24" M4',1629990,216990],['MacBook Air 13" M5 1 TB',1839990,216990],['MacBook Air 15" M5',2119990,262490],['MacBook Pro 14" M5',2249990,359990],['MacBook Pro 16" M5 Pro',3519990,359990]],
      m24:[['MacBook Neo',789990,209990],['Mac mini M4',1119990,291990],['MacBook Air 13" M5 512 GB',1499990,291990],['iMac 24" M4',1629990,360990],['MacBook Air 13" M5 1 TB',1839990,360990],['MacBook Air 15" M5',2119990,369990],['MacBook Pro 14" M5',2249990,439990],['MacBook Pro 16" M5 Pro',3519990,439990]]},
 watch:{m12:[],m24:[]},
 airpods:{m12:[['AirPods 5',149990,28990],['AirPods 5 con estuche inalámbrico',169990,34990],['AirPods Pro',229990,49990],['AirPods Max 2',589990,92990]],
          m24:[['AirPods 5',149990,39990],['AirPods 5 con estuche inalámbrico',169990,54990],['AirPods Pro',229990,76990],['AirPods Max 2',589990,134990]]}};
/* Apple Watch: tramos "GAR WEARABLES" de falabella.com [desde, hasta, 1 año, 2 años] */
const GE_WEAR=[[200001,300000,39990,52990],[400001,500000,59990,86990],[500001,600000,69990,102990],[800001,900000,99990,139990],[900001,1000000,104990,149990]];
function geRef(cv,P){const K=cat().geKey||S.cat;if(K==='watch'){const t=GE_WEAR.find(r=>P>=r[0]&&P<=r[1]);if(t)return {d:0,name:'tramo Falabella '+Math.round(t[0]/1000)+'–'+Math.round(t[1]/1000)+' mil',p:P,v:cv===12?t[2]:t[3]};}
 const l=((GE_REF[K]||{})['m'+cv])||[];let b=null;l.forEach(r=>{const d=Math.abs(r[1]-P)/P;if(d<=0.2&&(!b||d<b.d))b={d,name:r[0],p:r[1],v:r[2]}});return b}
const EVT_CATS=['ipad','mac'];const evtPct=()=>Number(CFG.evtPct)||30;const evtOn=()=>S.evt&&EVT_CATS.includes(S.cat);
const ge2On=()=>S.ge2&&S.grp==='tel'&&!planOn();
function geVal(cv){const b=geBase(cv);if(ge2On()&&cv===24&&b.v){const one=geBase(12);if(one.v&&one.v<b.v)return {...b,v:one.v,orig:b.v,ge2:true}}if(evtOn()&&b.v&&cv===12){const d=evtPct();return {...b,v:Math.round(b.v*(1-d/100)),orig:b.v,evt:d}}return b}
const TEL_GE=[[209999,24990],[349999,34990],[419999,42990],[519999,54990],[599999,59990],[699999,69990],[999999,84990],[1299999,109990],[1499999,129990],[1999999,164990],[1e12,199990]];
const GE_MODEL={'Apple Watch SE 40mm':{m12:39990,m24:52990},'Apple Watch SE 44mm':{m12:49990,m24:78990},'Apple Watch S11 42mm':{m12:59990,m24:86990},'Apple Watch S11 46mm':{m12:69990,m24:102990},'Apple Watch S12 42mm':{m12:59990,m24:86990},'Apple Watch S12 46mm':{m12:69990,m24:102990},'Apple Watch Ultra 4':{m12:104990,m24:149990},'AirPods 5':{m12:28990,m24:39990},'AirPods 5 carga inalámbrica':{m12:34990,m24:54990},'AirPods Pro 3':{m12:49990,m24:76990},'iPhone 18 Pro':{m12:164990},'iPhone 18 Pro Max':{m12:164990},'Switch 2 + Mario Kart World':{m12:59990},'Switch 2 Neon Blue / Neon Red':{m12:59990},'Switch OLED':{m12:44990}};
/* Garantía extendida Apple Watch y AirPods (Excel Garantia_Apple_watch_y_Airpods, falabella.com 11/11/2026) */
{const ap=CATS.find(c=>c.id==='airpods');if(ap){const i=ap.models.findIndex(m=>m.name==='AirPods 5');if(i>=0&&!ap.models.some(m=>m.name==='AirPods 5 carga inalámbrica'))ap.models.splice(i+1,0,{...ap.models[i],name:'AirPods 5 carga inalámbrica'})}}
function geBase(cv){const P=bp();if(!P)return {v:0,src:'none'};const man=S.geMan[mkey()+'|'+cv];if(man)return {v:man,src:'man'};
  const gm=(cat().brand==='Apple'||S.grp==='vg')&&model()&&GE_MODEL[model().name];if(gm&&gm['m'+cv])return {v:gm['m'+cv],src:'fal',ref:{d:0,name:model().name,p:P,v:gm['m'+cv]}};
  const t=tramo(CFG.ge,P);if(t&&t['m'+cv])return {v:t['m'+cv],src:'tab'};
  if(S.grp==='tel'&&cv===12){const tt=TEL_GE.find(r=>P<=r[0]);return {v:tt[1],src:'fal',ref:{d:0,name:'tramo prepago Falabella',p:P,v:tt[1]}}}
  const rf=geRef(cv,P);if(rf)return {v:rf.v,src:'fal',ref:rf};
  if(cv===24){const r1=geRef(12,P);if(r1)return {v:Math.round(r1.v*1.47/10000)*10000-10,src:'est',ref:r1}}
  const pc=Number((CFG.gePct||{})['m'+cv])||0;if(pc)return {v:Math.max(9990,Math.round(P*pc/100/10000)*10000-10),src:'pct',pc};return {v:0,src:'none'}}
const pieOk=()=>S.pie>0&&S.pie<S.price;
/* Pie + 2 cuotas sin interés: 3 pagos iguales de un tercio; el total queda en precio contado. */
function q2(A){const pie=Math.round(A/3);return {q:Math.round((A-pie)/2),ctc:A,n:2,si:true,pie}}
const qf=(A,n,si)=>S.pie2?q2(A):cuota(A,n,si);
function calc(){const P=(planOn()&&window.plSel&&plSel()?plSel().ci:bp())+(typeof window.accTotal==="function"?accTotal():0),n=S.n,si=S.si;const base=qf(P,n,si);const out={nor:base};
  ['ge','p1','p2'].forEach(k=>{const pv=protVal(k);if(!pv||!pv.v){out[k]={pv};return}const c=qf(P+pv.v,n,si);out[k]={...c,pv,dq:c.q-base.q,dt:c.ctc-base.ctc}});return out}
function qLine(c){return c.n===1?`${clp(c.q)}<small>al contado</small>`:`${clp(c.q)}<small>${c.n} cuotas${c.si?' sin interés':''} mensuales</small>`}
function diffTxt(r){if(r.n===1)return `+${clp(r.dt)} al contado`;const d=Math.max(0,r.dq);return `+${clp(d)} al mes · ${clp(Math.ceil(d/30))} al día`}
const YR=c=>c===12?'1 año':'2 años';
function evtTag(c){if(c.k==='ge'&&ge2On()&&S.cov===24){const pv=protVal('ge');if(pv&&pv.ge2)return `<span class="evt">2 años al precio de 1 · normal ${clp(pv.orig)}</span>`}if(c.k!=='ge'||!evtOn()||S.cov!==12)return '';const pv=protVal('ge');return pv&&pv.evt?`<span class="evt">Evento −${pv.evt} % · normal ${clp(pv.orig)}</span>`:''}
function renderCards(){
  const P=S.price,R=calc(),av=avail(),cov=S.cov,m=model(),n=S.n;
  $('rSub').innerHTML=P?`${esc(mname())} · ${clp(P)}${typeof window.accLabel==="function"?accLabel():''}${planOn()?` · plan: ${ciHtml()}`:''}${S.pie2?` · pie ${clp(R.nor?R.nor.pie:0)} + 2 cuotas sin interés (precio contado)`:` · ${n===1?'contado':n+' cuotas'+(S.si?' sin interés':'')}`} · protección de ${YR(cov)} (${cov} meses)`:'Escribe el precio del producto';
  if($('planCI'))$('planCI').innerHTML=planOn()&&S.price?ciBox():'';
  const nq=S.pie2?'Pie y 2 cuotas de':(n===1?'Contado':`${n} cuotas de`);
  const cols=[
    {k:'ge',name:'Garantía extendida '+YR(cov),sub:`${cov} meses adicionales`,ico:'total'},
    {k:'nor',name:norName(),sub:planOn()?'70 % del precio oferta':'Fabricante · 12 meses',ico:'board'},
    {k:'p1',name:'Seguro Daño y Robo',sub:`Connect · ${cov} meses`,ico:'robo'},
    {k:'p2',name:'Seguro Daño',sub:`Connect · ${cov} meses`,ico:'drop'}].filter(c=>!(planOn()&&(c.k==='ge'||c.k==='nor')));
  $('cmp').style.gridTemplateColumns=`minmax(150px,.75fr) repeat(${cols.length},minmax(175px,1fr))`;$('cmp').style.minWidth=cols.length<4?'720px':'';
  const ok=k=>k==='nor'||av.includes(k);
  const why=k=>k==='p1'?'Solo para telefonía':(cat().id==='mac'?'No aplica a Mac de escritorio':'No aplica a esta categoría');
  const has=k=>k==='nor'?!!R.nor:(ok(k)&&R[k]&&R[k].q!=null);
  const geInputs=()=>`<div class="gein">${[12,24].map(x=>`<label for="ge${x}">Garantía ${YR(x)}<input id="ge${x}" data-ge="${x}" inputmode="numeric" placeholder="$0" value="${S.geMan[mkey()+'|'+x]?S.geMan[mkey()+'|'+x].toLocaleString('es-CL'):''}"></label>`).join('')}</div>`;
  const rows=[
    ['hd','',c=>`${c.k==='ge'?'<span class="rec">Recomendado</span>':''}<div class="k">${svg(c.ico)}${c.name}</div><small>${c.sub}</small>`],
    ['','<b>Valor de la protección</b>',c=>(c=>{if(c.k==='nor')return '';if(!ok(c.k))return `<span class="na">${why(c.k)}</span>`;
      const pv=protVal(c.k);if(c.k==='ge'&&pv&&pv.src==='pct')return `<span class="val">${clp(pv.v)}</span><span class="sm">Estimado: ${String(pv.pc).replace('.',',')} % del precio del producto</span>`;if(c.k==='ge'&&pv&&pv.src==='est')return `<span class="val">${clp(pv.v)}</span><span class="sm">Estimado desde 1 año en falabella.com (×1,47)</span>`;if(c.k==='ge'&&pv&&pv.src==='fal')return `<span class="val">${clp(pv.v)}</span><span class="sm">falabella.com · ref. ${esc(pv.ref.name)} ${clp(pv.ref.p)}</span>`;if(c.k==='ge'&&pv&&pv.src!=='tab')return (pv.v?`<span class="val">${clp(pv.v)}</span>`:'')+geInputs();
      if(!pv||!pv.v)return `<span class="na">Precio fuera de los tramos</span>`;return `<span class="val">${clp(pv.v)}</span>`+(pv.src==='uf'?`<span class="sm">${String(pv.pu).replace('.',',')} UF × ${clp(pv.uf)}</span>`:`<span class="sm">Folleto Connect</span>`)})(c)+evtTag(c)],
    ['','<b>'+nq+'</b>',c=>has(c.k)?`<span class="big">${clp(R[c.k].q)}</span>`:''],
    ['',S.pie2?'Pie y total':'Total (CTC)',c=>has(c.k)?(S.pie2?`<span class="sm num">Pie ${clp(R[c.k].pie)} · total ${clp(R[c.k].ctc)}</span>`:`<span class="sm num">${clp(R[c.k].ctc)}</span>`):''],
    ['rowd','<b>Diferencia por cuota</b><span class="sm">vs '+(planOn()?'equipo sin seguro':(cat().brand==='Apple'?'garantía Apple':'garantía de fábrica'))+'</span>',c=>c.k==='nor'?'':has(c.k)?`<span class="dv">+${clp(Math.max(0,n===1?R[c.k].dt:R[c.k].dq))}</span><span class="sm">${S.pie2?'por cuota':n===1?'al contado':'al mes'}</span>`:''],
    ['last','Qué cubre',c=>`${({ge:'<span class="rec100">Recupera el 100 % de la inversión</span>',p1:'<span class="rec70">Recupera el 70 % de la inversión</span>',p2:'<span class="rec70">Recupera el 70 % de la inversión</span>'})[c.k]||''}<span class="what">${({nor:'Fallas de fabricación durante el primer año.',ge:'Fallas mecánicas, eléctricas o electrónicas por '+YR(cov)+' más, desde que termina la '+(cat().brand==='Apple'?'garantía Apple':'garantía del fabricante')+'. Incluye daño por variación de voltaje.',p1:'Daño accidental (caídas, golpes, líquidos) y robo del equipo.',p2:'Daño accidental: caídas, golpes y líquidos.'})[c.k]}</span>`]
  ];
  if(!P){renderMCards();$('cmp').innerHTML=`<div style="grid-column:1/-1;padding:28px 22px;border:0"><b>Escribe el precio del producto</b><span class="sm">Aquí aparecen las cuotas con garantía extendida y Seguro Connect comparadas con la garantía del fabricante.</span></div>`;return}
  renderMCards();
  $('cmp').innerHTML=rows.map(([cls,lab,fn])=>`<div class="rl ${cls}">${lab}</div>`+cols.map(c=>`<div class="c-${c.k} ${cls}">${fn(c)}</div>`).join('')).join('');
}
/* Ícono de cada repuesto según categoría y modelo (dibujos propios basados en el diseño de cada equipo). */
function partIco(c,m,i,def){const n=m.name;
 if(c.id==='iphone'){if(n==='iPhone Duo')return ['duoScreen','duoBack','duoFront','duoBattery','duoCamera'][i]||def;
  const k=/Pro/.test(n)?'3':/Air/.test(n)?'1':'2';return ['ipScreen','ipBack'+k,'ipCombo','ipBat','ipCam'+k][i]||def}
 if(c.id==='mac'){if(/iMac/.test(n))return ['imScreen','mbBat','imCase','mbBoard','mbKeys'][i]||def;
  if(/mini/i.test(n))return ['mbScreen','mbBat','miniCase','miniBoard','mbKeys'][i]||def;
  return ['mbScreen','mbBat','mbCase','mbBoard','mbKeys'][i]||def}
 if(c.id==='ipad')return ['padScreen','padBat','padCase','padCam','padPort'][i]||def;
 if(c.id==='watch')return ['wScreen','wBat','wBack','wSens'][i]||def;
 return def}
function renderNeed(){
  const c=cat(),m=model(),P=S.price,R=calc(),presu=CFG.presu[c.id]||0,av=avail();
  const DUO=m.name==='iPhone Duo';const NEW=(c.id==='iphone'&&IP_PARTS[m.name])||(m.parts&&m.parts.length?m.parts:(c.grp&&c.brand!=='Apple'?[]:null));const parts=NEW?NEW.map((r,i)=>({label:r[0],ico:r[1],cov:'',cost:r[2],max:r[3]||0,note:r[4]||'',i})):c.parts.map((p,i)=>({label:DUO&&i===0?'Pantalla extendida':DUO&&i===2?'Pantalla frontal':p[0],ico:partIco(c,m,i,p[1]),cov:p[2],cost:m.costs[i]||0,i})).filter(p=>p.cost>0&&!/^(otros daños|reemplazo total)/i.test(p.label)&&!(c.id==='iphone'&&!DUO&&p.label==='Pantalla + cristal trasero'));
  if(!parts.length){renderPresu();$('nSub').textContent='';$('need').innerHTML=`<div class="need"><p class="hint" style="font-size:15px">Aún no hay repuestos cargados para ${esc(c.brand==='Apple'?m.name:c.brand+' '+m.name)}. Envíame los valores y los agrego.</p></div>`;return}
  if(!parts.find(p=>p.i===S.part))S.part=parts.reduce((a,b)=>(b.cost>a.cost&&!b.robo)?b:a,parts[0]).i;
  const sel=parts.find(p=>p.i===S.part);
  $('nSub').textContent='Valor referencial del repuesto';renderPresu();
  const covTags=p=>{const t=[];if(p.cov.includes('g'))t.push('<i class="g">Garantía ext.</i>');if(p.cov.includes('d')&&(av.includes('p2')||av.includes('p1')))t.push('<i class="d">Seguro daño</i>');if(p.cov.includes('r'))t.push('<i class="r">Daño y Robo</i>');return t.join('')};
  const opts=[];
  if(sel.cov.includes('g')&&R.ge&&R.ge.q!=null)opts.push(['ge',R.ge]);
  if(sel.cov.includes('d')){if(av.includes('p2')&&R.p2&&R.p2.q!=null)opts.push(['p2',R.p2]);else if(av.includes('p1')&&R.p1&&R.p1.q!=null)opts.push(['p1',R.p1])}
  if(sel.cov.includes('r')&&R.p1&&R.p1.q!=null)opts.push(['p1',R.p1]);
  opts.sort((a,b)=>a[1].dt-b[1].dt);const best=opts[0];
  const tot=p=>p.cost;
  const repair=tot(sel),n=S.n;
  const pname={ge:'garantía extendida '+YR(S.cov),p1:'Seguro Daño y Robo',p2:'Seguro Daño'};
  const siBox=best?`<div class="vbox si"><span class="vl">Con ${pname[best[0]]}</span><span class="vv">${n===1?'+'+clp(best[1].dt):'+'+clp(Math.max(0,best[1].dq))+' al mes'}</span><span class="vd">${n===1?'Se paga una vez junto al producto.':`En ${n} cuotas: ${clp(best[1].dt)} en total, unos ${clp(Math.ceil(Math.max(0,best[1].dq)/30))} al día.`} Cobertura de ${YR(S.cov)} (${S.cov} meses).</span></div>`
    :`<div class="vbox si"><span class="vl">Con protección</span><span class="vv" style="font-size:20px">Completa el valor de la protección</span><span class="vd">Escribe el valor de la garantía extendida en el sector de cuotas.</span></div>`;
  $('need').innerHTML=`<div class="need">
   <div class="parts">${parts.map(p=>`<button class="part${p.robo?' robo':''}" type="button" data-part="${p.i}" >${svg(p.ico)}<span class="pn">${esc(p.label)}</span>
     <span class="tl">${p.robo?'Equipo nuevo':'Repuesto'}</span><span class="pc${p.max?' rg':''}">${p.max?clp(p.cost)+' – '+clp(p.max):clp(tot(p))}</span>${p.note?`<span class="pnote">${esc(p.note)}</span>`:''}</button>`).join('')}</div>
   ${m.tech?`<div class="tech"><b>${esc(m.name)}.</b> ${esc(m.tech)}</div>`:''}
   <p class="fine">Costos de repuestos referenciales en CLP según planilla de repuestos Apple (iPhone actualizado al 06/11/2026) y Maestro Falabella 2026 para otras marcas (referencial por gama; modelos según lo vendido por Falabella en falabella.com al 10/11/2026); los rangos dependen de la capacidad y la variante; no incluyen el presupuesto técnico. Las coberturas están sujetas a las condiciones de cada producto: la garantía extendida cubre fallas de fabricación y no daño accidental, y su valor se toma de la garantía publicada en falabella.com (precio normal, revisado el 06/11/2026) para el producto de precio más cercano o, en Apple Watch, para su tramo de precio; la de 2 años, cuando falabella.com no la muestra, se estima como 1,47 veces la de 1 año (proporción observada en iPhone 16); si no hay referencia cercana se estima como porcentaje del precio (1 año ≈ 10 %, 2 años ≈ 17 %, editable en Ajustes); confirma el valor final en caja; el Seguro Connect se calcula con la prima en UF del tarifario CONNECT por la UF del día (editable en Ajustes); lo otorga Assurant Chile, intermediado por Seguros Falabella Corredores (POL 120130572 / CAD 120130658), primas IVA incluido. Cuotas calculadas con la tabla de cuotas de falabella.com; los plazos que no están en la tabla se interpolan. El CTC incluye impuesto de timbres. Valores finales según condiciones vigentes de CMR.</p></div>`;
}
function renderTable(){if(!$('qt'))return;
  const P=S.price,av=avail(),m=model();
  if(!P){$('qt').innerHTML='<tbody><tr><td style="position:static;text-align:left;font-size:16px">Escribe el precio del producto para ver la tabla.</td></tr></tbody>';return}
  const cols=[{k:'nor',name:norName(),sub:'Fabricante · 12 meses',v:0}];
  [['ge','Garantía extendida'],['p1','Seguro Daño y Robo'],['p2','Seguro Daño']].forEach(([k,name])=>{if(!av.includes(k))return;[12,24].forEach(cv=>{
    let v=0;if(k==='ge'){v=geVal(cv).v}else{v=segVal(k,cv,P).v||0}
    cols.push({k,name:k==='ge'?name+' '+YR(cv):name,sub:cv+' meses'+(k==='ge'&&geVal(cv).src==='pct'?' · estimado '+String(geVal(cv).pc).replace('.',',')+' %':k==='ge'&&geVal(cv).src==='fal'?' · falabella.com':k==='ge'&&geVal(cv).src==='est'?' · estimado':'')+(k==='ge'&&evtOn()?' · evento −'+evtPct()+' %':''),v})})});
  {const i=cols.findIndex(c=>c.k==='nor');const [nr]=cols.splice(i,1);const j=cols.filter(c=>c.k==='ge').length;cols.splice(j,0,nr)}
  const ns=[...new Set([1,3,6,10,12,24,36,48,S.n])].sort((a,b)=>a-b);
  $('qt').innerHTML=`<thead><tr><th>Cuotas</th>${cols.map(c=>`<th class="f-${c.k}">${c.name}<small>${c.sub}</small><b>${c.k==='nor'?'':c.v?clp(c.v):(c.k==='ge'?'Escribe el valor':'Fuera de tramo')}</b></th>`).join('')}</tr></thead>
   <tbody>${ns.map(n=>{const base=cuota(P,n,S.si);return `<tr data-row="${n}" class="${n===S.n?'on':''}"><td>${n===1?'1<small>contado</small>':n}</td>${cols.map(c=>{
     if(c.k==='nor')return `<td class="f-nor"><span class="q">${clp(base.q)}</span><span class="t">total ${clp(base.ctc)}</span></td>`;
     if(!c.v)return '<td class="na"></td>';const r=cuota(P+c.v,n,S.si);
     return `<td class="f-${c.k}"><span class="q">${clp(r.q)}</span><span class="d">+${clp(r.q-base.q)}${n===1?'':' al mes'}</span><span class="t">total ${clp(r.ctc)}</span></td>`}).join('')}</tr>`}).join('')}</tbody>`;
}
function renderPresu(){const c=cat(),v=CFG.presu[c.id]||0,el=$('presu');el.hidden=!v;if(!v){el.innerHTML='';return}
  el.innerHTML=`<div class="pz">${svg('board')}<div class="pz-x"><span class="pz-l">Presupuesto técnico · ${esc(c.name)}</span><span class="pz-t">Valor por revisar el equipo y cotizar la reparación en servicios técnicos autorizados. Se cobra aparte del repuesto.</span></div><span class="pz-v">${clp(v)}</span></div>`}
function renderAll(){renderCats();renderCaps();renderSide();renderCards();renderNeed();renderTable()}

/* ================== EVENTOS ================== */
document.addEventListener('click',e=>{const tr=e.target.closest('tr[data-row]');if(tr){S.n=+tr.dataset.row;renderSide();renderCards();renderNeed();renderTable();return}const t=e.target.closest('button');if(!t)return;
  if(t.dataset.ptype){S.ptype=t.dataset.ptype;if(S.autoP)applyAuto(null);renderSide();renderCards();renderNeed();renderTable();return}
  if(t.dataset.cap!=null){S.autoP=true;applyAuto(t.dataset.cap);renderSide();renderCards();renderNeed();renderTable();return}
  if(t.dataset.grp){S.grp=t.dataset.grp;const g=grp();S.cat=catFor(g.id,g.brands[0]).id;S.mi=0;S.capa='';S.part=-1;loadPrice();renderAll();return}
  if(t.dataset.brand){S.cat=catFor(S.grp,t.dataset.brand).id;S.mi=0;S.capa='';S.part=-1;loadPrice();renderAll();return}
  if(t.dataset.cat){S.cat=t.dataset.cat;S.mi=0;S.capa='';S.part=-1;loadPrice();renderAll();return}
  if(t.dataset.mi!=null){S.mi=+t.dataset.mi;S.capa='';S.part=-1;loadPrice();renderAll();return}
  if(t.dataset.n){if(t.dataset.n==='p2'){S.pie2=true;S.n=2}else{S.pie2=false;S.n=+t.dataset.n}renderSide();renderCards();renderNeed();renderTable();return}
  if(t.dataset.m){S.cov=+t.dataset.m;renderSide();renderCards();renderNeed();renderTable();return}
  if(t.dataset.part){S.part=+t.dataset.part;renderNeed();return}
  if(t.dataset.tab){document.querySelectorAll('[data-tab]').forEach(b=>b.setAttribute('aria-selected',String(b===t)));$('pRes').hidden=t.dataset.tab!=='res';$('pCov').hidden=t.dataset.tab!=='cov';$('pBen').hidden=t.dataset.tab!=='ben';if(t.dataset.tab==='ben'&&window.renderBen)renderBen();return}
  if(t.id==='home'){resetAll();window.scrollTo({top:0,behavior:'smooth'});return}
  if(t.id==='bAj'){openAj();return}
});
$('inPrice').addEventListener('input',e=>{if(S.autoP){S.autoP=false;renderAP()}const v=dg(e.target.value);S.price=v;S.example=false;e.target.value=v?v.toLocaleString('es-CL'):'';
  $('eg').hidden=true;renderCards();renderNeed();renderTable()});
$('inN').addEventListener('input',e=>{S.pie2=false;S.n=+e.target.value;renderSide();renderCards();renderNeed();renderTable()});
$('inSI').addEventListener('change',e=>{S.si=e.target.checked;renderCards();renderNeed();renderTable()});
$('cmp').addEventListener('change',e=>{const t=e.target;if(!t.dataset.ge)return;const v=dg(t.value);const k=mkey()+'|'+t.dataset.ge;if(v)S.geMan[k]=v;else delete S.geMan[k];renderCards();renderNeed();renderTable()});
$('cmp').addEventListener('input',e=>{const t=e.target;if(!t.dataset.ge)return;const v=dg(t.value);t.value=v?v.toLocaleString('es-CL'):''});

/* vuelta al inicio tras 2 min sin uso (nuevo cliente) */
function resetAll(){S.autoP=true;S.ptype='int';S.grp='tel';S.plan=false;S.ge2=false;S.evt=false;S.pie2=false;S.capa='';S.cat='iphone';S.mi=0;S.n=12;S.cov=12;S.si=false;S.part=-1;S.geMan={};const o=$('ovHost');if(o)o.innerHTML='';loadPrice();renderAll()}
let idle;const bump=()=>{clearTimeout(idle);idle=setTimeout(()=>{if(!document.querySelector('.ov')){resetAll();window.scrollTo(0,0)}},120000)};
['pointerdown','keydown','scroll','touchstart'].forEach(ev=>addEventListener(ev,bump,{passive:true}));bump();

/* ================== AJUSTES ================== */
const toTxt=t=>t.map(r=>[r.a,r.b,r.m12,r.m24].join('\t')).join('\n');
function parseTxt(s){return s.split(/\n+/).map(l=>l.trim()).filter(Boolean).map(l=>{const p=l.split(/\t|;|\s{2,}|\|/).map(x=>dg(x));return p.length>=4&&p[1]?{a:p[0],b:p[1],m12:p[2],m24:p[3]}:null}).filter(Boolean)}
let DB=null,CAN=false,docRef=null;
function openAj(){
  const f=CFG.fx;
  $('ovHost').innerHTML=`<div class="ov" id="ov"><div class="sheet" role="dialog" aria-modal="true" aria-labelledby="ajT"><div class="sheet-h"><h2 id="ajT">Ajustes<small>${DB?(CAN?'Se guardan para todos los equipos de la tienda':'Solo lectura: las tablas las edita el administrador'):'Se guardan en este equipo'}</small></h2><button class="pill gray" type="button" id="ajX">Cerrar</button><button class="pill" type="button" id="ajS">Guardar</button></div>
  <div class="sheet-b">
   <div class="panel"><h2>Garantía extendida · % del precio<small>Opcional · déjalo en 0 si no aplica</small></h2><div class="grid2"><div class="fld"><label class="lab" for="pc12">1 año (12 meses) %</label><input class="inp" id="pc12" inputmode="decimal" value="${String(CFG.gePct.m12).replace('.',',')}"></div><div class="fld"><label class="lab" for="pc24">2 años (24 meses) %</label><input class="inp" id="pc24" inputmode="decimal" value="${String(CFG.gePct.m24).replace('.',',')}"></div></div></div>
   <div class="panel"><h2>Evento garantía (iPad y Mac)<small>Descuento que aplica el botón "Evento garantía"</small></h2><div class="fld"><label class="lab" for="evtP">Descuento %</label><input class="inp" id="evtP" inputmode="numeric" value="${evtPct()}"></div></div>
   <div class="panel"><h2>Garantía extendida por tramo de precio<small>Opcional · tiene prioridad sobre el %</small></h2><div class="hint">Pega desde Excel 4 columnas: desde · hasta · 12 meses · 24 meses (una fila por tramo).</div><textarea class="inp" id="tGE" placeholder="150001	200000	19990	34990">${toTxt(CFG.ge)}</textarea><span class="hint" id="cGE"></span></div>
   <div class="panel"><h2>Seguro Connect · cálculo<small>Tarifario CONNECT con prima en UF por tramo</small></h2><div class="grid2"><div class="fld"><label class="lab" for="segMode">Calcular con</label><select class="inp" id="segMode"><option value="uf"${(CFG.segMode||'uf')==='uf'?' selected':''}>Prima UF × valor UF del día</option><option value="tab"${CFG.segMode==='tab'?' selected':''}>Precio en $ del folleto (UF 25/09/2024)</option></select></div><div class="fld"><label class="lab" for="ufIn">Valor UF</label><input class="inp" id="ufIn" inputmode="decimal" value="${String(Number(CFG.uf)||UF_DEF).replace('.',',')}"></div></div><div class="hint">UF del 05/11/2026 según SII: $41.274,20. Actualízala cuando cambie para que el seguro quede al día.</div></div>
   <div class="panel"><h2>Seguro Connect P1 · Daño + Robo<small>Solo celulares</small></h2><textarea class="inp" id="tP1">${toTxt(CFG.p1)}</textarea></div>
   <div class="panel"><h2>Seguro Connect P2 · Daño<small>Celulares, tablets, notebooks, smartwatch</small></h2><textarea class="inp" id="tP2">${toTxt(CFG.p2)}</textarea></div>
   <div class="panel"><h2>Presupuesto técnico por categoría</h2><div class="grid2">${CATS.filter(c=>c.brand==='Apple').map(c=>`<div class="fld"><label class="lab" for="pr_${c.id}">${c.name}</label><input class="inp" id="pr_${c.id}" data-pr="${c.id}" inputmode="numeric" value="${clp(CFG.presu[c.id]||0)}"></div>`).join('')}</div></div>
   <div class="panel"><h2>Cuotas de falabella.com<small>Las mismas del Price Ticket Apple</small></h2><div class="hint">Copia un precio y las cuotas que muestra el checkout. Los demás plazos de 1 a 48 se interpolan con la tasa de esta tabla.</div>
    <div class="fld"><label class="lab" for="fxP">Precio de referencia</label><input class="inp" id="fxP" inputmode="numeric" value="${clp(f.price)}"></div>
    <div class="grid2">${TERMS.map(n=>`<div class="fld"><label class="lab" for="fx${n}">${n} cuotas de</label><input class="inp" id="fx${n}" inputmode="numeric" value="${clp(f.c[n])}"></div>`).join('')}</div>
    <div class="hint">CTC de referencia (impuesto de timbres):</div>
    <div class="grid2"><div class="fld"><label class="lab" for="iteP">Precio</label><input class="inp" id="iteP" inputmode="numeric" value="${clp(CFG.ite.price)}"></div><div class="fld"><label class="lab" for="iteN">Cuotas</label><input class="inp" id="iteN" inputmode="numeric" value="${CFG.ite.n}"></div><div class="fld"><label class="lab" for="iteC">CTC</label><input class="inp" id="iteC" inputmode="numeric" value="${clp(CFG.ite.ctc)}"></div></div></div>
   <div class="panel"><h2>Estadísticas de uso</h2><div id="stBox"><div class="hint">Cargando…</div></div></div>
   <div class="panel"><h2>Respaldo</h2><div class="chips"><button class="pill gray" type="button" id="bExp">Descargar respaldo .json</button><label class="pill gray" for="fImp" style="cursor:pointer">Cargar respaldo</label><input type="file" id="fImp" accept=".json,application/json" hidden><button class="pill gray" type="button" id="bRst">Restablecer valores</button></div><div class="hint" id="rstH"></div></div>
  </div></div></div>`;
  loadStats();
  const upd=()=>{$('cGE').textContent=parseTxt($('tGE').value).length+' tramos'};upd();$('tGE').oninput=upd;
  $('ov').onclick=e=>{if(e.target.id==='ov')closeAj()};$('ajX').onclick=closeAj;
  $('ajS').onclick=saveAj;
  $('bExp').onclick=async()=>{const dl=await useCap('downloads');const data=JSON.stringify(CFG,null,2);if(!dl){toast('La descarga no está disponible en esta vista');return}try{await dl.save({filename:'protege-tu-apple-ajustes.json',data})}catch(e){toast('No se descargó el respaldo')}};
  $('fImp').onchange=e=>{const file=e.target.files[0];if(!file)return;const r=new FileReader();r.onload=()=>{try{const j=JSON.parse(r.result);if(!j.p1||!j.p2)throw 0;CFG={...def(),...j};persist();closeAj();renderAll();toast('Respaldo cargado')}catch(_){toast('El archivo no es un respaldo de esta app')}};r.readAsText(file)};
  let armed=false;$('bRst').onclick=()=>{if(!armed){armed=true;$('rstH').textContent='Toca otra vez para volver a las tablas originales. La tabla de garantía quedará vacía.';return}CFG=def();persist();closeAj();renderAll();toast('Valores restablecidos')};
}
function closeAj(){$('ovHost').innerHTML=''}
function saveAj(){
  const ge=parseTxt($('tGE').value),p1=parseTxt($('tP1').value),p2=parseTxt($('tP2').value);
  if(!p1.length||!p2.length){toast('Las tablas del Seguro Connect no pueden quedar vacías');return}
  const fx={price:dg($('fxP').value),c:{}};let ok=!!fx.price;TERMS.forEach(n=>{const v=dg($('fx'+n).value);if(!v)ok=false;fx.c[n]=v});
  if(!ok){toast('Completa el precio y todas las cuotas de referencia');return}
  const pnum=v=>{const x=parseFloat(String(v).replace(',','.'));return isFinite(x)&&x>=0?x:0};const gePct={m12:pnum($('pc12').value),m24:pnum($('pc24').value)};
  const presu={...CFG.presu};CATS.filter(c=>c.brand==='Apple').forEach(c=>presu[c.id]=dg($('pr_'+c.id).value));
  CFG={...CFG,segMode:$('segMode').value,uf:(()=>{const x=parseFloat(String($('ufIn').value).replace(/\./g,'').replace(',','.'));return x>1000?x:UF_DEF})(),evtPct:Math.min(90,dg($('evtP').value)||30),ge,gePct,p1,p2,presu,fx,ite:{price:dg($('iteP').value)||ITE_DEF.price,n:dg($('iteN').value)||3,ctc:dg($('iteC').value)||ITE_DEF.ctc},updated:new Date().toISOString()};
  persist();closeAj();renderAll();toast(DB&&CAN?'Guardado para toda la tienda':'Guardado en este equipo');
}
function persist(){try{localStorage.setItem(LS+'_cfg',JSON.stringify(CFG))}catch(_){}
  if(DB&&CAN&&docRef){docRef.set(JSON.parse(JSON.stringify({...CFG,fx:{price:CFG.fx.price,c:Object.fromEntries(Object.entries(CFG.fx.c).map(([k,v])=>['n'+k,v]))}}))).catch(()=>toast('No se pudo guardar para toda la tienda; quedó en este equipo'))}}
function fromDoc(d){if(!d||!d.p1)return null;const c={...def(),...d};if(!c.gePct||d.cfgV!==3){c.gePct=def().gePct;c.cfgV=3}if(d.fx&&d.fx.c){c.fx={price:d.fx.price,c:Object.fromEntries(Object.entries(d.fx.c).map(([k,v])=>[k.replace(/^n/,''),v]))}}return c}

/* tablas compartidas para todos los equipos de la tienda */
(async()=>{
  if(!window.claude||!claude.use)return;
  try{
    const [db,user]=await Promise.all([claude.use('db'),claude.use('user')]);if(!db)return;DB=db;
    CAN=user?(user.canEdit?!!(await user.canEdit()):false):false;
    try{db.doc('config/precios').onSnapshot(s=>{try{if(!s.exists)return;const d=s.data();const it=typeof d.items==='string'?JSON.parse(d.items):d.items;
      if(Array.isArray(it)&&it.length>=100&&it.every(r=>Array.isArray(r)&&r.length>=5&&typeof r[2]==='string'&&r[4]>0)){PRECIOS={t:d.t||'',items:it};PTOK=new Map();renderSide()}}catch(_){}},()=>{})}catch(_){}
    try{db.doc('config/planes').onSnapshot(s=>{try{if(!s.exists)return;const d=s.data();const it=typeof d.items==='string'?JSON.parse(d.items):d.items;
      if(Array.isArray(it)&&it.length>=20&&it.every(r=>Array.isArray(r)&&typeof r[1]==='string'&&r[2]>=1000)){PLANES={t:d.t||'',items:it};if(planOn()){renderSide();renderCards()}}}catch(_){}},()=>{})}catch(_){}
    docRef=db.doc('config/app');
    const tm=setTimeout(()=>{},10000);
    docRef.onSnapshot(s=>{clearTimeout(tm);const c=s.exists?fromDoc(s.data()):null;
      if(c){CFG=c;try{localStorage.setItem(LS+'_cfg',JSON.stringify(CFG))}catch(_){}renderCards();renderNeed();renderTable()}
      const st=$('sync');st.className='state ok';st.lastElementChild.textContent=c?'Tablas de la tienda':'Tablas originales';},()=>{});
  }catch(e){}
})();

/* ================== MEJORAS v3 ================== */
const useCap=async n=>{try{return (window.claude&&claude.use)?await claude.use(n):null}catch(_){return null}};
S.capa='';
function renderCaps(){}
const mname=()=>model().name+(S.capa?' '+S.capa:'');

/* filas comunes para tarjetas, modo cliente e imagen */
function quoteRows(){const P=bp(),R=calc(),av=avail(),cov=S.cov;if(!P)return [];
  const out=[];const push=(k,name,sub)=>{const r=R[k];if(k!=='nor'&&(!av.includes(k)||!r||r.q==null))return;
    out.push({k,name,sub,val:k==='nor'?0:r.pv.v,q:k==='nor'?R.nor.q:r.q,ctc:k==='nor'?R.nor.ctc:r.ctc,dq:k==='nor'?0:Math.max(0,S.n===1?r.dt:r.dq),est:k==='ge'&&r.pv&&(r.pv.src==='pct'||r.pv.src==='est')})};
  push('ge','Garantía extendida '+YR(cov),`${cov} meses adicionales`);
  if(!planOn())push('nor',norName(),'Fabricante · 12 meses');
  push('p1','Seguro Daño y Robo',`Connect · ${cov} meses`);
  push('p2','Seguro Daño',`Connect · ${cov} meses`);return out}
const nLab=()=>S.pie2?'Pie y 2 cuotas de':S.n===1?'Contado':`${S.n} cuotas${S.si?' sin interés':''} de`;
const ICO={ge:'total',nor:'board',p1:'robo',p2:'drop'};

/* vista iPhone: tarjetas apiladas */
function renderMCards(){const el=$('mcards');if(!el)return;const rows=quoteRows();
  if(!rows.length){el.innerHTML=S.price?'':'<div class="mc"><b>Escribe el precio del producto</b><span class="sm">Aquí aparecen las cuotas con cada protección.</span></div>';
    if(S.price&&avail().includes('ge')&&geVal(S.cov).src==='none')el.innerHTML='';return}
  el.innerHTML=rows.map(r=>`<article class="mc c-${r.k}">${r.k==='ge'?'<span class="rec">Recomendado</span>':''}<div class="mc-h">${svg(ICO[r.k])}<div><b>${r.name}</b><small>${r.sub}</small></div></div>
    <div class="mc-q"><small>${nLab()}</small><span>${clp(r.q)}</span></div>
    ${r.k==='ge'?'<span class="rec100">Recupera el 100 % de la inversión</span>':(r.k==='p1'||r.k==='p2')?'<span class="rec70">Recupera el 70 % de la inversión</span>':''}<div class="mc-f">${r.k==='nor'?`<span>${S.pie2?'Pie '+clp(calc().nor.pie)+' · total':'Total (CTC)'} ${clp(r.ctc)}</span>`:`<span class="dv">+${clp(r.dq)}${S.pie2?' por cuota':S.n===1?'':' al mes'}</span><span>Valor ${clp(r.val)}${r.est?' (estimado)':''} · Total ${clp(r.ctc)}</span>`}</div></article>`).join('');}

/* estadísticas de uso */
const LOGGED=new Set();let qT;
async function logEvent(type){const ev={t:new Date().toISOString(),type,cat:S.cat,model:model().name,n:S.n,cov:S.cov,price:S.price||0};
  try{const a=JSON.parse(localStorage.getItem(LS+'_stats')||'[]');a.push(ev);localStorage.setItem(LS+'_stats',JSON.stringify(a.slice(-3000)))}catch(_){}
  if(DB){try{await DB.collection('stats').add(ev)}catch(_){}}}
function trackQuote(){clearTimeout(qT);qT=setTimeout(()=>{if(!S.price)return;const k=mkey()+'|'+S.price;if(LOGGED.has(k))return;LOGGED.add(k);logEvent('cotizacion')},4000)}
async function loadStats(){let evs=[],src='este equipo';
  if(DB&&CAN){try{const snap=await DB.collection('stats').orderBy('t','desc').limit(1000).get();evs=snap.docs.map(d=>d.data());src='toda la tienda'}catch(_){}}
  if(!evs.length){try{evs=JSON.parse(localStorage.getItem(LS+'_stats')||'[]')}catch(_){}src='este equipo'}
  const now=Date.now(),day=864e5,since=d=>evs.filter(e=>now-Date.parse(e.t)<d*day);
  const today=evs.filter(e=>new Date(e.t).toDateString()===new Date().toDateString());
  const cnt=(a,t)=>a.filter(e=>e.type===t).length;const m30=since(30);
  const byCat=GROUPS.map(g=>[g.name,m30.filter(e=>e.type==='cotizacion'&&(CATS.find(c=>c.id===e.cat)||{}).grp===g.id).length]);
  const topM={};m30.filter(e=>e.type==='cotizacion').forEach(e=>topM[e.model]=(topM[e.model]||0)+1);
  const top=Object.entries(topM).sort((a,b)=>b[1]-a[1]).slice(0,5);
  const el=$('stBox');if(!el)return;
  el.innerHTML=`<div class="hint">Datos de ${src}. Se cuenta una cotización cuando el precio queda escrito 4 segundos.</div>
   <div class="st3"><div><span>Hoy</span><b>${cnt(today,'cotizacion')}</b></div><div><span>7 días</span><b>${cnt(since(7),'cotizacion')}</b></div><div><span>30 días</span><b>${cnt(m30,'cotizacion')}</b></div></div>
   <div class="stl"><b>Por categoría · 30 días</b>${byCat.map(([n,v])=>`<div><span>${n}</span><i style="width:${Math.max(2,v/Math.max(1,...byCat.map(b=>b[1]))*100)}%"></i><b>${v}</b></div>`).join('')}</div>
   ${top.length?`<div class="stl"><b>Modelos más cotizados · 30 días</b>${top.map(([n,v])=>`<div><span>${esc(n)}</span><i style="width:${v/top[0][1]*100}%"></i><b>${v}</b></div>`).join('')}</div>`:''}`}

document.addEventListener('click',e=>{const t=e.target.closest('button');if(!t)return;
});
$('inPrice').addEventListener('input',trackQuote);
matchMedia('(max-width:700px)').addEventListener?.('change',()=>renderMCards());

function pieHint(){const h=$('pieH');if(!h)return;h.textContent=S.pie&&S.price&&!pieOk()?'El pie debe ser menor que el precio.':(pieOk()?`El resto se paga en 2 cuotas sin interés. Total = precio contado.`:'Vacío: 3 pagos iguales (pie + 2 cuotas sin interés).')}
$('inGe2').addEventListener('change',e=>{S.ge2=e.target.checked;if(S.ge2)S.cov=24;renderAll()});
$('inAP').addEventListener('change',e=>{S.autoP=e.target.checked;if(S.autoP)applyAuto(null);else{S.price=0;S.capa='';$('inPrice').value=''}renderSide();renderCards();renderNeed();renderTable()});
$('inEvt').addEventListener('change',e=>{S.evt=e.target.checked;renderCards();renderNeed();renderTable()});
$('inPlan').addEventListener('change',e=>{S.plan=e.target.checked;renderSide();renderCards();renderNeed();renderTable()});
loadPrice();renderAll();
</script>

<script>
/* ================== EXCHANGE PLANES ================== */
(function(){
const capOf=s=>{const re=/(\d+)\s*(gb|tb)\b/gi;let m;while((m=re.exec(String(s)))){const n=+m[1],u=m[2].toUpperCase();if((u==='GB'&&[64,128,256,512].includes(n))||(u==='TB'&&[1,2].includes(n)))return n+u}return ''};
const nmI=s=>{const t=String(s).replace(/[()]/g,' ').trim().split(/\s+/);const i=t.findIndex(w=>/^iphone$/i.test(w));const out=[];
  for(let j=i+1;j<t.length;j++){const w=t[j].toLowerCase();
    if(!out.length){if(/^(\d{1,2}e?|air|duo|se|xr|xs|x)$/.test(w))out.push(w==='air'||w==='duo'?w[0].toUpperCase()+w.slice(1):(/^\d+e$/.test(w)?w:w.toUpperCase()));else break}
    else if(/^(pro|max|plus|mini)$/.test(w))out.push(w[0].toUpperCase()+w.slice(1));
    else if(w==='e'&&/^\d+$/.test(out[0]))out[0]+='e';
    else if(/^\(?(20\d\d)\)?$/.test(w)&&out[0]==='SE')out.push('('+w.replace(/\D/g,'')+')');
    else break}
  return out.length?'iPhone '+out.join(' '):null};
const CAPS=['64GB','128GB','256GB','512GB','1TB','2TB'];
const capSort=(a,b)=>CAPS.indexOf(a)-CAPS.indexOf(b);
const mKey=n=>{const m=String(n).match(/iPhone (\d+)/);let v=m?+m[1]:/Air/.test(n)?17.5:/Duo/.test(n)?18.5:/SE/.test(n)?9:/XR|XS|X\b/.test(n)?10:0;
  v+= /Pro Max/.test(n)?.4:/Pro/.test(n)?.3:/Plus/.test(n)?.2:/mini/.test(n)?.05:/\d+e\b/.test(n)?-.1:0;return v};
const byModel=(a,b)=>mKey(b)-mKey(a);
const dd=t=>{const d=String(t||'').slice(0,10).split('-');return d.length===3?d[2]+'/'+d[1]:'—'};

/* equipos usados aceptados (respaldo mientras no llega la base Exchange) */
const XFALL=[['iPhone 11',['64GB','128GB','256GB']],['iPhone 11 Pro',['64GB','256GB','512GB']],['iPhone 11 Pro Max',['64GB','256GB','512GB']],
 ['iPhone SE (2020)',['64GB','128GB','256GB']],['iPhone SE (2022)',['64GB','128GB','256GB']],['iPhone 12 mini',['64GB','128GB','256GB']],['iPhone 12',['64GB','128GB','256GB']],['iPhone 12 Pro',['128GB','256GB','512GB']],['iPhone 12 Pro Max',['128GB','256GB','512GB']],
 ['iPhone 13 mini',['128GB','256GB','512GB']],['iPhone 13',['128GB','256GB','512GB']],['iPhone 13 Pro',['128GB','256GB','512GB','1TB']],['iPhone 13 Pro Max',['128GB','256GB','512GB','1TB']],
 ['iPhone 14',['128GB','256GB','512GB']],['iPhone 14 Plus',['128GB','256GB','512GB']],['iPhone 14 Pro',['128GB','256GB','512GB','1TB']],['iPhone 14 Pro Max',['128GB','256GB','512GB','1TB']],
 ['iPhone 15',['128GB','256GB','512GB']],['iPhone 15 Plus',['128GB','256GB','512GB']],['iPhone 15 Pro',['128GB','256GB','512GB','1TB']],['iPhone 15 Pro Max',['256GB','512GB','1TB']],
 ['iPhone 16e',['128GB','256GB','512GB']],['iPhone 16',['128GB','256GB','512GB']],['iPhone 16 Plus',['128GB','256GB','512GB']],['iPhone 16 Pro',['128GB','256GB','512GB','1TB']],['iPhone 16 Pro Max',['256GB','512GB','1TB']],
 ['iPhone 17e',['256GB','512GB']],['iPhone 17',['256GB','512GB']],['iPhone Air',['256GB','512GB','1TB']],['iPhone 17 Pro',['256GB','512GB','1TB']],['iPhone 17 Pro Max',['256GB','512GB','1TB','2TB']]];

let EXCH={t:'2026-11-11',items:[["iPhone SE (2020)", "128GB", 73495], ["iPhone SE (2020)", "256GB", 83990], ["iPhone SE (2020)", "64GB", 56693], ["iPhone SE (2022)", "128GB", 167993], ["iPhone SE (2022)", "256GB", 187493], ["iPhone SE (2022)", "64GB", 139993], ["iPhone 11", "64GB", 113893], ["iPhone 11", "128GB", 125393], ["iPhone 11", "256GB", 135000], ["iPhone 11 Pro", "64GB", 153993], ["iPhone 11 Pro", "128GB", 183750], ["iPhone 11 Pro", "256GB", 178493], ["iPhone 11 Pro", "512GB", 202993], ["iPhone 11 Pro Max", "64GB", 188993], ["iPhone 11 Pro Max", "128GB", 202500], ["iPhone 11 Pro Max", "256GB", 209993], ["iPhone 11 Pro Max", "512GB", 230993], ["iPhone 12", "64GB", 158393], ["iPhone 12", "128GB", 184793], ["iPhone 12", "256GB", 209993], ["iPhone 12 mini", "128GB", 167990], ["iPhone 12 mini", "256GB", 181990], ["iPhone 12 mini", "64GB", 145193], ["iPhone 12 Pro", "128GB", 217793], ["iPhone 12 Pro", "256GB", 251993], ["iPhone 12 Pro", "512GB", 279993], ["iPhone 12 Pro Max", "128GB", 265993], ["iPhone 12 Pro Max", "256GB", 277193], ["iPhone 12 Pro Max", "512GB", 328993], ["iPhone 13", "128GB", 207894], ["iPhone 13", "256GB", 239394], ["iPhone 13", "512GB", 283494], ["iPhone 13 mini", "128GB", 188994], ["iPhone 13 mini", "256GB", 214194], ["iPhone 13 mini", "512GB", 239394], ["iPhone 13 Pro", "1TB", 377994], ["iPhone 13 Pro", "128GB", 289794], ["iPhone 13 Pro", "256GB", 291054], ["iPhone 13 Pro", "512GB", 352794], ["iPhone 13 Pro Max", "1TB", 428391], ["iPhone 13 Pro Max", "128GB", 327594], ["iPhone 13 Pro Max", "256GB", 365394], ["iPhone 13 Pro Max", "512GB", 396894], ["iPhone 14", "128GB", 270593], ["iPhone 14", "256GB", 321993], ["iPhone 14", "512GB", 349993], ["iPhone 14 Plus", "128GB", 321993], ["iPhone 14 Plus", "256GB", 349993], ["iPhone 14 Plus", "512GB", 367493], ["iPhone 14 Pro", "128GB", 369593], ["iPhone 14 Pro", "1TB", 517993], ["iPhone 14 Pro", "256GB", 433993], ["iPhone 14 Pro", "512GB", 475993], ["iPhone 14 Pro Max", "128GB", 415793], ["iPhone 14 Pro Max", "1TB", 559993], ["iPhone 14 Pro Max", "256GB", 448793], ["iPhone 14 Pro Max", "512GB", 524993], ["iPhone 15", "128GB", 311994], ["iPhone 15", "256GB", 419993], ["iPhone 15", "512GB", 454993], ["iPhone 15 Plus", "128GB", 419993], ["iPhone 15 Plus", "256GB", 454993], ["iPhone 15 Plus", "512GB", 489993], ["iPhone 15 Pro", "128GB", 489993], ["iPhone 15 Pro", "1TB", 650993], ["iPhone 15 Pro", "256GB", 494993], ["iPhone 15 Pro", "512GB", 587265], ["iPhone 15 Pro Max", "1TB", 699993], ["iPhone 15 Pro Max", "256GB", 587993], ["iPhone 15 Pro Max", "512GB", 629993], ["iPhone 16", "128GB", 475993], ["iPhone 16", "256GB", 494993], ["iPhone 16", "512GB", 601993], ["iPhone 16 Plus", "128GB", 538993], ["iPhone 16 Plus", "256GB", 573993], ["iPhone 16 Plus", "512GB", 608993], ["iPhone 16 Pro", "128GB", 580793], ["iPhone 16 Pro", "256GB", 626993], ["iPhone 16 Pro", "512GB", 682500], ["iPhone 16 Pro", "1TB", 741993], ["iPhone 16 Pro Max", "256GB", 699993], ["iPhone 16 Pro Max", "512GB", 811993], ["iPhone 16 Pro Max", "1TB", 909993], ["iPhone 16e", "128GB", 328993], ["iPhone 16e", "256GB", 356993], ["iPhone 16e", "512GB", 384993], ["iPhone 17", "256GB", 545994], ["iPhone 17", "512GB", 577643], ["iPhone Air", "256GB", 514010], ["iPhone Air", "512GB", 664993], ["iPhone Air", "1TB", 699993], ["iPhone 17 Pro", "256GB", 682494], ["iPhone 17 Pro", "512GB", 802120], ["iPhone 17 Pro", "1TB", 1104994], ["iPhone 17 Pro Max", "256GB", 844994], ["iPhone 17 Pro Max", "512GB", 903715], ["iPhone 17 Pro Max", "1TB", 1234994], ["iPhone 17 Pro Max", "2TB", 1364994], ["iPhone 17e", "256GB", 293580], ["iPhone 17e", "512GB", 418950]]};
let LIB={t:APR.t,items:APR.items.filter(r=>/^iPhone/.test(r[0])&&r[1]).map(r=>[r[0],r[1],r[2],r[3]||0])};

function exMap(){const o={};for(const r of EXCH.items){const n=/iphone/i.test(r[0])?(nmI(r[0])||r[0]):r[0];const c=CAPS.includes(r[1])?r[1]:capOf(r[1]);if(!(r[2]>0))continue;(o[n]=o[n]||{})[c||'']=r[2]}return o}
function libMap(){const o={};for(const r of LIB.items){const n=nmI(r[0]);if(!n||!(r[2]>0))continue;const c=CAPS.includes(r[1])?r[1]:capOf(r[0]);const m=(o[n]=o[n]||{});const x=m[c];const cm=r[3]>0&&r[3]<r[2]?r[3]:0;
  if(!x)m[c]={v:r[2],c:cm};else{if(r[2]<x.v)x.v=r[2];if(cm&&(!x.c||cm<x.c))x.c=cm}}return o}
function planMap(){const o={};for(const r of (PLANES.items||[])){if(!Array.isArray(r)||r[0]!=='Apple')continue;const v=r[2];if(!(v>=9990&&String(v).endsWith('990')))continue;const n=nmI(r[1]);if(!n)continue;
  (o[n]=o[n]||[]).push({v,op:r[3]||'',cap:capOf(r[1]),name:r[1]})}for(const k in o)o[k].sort((a,b)=>a.v-b.v);return o}

const X0=()=>({on:false,gm:'',gc:'',gv:0,gvMan:false,bat:false,mode:'lib',nm:'',nc:'',pt:'int',price:0,priceMan:false,op:0,ci:0,ciMan:false,n:12,si:false,cov:12});
let X=X0();window.__X=()=>X;

const fmt=v=>v?Math.round(v).toLocaleString('es-CL'):'';
const opt=(v,l,sel)=>`<option value="${esc(v)}"${sel?' selected':''}>${esc(l)}</option>`;

function giftModels(){const em=exMap();const ks=Object.keys(em);if(ks.length)return {src:'ex',list:ks.sort(byModel).map(n=>[n,Object.keys(em[n]).sort(capSort)]),em};
  return {src:'fb',list:XFALL.slice().sort((a,b)=>byModel(a[0],b[0])),em}}
function newModels(){if(X.mode==='plan'){const pm=planMap();return Object.keys(pm).sort(byModel)}return Object.keys(libMap()).sort(byModel)}

function setGift(){const g=giftModels();const row=g.list.find(r=>r[0]===X.gm);if(!row){X.gv=X.gvMan?X.gv:0;return}
  if(!row[1].includes(X.gc))X.gc=row[1][0]||'';const v=g.src==='ex'&&g.em[X.gm]?g.em[X.gm][X.gc]:0;if(!X.gvMan)X.gv=v||0}
function opsFor(nm,nc){const all=planMap()[nm]||[];const byCap=nc?all.filter(o=>o.cap===nc):[];const src=byCap.length?byCap:all;const m={};for(const o of src){const k=(o.op||'').toUpperCase();if(!m[k]||o.v<m[k].v)m[k]=o}return Object.values(m).sort((a,b)=>a.v-b.v)}
function setNew(){const lm=libMap(),pm=planMap();
  if(X.mode==='plan'){const ops=opsFor(X.nm,X.nc);if(X.op>=ops.length)X.op=0;if(!X.ciMan)X.ci=ops[X.op]?ops[X.op].v:0;
    const caps=Object.keys(lm[X.nm]||{}).sort(capSort);const pc=ops[X.op]&&ops[X.op].cap;if(!caps.includes(X.nc))X.nc=(pc&&caps.includes(pc))?pc:(caps[0]||pc||'');
    if(!X.priceMan){const p=(lm[X.nm]||{})[X.nc];X.price=p?p.v:0}}
  else{const caps=Object.keys(lm[X.nm]||{}).sort(capSort);if(!caps.includes(X.nc))X.nc=caps[0]||'';if(!X.priceMan){const p=(lm[X.nm]||{})[X.nc];X.price=p?(X.pt==='cmr'&&p.c?p.c:p.v):0}}}

const giftNet=()=>Math.max(0,(X.gv||0)-(X.bat?40000:0));
const baseAmt=()=>X.mode==='plan'?(X.ci||0):(X.price||0);
const toPay=()=>Math.max(0,baseAmt()-giftNet());

function xProt(k){if(!X.price)return null;const ip=CATS.find(c=>c.id==='iphone');const mi=ip.models.findIndex(m=>m.name.toLowerCase()===String(X.nm).toLowerCase());
  const sv={grp:S.grp,cat:S.cat,mi:S.mi,price:S.price,plan:S.plan,cov:S.cov,ge2:S.ge2,evt:S.evt,pie2:S.pie2,geMan:S.geMan};
  Object.assign(S,{grp:'tel',cat:'iphone',mi:mi<0?0:mi,price:X.price,plan:X.mode==='plan',cov:X.cov,ge2:false,evt:false,pie2:false,geMan:{}});
  try{if(mi<0&&k==='ge'){const tt=TEL_GE.find(r=>X.price<=r[0]);if(X.cov===12&&tt)return {v:tt[1],src:'fal'}}return protVal(k)}catch(e){return null}finally{Object.assign(S,sv)}}

function render(){const P=$('xPanel');if(!P||P.hidden)return;
  /* 1 · equipo entregado */
  const g=giftModels();if(!X.gm||!g.list.some(r=>r[0]===X.gm))X.gm=g.list[0]?g.list[0][0]:'';setGift();
  $('xGm').innerHTML=g.list.map(r=>opt(r[0],r[0],r[0]===X.gm)).join('');
  const caps=(g.list.find(r=>r[0]===X.gm)||[0,[]])[1];$('xGc').innerHTML=caps.map(c=>opt(c,capLab(c),c===X.gc)).join('');
  if(document.activeElement!==$('xGv'))$('xGv').value=X.gv?'$'+fmt(X.gv):'';
  const s=$('xGsrc');if(g.src==='ex'){const v=g.em[X.gm]&&g.em[X.gm][X.gc];s.className='xsrc'+(v?'':' warn');s.textContent=X.gvMan?'Monto escrito a mano.':v?`Valor Exchange falabella.com al ${dd(EXCH.t)}.`:'Sin valor publicado para esta capacidad: escribe el monto de la evaluación.'}
  else{s.className='xsrc warn';s.textContent='La base Exchange se carga cada día a las 9:00. Mientras tanto, escribe el monto que entrega la evaluación.'}
  $('xBat').checked=X.bat;
  const gn=giftNet();$('xGift').innerHTML=`<span>Gift card que recibe</span><b>${X.bat&&X.gv?`<s>${clp(X.gv)}</s>`:''}${clp(gn)}</b>`;
  /* 2 · equipo nuevo */
  document.querySelectorAll('[data-xm]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.xm===X.mode)));
  const nms=newModels();if(!nms.includes(X.nm))X.nm=nms.find(n=>n==='iPhone 17')||nms[0]||'';setNew();
  $('xNm').innerHTML=nms.map(n=>opt(n,n,n===X.nm)).join('')||opt('','Sin modelos',true);
  const lm=libMap(),ncaps=Object.keys(lm[X.nm]||{}).sort(capSort);const cl=ncaps.length?ncaps:(X.nc?[X.nc]:[]);
  $('xNc').innerHTML=cl.map(c=>opt(c,capLab(c),c===X.nc)).join('')||opt('','—',true);
  const plan=X.mode==='plan';$('xPt').hidden=plan;$('xOpL').hidden=!plan;$('xCiL').hidden=!plan;
  document.querySelectorAll('[data-xp]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.xp===X.pt)));
  const pr=(lm[X.nm]||{})[X.nc];const cmrBtn=document.querySelector('[data-xp="cmr"]');cmrBtn.disabled=!(pr&&pr.c);
  if(plan){const ops=opsFor(X.nm,X.nc);$('xOp').innerHTML=ops.map((o,i)=>opt(i,`${o.op||'Operador'} · cuota inicial ${clp(o.v)}`,i===X.op)).join('')||opt('','Sin plan publicado',true);
    if(document.activeElement!==$('xCi'))$('xCi').value=X.ci?'$'+fmt(X.ci):''}
  $('xNpLab').textContent=plan?'Precio oferta del equipo (base del Seguro Connect 70 %)':(X.pt==='cmr'?'Precio CMR del equipo':'Precio oferta del equipo');
  if(document.activeElement!==$('xNp'))$('xNp').value=X.price?'$'+fmt(X.price):'';
  $('xNsrc').textContent=(plan?`Planes falabella.com al ${dd(PLANES.t)}`+(X.ciMan?' · cuota escrita a mano':'')+' · ':'')+(X.priceMan?'Precio escrito a mano':`Precios falabella.com al ${dd(LIB.t)}`)+'. Si la etiqueta de la tienda difiere, escribe el valor.';
  /* resultado */
  const base=baseAmt(),pay=toPay(),nm=X.nm+(X.nc?' '+capLab(X.nc):'');const op=plan&&opsFor(X.nm,X.nc)[X.op];
  $('xRes').innerHTML=`<h2 class="xh">Resumen para el cliente</h2>
   <div class="xeq"><div class="t"><small>${plan?'Cuota inicial':'Precio'} ${esc(nm)}${plan&&op?' · '+esc(op.op):''}</small><b${plan?' class="plci"':''}>${clp(base)}</b></div><span class="op">−</span>
   <div class="t gc"><small>Gift card Exchange · ${esc(X.gm)} ${esc(capLab(X.gc))}${X.bat?' · batería bajo 80 %':''}</small><b>${clp(giftNet())}</b></div><span class="op">=</span>
   <div class="t tot"><small>El cliente paga</small><b>${clp(pay)}</b></div></div>
   <p class="xnote">${!base?'Elige el equipo nuevo y revisa el '+(plan?'valor de la cuota inicial.':'precio.'):giftNet()>base?`La gift card cubre todo. Queda un saldo a favor de <b>${clp(giftNet()-base)}</b> en la gift card.`:plan?`Saldo de la cuota inicial <b>${clp(pay)}</b> financiado con CMR.`:`Saldo <b>${clp(pay)}</b> se paga al contado o en cuotas con CMR.`}</p>`;
  /* financiamiento */
  $('xQn').innerHTML=[1,3,6,12,18,24,36,48].map(n=>`<button class="chip" type="button" data-xn="${n}" aria-pressed="${n===X.n}">${n===1?'Contado':n}</button>`).join('');
  document.querySelectorAll('[data-xc]').forEach(b=>b.setAttribute('aria-pressed',String(+b.dataset.xc===X.cov)));$('xSI').checked=X.si;
  if(!base){$('xTbl').innerHTML='<div class="xc"><h3>Completa los datos</h3><small>Aquí aparecen las cuotas del saldo con cada protección.</small></div>';return}
  const n=X.n,si=X.si,yr=X.cov===12?'1 año':'2 años';const b0=cuota(pay,n,si);
  const WH={p1:'Daño accidental (caídas, golpes, líquidos) y robo del equipo.',p2:'Daño accidental: caídas, golpes y líquidos.',ge:'Fallas mecánicas, eléctricas o electrónicas por '+yr+' más, desde que termina la garantía Apple. Incluye daño por variación de voltaje.',nor:'Fallas de fabricación durante el primer año.'};
  const RC={p1:'<span class="rec70">Recupera el 70 % de la inversión</span>',p2:'<span class="rec70">Recupera el 70 % de la inversión</span>',ge:'<span class="rec70 rec100">Recupera el 100 % de la inversión</span>',nor:''};
  const cols=[{k:'p1',t:'Seguro Connect Daño y Robo',s:'Connect · '+X.cov+' meses'+(plan?' · sobre el 70 %':'')},{k:'p2',t:'Seguro Connect Daño',s:'Connect · '+X.cov+' meses'+(plan?' · sobre el 70 %':'')}];
  if(!plan)cols.push({k:'ge',t:'Garantía extendida '+yr,s:X.cov+' meses adicionales'});
  cols.push({k:'nor',t:'Garantía fabricante',s:'Apple · 12 meses'});
  const lab=n===1?'Contado':`${n} cuotas${si?' sin interés':''} de`;
  const IC={p1:'robo',p2:'drop',ge:'total',nor:'board'};
  $('xTbl').innerHTML=cols.map((c,i)=>{const hi=i===0?' hi':'';const top=`${i===0?'<span class="rec">Recomendado</span>':''}<div class="mc-h">${svg(IC[c.k])}<div><b>${c.t}</b><small>${c.s}</small></div></div>`;
    if(c.k==='nor')return `<article class="mc c-nor${hi}">${top}<div class="mc-q"><small>${lab}</small><span>${clp(b0?b0.q:0)}</span></div><div class="mc-f"><span>Total (CTC) ${clp(b0?b0.ctc:0)}</span><span class="what">${WH.nor}</span></div></article>`;
    const pv=xProt(c.k);if(!pv||!pv.v)return `<article class="mc c-${c.k}${hi}">${top}<div class="mc-f"><span>${X.price?'Precio fuera de los tramos':'Escribe el precio oferta del equipo para calcular la protección'}</span></div>${RC[c.k]}<div class="mc-f"><span class="what">${WH[c.k]}</span></div></article>`;
    const q=cuota(pay+pv.v,n,si);const d=Math.max(0,n===1?q.ctc-b0.ctc:q.q-b0.q);
    return `<article class="mc c-${c.k}${hi}">${top}<div class="mc-q"><small>${lab}</small><span>${clp(q.q)}</span></div>${RC[c.k]}<div class="mc-f"><span class="dv">+${clp(d)}${n===1?'':' al mes'}</span><span>Valor ${clp(pv.v)}${pv.src==='pct'||pv.src==='est'?' (estimado)':''} · Total ${clp(q.ctc)}</span><span class="what">${WH[c.k]}</span></div></article>`}).join('');
  if(window.STAT&&base&&giftNet())STAT.once('excq',X.gm+X.gc+X.nm+X.nc+X.mode);
}

function view(){const on=X.on;document.querySelectorAll('[data-calc]').forEach(e=>e.hidden=on);$('brands').hidden=on;$('models').hidden=on;$('xPanel').hidden=!on;
  document.querySelectorAll('.cat[data-grp]').forEach(b=>b.setAttribute('aria-pressed',String(on?b.dataset.grp==='exc':b.dataset.grp===S.grp)));if(on)render()}
const XICO='<svg class="bigico" viewBox="0 0 64 64" aria-hidden="true"><defs><linearGradient id="gxe" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#6be04f"/><stop offset="1" stop-color="#22a82a"/></linearGradient></defs><circle cx="32" cy="32" r="31" fill="url(#gxe)"/><circle cx="32" cy="32" r="30.5" fill="none" stroke="rgba(255,255,255,.35)" stroke-width="1"/><g fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M17 23h20v22H17z"/><path d="M22 23v-3a5 5 0 0 1 10 0v3"/><path d="M41 31l2.3 2.1 3.1-.4.7 3 2.8 1.4-1 2.9 1 2.9-2.8 1.4-.7 3-3.1-.4L41 52l-2.3-2.1-3.1.4-.7-3-2.8-1.4 1-2.9-1-2.9 2.8-1.4.7-3 3.1.4z" fill="#2fb52f"/><path d="M38.2 45.6l5.6-7.2"/><circle cx="38.6" cy="39" r="1.3" fill="#fff" stroke="none"/><circle cx="43.4" cy="45" r="1.3" fill="#fff" stroke="none"/></g></svg>';
const _rc=renderCats;renderCats=function(){_rc();$('cats').insertAdjacentHTML('beforeend',`<button class="cat" type="button" data-grp="exc" aria-pressed="${X.on}">${XICO}<span>Exchange Planes</span></button>`);if(X.on)view()};
const _ra=resetAll;resetAll=function(){X=X0();const b=$('xBkOk');if(b){b.checked=false;$('xBk').classList.remove('ok')}_ra();view()};

document.addEventListener('click',e=>{const c=e.target.closest('.cat[data-grp]');
  if(c&&c.dataset.grp==='exc'){e.stopImmediatePropagation();X.on=true;view();return}
  if(c){X.on=false;view();return}
  if(!X.on)return;const t=e.target.closest('button');if(!t||!t.closest('#xPanel'))return;
  if(t.dataset.xm){X.mode=t.dataset.xm;X.nm='';X.nc='';X.priceMan=false;X.ciMan=false;X.op=0}
  else if(t.dataset.xp){if(t.disabled)return;X.pt=t.dataset.xp;X.priceMan=false}
  else if(t.dataset.xn){X.n=+t.dataset.xn}
  else if(t.dataset.xc){X.cov=+t.dataset.xc}
  else return;render()},true);
$('xGm').addEventListener('change',e=>{X.gm=e.target.value;X.gc='';X.gvMan=false;render()});
$('xGc').addEventListener('change',e=>{X.gc=e.target.value;X.gvMan=false;render()});
$('xNm').addEventListener('change',e=>{X.nm=e.target.value;X.nc='';X.op=0;X.priceMan=false;X.ciMan=false;render()});
$('xNc').addEventListener('change',e=>{X.nc=e.target.value;X.priceMan=false;X.ciMan=false;X.op=0;render()});
$('xOp').addEventListener('change',e=>{X.op=+e.target.value||0;X.ciMan=false;render()});
$('xBat').addEventListener('change',e=>{X.bat=e.target.checked;render()});
$('xSI').addEventListener('change',e=>{X.si=e.target.checked;render()});
const money=(id,set)=>{const el=$(id);el.addEventListener('input',()=>{const v=dg(el.value);el.value=v?'$'+fmt(v):'';set(v);render()});el.addEventListener('blur',render)};
money('xGv',v=>{X.gv=v;X.gvMan=true});money('xNp',v=>{X.price=v;X.priceMan=!!v});money('xCi',v=>{X.ci=v;X.ciMan=!!v});

/* marcar las secciones de la calculadora normal */
document.querySelectorAll('section.wrap').forEach(s=>{if(s.id!=='xPanel'&&!s.classList.contains('hero'))s.setAttribute('data-calc','')});
renderCats();

/* datos compartidos: base Exchange y precios de iPhone liberados (se actualizan cada día a las 9:00) */
(async()=>{try{if(!window.claude||!claude.use)return;const db=await claude.use('db');if(!db)return;
  db.doc('config/exchange').onSnapshot(s=>{try{if(!s.exists)return;const d=s.data();const it=typeof d.items==='string'?JSON.parse(d.items):d.items;
    if(Array.isArray(it)&&it.length>=5&&it.every(r=>Array.isArray(r)&&typeof r[0]==='string'&&r[2]>=0)){EXCH={t:d.t||'',items:it};render()}}catch(_){}},()=>{});
  db.doc('config/liberados').onSnapshot(s=>{try{if(!s.exists)return;const d=s.data();const it=typeof d.items==='string'?JSON.parse(d.items):d.items;
    if(Array.isArray(it)&&it.length>=5&&it.every(r=>Array.isArray(r)&&typeof r[0]==='string'&&r[2]>0)){LIB={t:d.t||'',items:it};render()}}catch(_){}},()=>{});
  db.doc('config/planes').onSnapshot(()=>setTimeout(render,50),()=>{});
}catch(_){}})();
})();
</script>
<script>
/* ================== ACCESORIOS POR CATEGORÍA ================== */
(function(){
/* precios falabella.com al 11/11/2026 (normal, oferta, CMR); se actualizan cada día a las 9:00 desde config/accesorios */
let ACC=[
 {id:'cargador20',n:'Cargador USB-C 20W',k:'charger',cats:['tel'],no:22990,of:20990,cm:19990,u:'https://www.falabella.com/falabella-cl/product/14783871/Adaptador-Cargador-iPhone-USB-C-20W-Apple/14783871'},
 {id:'earpodsl',n:'EarPods Lightning',k:'earpods',cats:['tel'],no:24990,of:20990,cm:19990,u:'https://www.falabella.com/falabella-cl/product/5341682/Audifonos-EarPods-Conector-Lightning-Apple/5341682'},
 {id:'earpodsc',n:'EarPods USB-C',k:'earpods',cats:['tel','comp','tab'],no:24990,of:20990,cm:19990,u:'https://www.falabella.com/falabella-cl/product/16996583/Audífonos-EarPods-Conector-Tipo-C-Apple/16996583'},
 {id:'magicmouse',n:'Magic Mouse negro',k:'mouse',cats:['comp'],no:119990,of:115990,cm:111990,u:'https://www.falabella.com/falabella-cl/product/16033644/magic-mouse-inalambrico-para-macbook-apple/16104846'},
 {id:'multipuerto',n:'Adaptador multipuerto USB-C a AV digital',k:'adapter',cats:['comp'],no:89990,of:79990,cm:78990,u:'https://www.falabella.com/falabella-cl/product/4510694/Adaptador-Multipuerto-De-Usb-C-A-Av-Digital-Apple/4510694'},
 {id:'pencilc',n:'Apple Pencil (USB-C)',k:'pencil',cats:['tab'],no:119990,of:99990,cm:0,u:'https://www.falabella.com/falabella-cl/product/16973075/Pencil-Usb-C-Apple/16973075'},
 {id:'pencil2',n:'Apple Pencil (2.ª generación)',k:'pencil',cats:['tab'],no:179990,of:159990,cm:154990,u:'https://www.falabella.com/falabella-cl/product/6885805/Pencil-2ª-Generacion-Apple/6885805'},
 {id:'pencilpro',n:'Apple Pencil Pro',k:'pencil',cats:['tab'],no:169990,of:159990,cm:154990,u:'https://www.falabella.com/falabella-cl/product/17155507/Mouse-Pencil-Pro-Ame-Apple/17155507'},
 {id:'airpods5',n:'AirPods 5 · carga normal',k:'airpods',cats:['tel','comp','tab','wear'],no:159990,of:159990,cm:0,u:'https://www.falabella.com/falabella-cl/product/17776917/apple-airpods-5/17776917'},
 {id:'airpods5w',n:'AirPods 5 · carga inalámbrica',k:'airpods',cats:['tel','comp','tab','wear'],no:179990,of:179990,cm:0,u:'https://www.falabella.com/falabella-cl/product/17776916/AirPods-5-con-Estuche-de-Carga-Inalambrica/17776916'},
 {id:'airpodspro3',n:'AirPods Pro 3',k:'airpods',cats:['tel','comp','tab','wear'],no:329990,of:289990,cm:0,u:'https://www.falabella.com/falabella-cl/product/17564271/Apple-Airpods-Pro-3-Ame/17564271'}
];
let ACC_T='2026-11-11';
const ORD={tel:['cargador20','earpodsl','earpodsc','airpods5','airpods5w','airpodspro3'],comp:['earpodsc','magicmouse','multipuerto','airpods5','airpods5w','airpodspro3'],tab:['earpodsc','airpods5','airpods5w','airpodspro3','pencilc','pencil2','pencilpro'],wear:['airpods5','airpods5w','airpodspro3']};
const MAX=3;
const IC={charger:'<rect x="11" y="10" width="18" height="20" rx="4"/><path d="M17 10V5m6 5V5M20 30v5"/>',
 earpods:'<path d="M14 8a4 4 0 0 1 4 4v3a3 3 0 0 1-3 3h-1v14M26 8a4 4 0 0 0-4 4v3a3 3 0 0 0 3 3h1v14"/><path d="M14 32c0 3 3 4 6 4s6-1 6-4"/>',
 airpods:'<rect x="9" y="17" width="22" height="17" rx="6"/><path d="M9 23h22"/><path d="M15 6a3 3 0 0 1 3 3v5M25 6a3 3 0 0 0-3 3v5"/>',
 mouse:'<rect x="12" y="5" width="16" height="30" rx="8"/><path d="M20 10v5"/>',
 adapter:'<rect x="8" y="14" width="24" height="14" rx="3"/><path d="M14 21h4m4 0h4M32 21h4M4 21h4"/>',
 pencil:'<path d="M28 6l6 6-19 19-8 2 2-8L28 6Z"/><path d="M25 9l6 6"/>'};
S.acc=S.acc||{};S.accPt='int';S.accGrp=S.grp;
const price=a=>S.accPt==='cmr'&&a.cm>0?a.cm:(a.of>0?a.of:a.no);
const list=()=>(ORD[S.grp]||[]).map(id=>ACC.find(a=>a.id===id)).filter(Boolean);
window.accTotal=()=>{if(!ORD[S.grp])return 0;return list().filter(a=>S.acc[a.id]).reduce((s,a)=>s+price(a),0)};
window.accLabel=()=>{const n=list().filter(a=>S.acc[a.id]);return n.length?` + ${n.length} accesorio${n.length>1?'s':''} ${clp(accTotal())}`:''};
const dd=t=>{const d=String(t||'').slice(0,10).split('-');return d.length===3?d[2]+'/'+d[1]:''};
function renderAcc(){const box=$('accBox');if(!box)return;if(S.accGrp!==S.grp){S.acc={};S.accGrp=S.grp}
  const L=list();box.hidden=!L.length;if(!L.length)return;const sel=L.filter(a=>S.acc[a.id]);const full=sel.length>=MAX;
  document.querySelectorAll('[data-accp]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.accp===S.accPt)));
  $('accInfo').textContent=`Agrega hasta ${MAX} al cálculo · precios falabella.com al ${dd(ACC_T)}`;
  $('accRail').innerHTML=L.map(a=>{const on=!!S.acc[a.id];const has=price(a)>0;
    return `<div class="ac" role="listitem" aria-current="${on}"><svg viewBox="0 0 40 40" aria-hidden="true">${IC[a.k]||IC.charger}</svg><b>${esc(a.n)}</b>
      <div class="pr">${has?`${a.no>a.of&&a.of?`<span>Normal <s>${clp(a.no)}</s></span>`:''}<span>Oferta <span class="of">${clp(a.of||a.no)}</span></span>${a.cm>0?`<span>CMR <span class="cm">${clp(a.cm)}</span></span>`:''}`:'<span>Precio en actualización (9:00)</span>'}</div>
      <button type="button" class="add" data-acc="${a.id}" aria-pressed="${on}" ${!has||(!on&&full)?'disabled':''}>${on?'Agregado ✓':'Agregar'}</button></div>`}).join('');
  $('accSum').innerHTML=sel.length?`Accesorios: ${sel.map(a=>esc(a.n)+' '+clp(price(a))).join(' · ')} → <b>${clp(accTotal())}</b> se suman al cálculo de cuotas.`:'';}
window.renderAcc=renderAcc;
const _rs=renderSide;renderSide=function(){_rs();renderAcc()};
const _ra=resetAll;resetAll=function(){S.acc={};S.accPt='int';_ra()};
document.addEventListener('click',e=>{const t=e.target.closest('button');if(!t)return;
  if(t.dataset.acc){const id=t.dataset.acc;if(S.acc[id])delete S.acc[id];else S.acc[id]=true;renderAcc();renderCards();renderNeed();renderTable();return}
  if(t.dataset.accp){S.accPt=t.dataset.accp;renderAcc();renderCards();renderNeed();renderTable();return}
  if(t.dataset.accnav){const r=$('accRail');r.scrollBy({left:(+t.dataset.accnav)*230,behavior:'smooth'})}});
renderAcc();
(async()=>{try{if(!window.claude||!claude.use)return;const db=await claude.use('db');if(!db)return;
  db.doc('config/accesorios').onSnapshot(s=>{try{if(!s.exists)return;const d=s.data();const it=typeof d.items==='string'?JSON.parse(d.items):d.items;
    if(!Array.isArray(it)||it.length<5)return;let n=0;for(const r of it){if(!Array.isArray(r))continue;const a=ACC.find(x=>x.id===r[0]);if(!a)continue;const no=+r[2]||0,of=+r[3]||0,cm=+r[4]||0;if(!(of>0||no>0))continue;a.no=no;a.of=of;a.cm=cm>0&&cm<(of||no)?cm:0;if(r[5])a.u=r[5];n++}
    if(n>=5){ACC_T=d.t||ACC_T;renderAcc();renderCards();renderNeed();renderTable()}}catch(_){}},()=>{});
}catch(_){}})();
})();
</script>
<script>
/* ================== COMPRA PROTEGIDA ================== */
(function(){
const ICO='<svg class="bigico" viewBox="0 0 64 64" aria-hidden="true"><defs><linearGradient id="gcp" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#6be04f"/><stop offset="1" stop-color="#22a82a"/></linearGradient></defs><circle cx="32" cy="32" r="31" fill="url(#gcp)"/><circle cx="32" cy="32" r="30.5" fill="none" stroke="rgba(255,255,255,.35)" stroke-width="1"/><g fill="none" stroke="#fff" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 33a19 19 0 0 1 38 0z"/><path d="M24.5 33c0-9 3.4-14.5 7.5-16.5 4.1 2 7.5 7.5 7.5 16.5"/><path d="M32 16v-2"/><path d="M32 33v13a3.5 3.5 0 0 1-7 0"/></g></svg>';
const PLANS=[{n:'Plan 1',uf:0.14,cov:50,code:'2014972205002',ref:5500},{n:'Plan 2',uf:0.21,cov:100,code:'2014972233005',ref:8200}];
const CP={on:false,amt:0,man:false};$('cpPanel').removeAttribute('data-calc');
const uf=()=>{try{const u=Number(CFG.uf)||UF_DEF;return u>1000?u:39000}catch(_){return 39000}};
const r100=v=>Math.round(v/100)*100,r1000=v=>Math.round(v/1000)*1000;
function ean(code){const L=['0001101','0011001','0010011','0111101','0100011','0110001','0101111','0111011','0110111','0001011'];
  const G=L.map(p=>p.split('').map(b=>b==='0'?'1':'0').reverse().join(''));const R=L.map(p=>p.split('').map(b=>b==='0'?'1':'0').join(''));
  const PAR=['LLLLLL','LLGLGG','LLGGLG','LLGGGL','LGLLGG','LGGLLG','LGGGLL','LGLGLG','LGLGGL','LGGLGL'];const d=code.split('').map(Number);
  let bits='101';for(let i=1;i<=6;i++)bits+=(PAR[d[0]][i-1]==='L'?L:G)[d[i]];bits+='01010';for(let i=7;i<=12;i++)bits+=R[d[i]];bits+='101';
  const w=2,hgt=56;let x=12,rects='';for(const b of bits){if(b==='1')rects+=`<rect x="${x}" y="0" width="${w}" height="${hgt}"/>`;x+=w}
  return `<svg viewBox="0 0 ${x+12} ${hgt+16}" width="${(x+12)}" height="${hgt+16}" role="img" aria-label="Código ${code}"><g fill="#000">${rects}</g><text x="${(x+12)/2}" y="${hgt+14}" font-size="13" text-anchor="middle" font-family="monospace" fill="#000">${code.replace(/^(\d)(\d{6})(\d{6})$/,'$1 $2 $3')}</text></svg>`}
function baseAmt(){try{const p=(S.price||0)+(typeof window.accTotal==='function'?accTotal():0);return p}catch(_){return 0}}
function render(){if(!CP.on)return;const U=uf();
  document.querySelectorAll('.cpUfMin').forEach(e=>e.textContent='≈ '+clp(r1000(0.6*U)));
  if(!CP.man)CP.amt=baseAmt();const a=CP.amt;const inp=$('cpAmt');if(document.activeElement!==inp)inp.value=a?'$'+a.toLocaleString('es-CL'):'';
  const min=0.6*U;let rec=-1,msg='';
  if(a){if(a<min){msg=`<span class="warn">La compra debe ser de al menos UF 0,6 (≈ ${clp(r1000(min))}).</span>`}
    else if(a<=50*U){rec=0;msg='El <b>Plan 1</b> cubre el total de esta compra.'}
    else{rec=1;msg=a<=100*U?'Para cubrir el total de esta compra te conviene el <b>Plan 2</b>.':`El <b>Plan 2</b> cubre hasta ${clp(r1000(100*U))} de esta compra.`}}
  $('cpMsg').innerHTML=msg;
  $('cpPlans').innerHTML=PLANS.map((p,i)=>{const m=r100(p.uf*U);return `<div class="cpp${i===rec?' best':''}">${i===rec?'<span class="tag">Recomendado para esta compra</span>':''}<h4>${p.n}</h4>
    <div class="pr">${clp(m)} <small>al mes</small></div><div class="uf">UF ${String(p.uf).replace('.',',')} mensual</div>
    <ul><li>Robo + daño accidental hasta <b>${clp(r1000(p.cov*U))}</b> al año (UF ${p.cov})</li><li>Protección por 180 días desde la compra</li></ul>
    <details><summary>Código para caja</summary><div class="bc">${ean(p.code)}</div></details></div>`}).join('')}
function view(){const on=CP.on;$('cpPanel').hidden=!on;if(on){document.querySelectorAll('[data-calc]').forEach(e=>e.hidden=true);$('brands').hidden=true;$('models').hidden=true;const xp=$('xPanel');if(xp)xp.hidden=true;
  document.querySelectorAll('.cat[data-grp]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.grp==='cp')));render()}}
const _rc=renderCats;renderCats=function(){_rc();$('cats').insertAdjacentHTML('beforeend',`<button class="cat" type="button" data-grp="cp" aria-pressed="${CP.on}">${ICO}<span>Compra Protegida</span></button>`);if(CP.on)view()};
const _ra=resetAll;resetAll=function(){CP.on=false;CP.man=false;$('cpPanel').hidden=true;_ra()};
window.addEventListener('click',e=>{const c=e.target.closest&&e.target.closest('.cat[data-grp]');if(!c)return;
  if(c.dataset.grp==='cp'){e.stopPropagation();e.preventDefault();CP.on=true;CP.man=false;try{if(window.__X)window.__X().on=false}catch(_){}view();return}
  if(CP.on){CP.on=false;$('cpPanel').hidden=true;document.querySelectorAll('[data-calc]').forEach(x=>x.hidden=false);$('brands').hidden=false;$('models').hidden=false}},true);
$('cpAmt').addEventListener('input',e=>{const v=dg(e.target.value);e.target.value=v?'$'+v.toLocaleString('es-CL'):'';CP.amt=v;CP.man=true;render()});
renderCats();
})();
</script>
<script>
/* ================== v6: tiendas, estadísticas, panel de impacto, cotizador, beneficios ================== */
(function(){
const LSK='ffa_';const ls={get:k=>{try{return localStorage.getItem(LSK+k)}catch(_){return null}},set:(k,v)=>{try{localStorage.setItem(LSK+k,v)}catch(_){}}};
/* ---------- Tiendas Falabella (ubicación aproximada por centro comercial / ciudad) ---------- */
const STORES=[
['arica','Arica · Mall Plaza Arica','Arica y Parinacota',-18.4783,-70.3126],
['iquique','Iquique · Mall Plaza Iquique','Tarapacá',-20.2443,-70.1416],
['calama','Calama · Mall Plaza Calama','Antofagasta',-22.4561,-68.9293],
['antofagasta','Antofagasta · Mall Plaza Antofagasta','Antofagasta',-23.6509,-70.3975],
['copiapo','Copiapó · Mall Plaza Copiapó','Atacama',-27.3668,-70.3314],
['laserena','La Serena · Mall Plaza La Serena','Coquimbo',-29.9045,-71.2489],
['vina','Viña del Mar · Marina Arauco','Valparaíso',-33.0094,-71.5485],
['vinacentro','Viña del Mar · Centro','Valparaíso',-33.0245,-71.5518],
['costanera','Santiago · Costanera Center','Metropolitana',-33.4175,-70.6064],
['parquearauco','Santiago · Parque Arauco','Metropolitana',-33.4020,-70.5780],
['altolascondes','Santiago · Alto Las Condes','Metropolitana',-33.3907,-70.5465],
['losdominicos','Santiago · Mall Plaza Los Domínicos','Metropolitana',-33.4106,-70.5370],
['egana','Santiago · Mall Plaza Egaña','Metropolitana',-33.4537,-70.5698],
['vespucio','Santiago · Mall Plaza Vespucio','Metropolitana',-33.5206,-70.5976],
['florida','Santiago · Florida Center','Metropolitana',-33.5143,-70.6050],
['tobalaba','Santiago · Mall Plaza Tobalaba','Metropolitana',-33.5703,-70.5562],
['puentealto','Santiago · Puente Alto','Metropolitana',-33.6103,-70.5751],
['plazasur','Santiago · Mall Plaza Sur','Metropolitana',-33.6230,-70.7110],
['plazaoeste','Santiago · Mall Plaza Oeste','Metropolitana',-33.5163,-70.7171],
['maipu','Santiago · Arauco Maipú','Metropolitana',-33.4825,-70.7522],
['alameda','Santiago · Mall Plaza Alameda','Metropolitana',-33.4537,-70.6822],
['ahumada','Santiago · Centro (Ahumada)','Metropolitana',-33.4387,-70.6505],
['plazanorte','Santiago · Mall Plaza Norte','Metropolitana',-33.3654,-70.6772],
['quilicura','Santiago · Arauco Quilicura','Metropolitana',-33.3554,-70.7286],
['rancagua','Rancagua','O\'Higgins',-34.1745,-70.7386],
['curico','Curicó','Maule',-34.9828,-71.2394],
['talca','Talca · Mall Plaza Maule','Maule',-35.4316,-71.6345],
['linares','Linares','Maule',-35.8467,-71.5931],
['chillan','Chillán · Arauco Chillán','Ñuble',-36.6097,-72.1028],
['concepcion','Concepción · Centro','Biobío',-36.8270,-73.0498],
['trebol','Concepción · Mall Plaza Trébol','Biobío',-36.7920,-73.0634],
['losangeles','Los Ángeles · Mall Plaza Los Ángeles','Biobío',-37.4691,-72.3540],
['angol','Angol','La Araucanía',-37.7956,-72.7164],
['temuco','Temuco','La Araucanía',-38.7369,-72.5990],
['valdivia','Valdivia · Mall Plaza de los Ríos','Los Ríos',-39.8159,-73.2421],
['osorno','Osorno','Los Lagos',-40.5737,-73.1360],
['puertomontt','Puerto Montt · Paseo Costanera','Los Lagos',-41.4717,-72.9396],
['coyhaique','Coyhaique','Aysén',-45.5712,-72.0685],
['puntaarenas','Punta Arenas','Magallanes',-53.1452,-70.8913]];
window.FF_STORES=STORES;
const stById=id=>STORES.find(s=>s[0]===id);
const dist=(a,b,c,d)=>{const r=Math.PI/180,x=(d-b)*r*Math.cos((a+c)/2*r),y=(c-a)*r;return Math.sqrt(x*x+y*y)*6371};
let STORE=ls.get('store')||'';
function nearest(lat,lng){let b=null,bd=1e9;for(const s of STORES){const d=dist(lat,lng,s[3],s[4]);if(d<bd){bd=d;b=s}}return b}
function setStore(id,auto){STORE=id;ls.set('store',id);if(auto)ls.set('store_auto','1');paintStore();STAT.touch()}
function paintStore(){const b=$('storeB');if(!b)return;const s=stById(STORE);b.innerHTML=`<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/></svg>${s?esc(s[1].split(' · ')[0]+(s[1].includes(' · ')?' · '+s[1].split(' · ')[1]:'')):'Elegir tienda'}`}
function geo(){if(STORE||!navigator.geolocation)return;try{navigator.geolocation.getCurrentPosition(p=>{const s=nearest(p.coords.latitude,p.coords.longitude);if(s&&!STORE)setStore(s[0],true)},()=>{},{timeout:9000,maximumAge:36e5})}catch(_){}}
/* ---------- Registro de uso (un documento por equipo y día) ---------- */
const today=()=>{const d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')};
let DEV=ls.get('dev');if(!DEV){DEV=Math.random().toString(36).slice(2,10)+Date.now().toString(36).slice(-4);ls.set('dev',DEV)}
const KEYS=['open','int','tel','comp','tab','wear','aud','exc','cp','q','excq','cpq','mail','pdf'];
const STAT={d:today(),c:{},seen:new Set(),t:null,loaded:false,
  zero(){this.c={};KEYS.forEach(k=>this.c[k]=0)},
  add(k,n=1){if(this.d!==today()){this.d=today();this.zero();this.seen.clear()}this.c[k]=(this.c[k]||0)+n;this.touch()},
  once(k,key){const id=k+'|'+key;if(this.seen.has(id))return;this.seen.add(id);this.add(k)},
  touch(){clearTimeout(this.t);this.t=setTimeout(()=>this.save(),4000)},
  async save(){if(!DB||!this.loaded)return;const s=stById(STORE);const doc={d:this.d,dev:DEV,store:STORE||'',v:6,u:new Date().toISOString()};KEYS.forEach(k=>doc[k]=this.c[k]||0);if(s){doc.lat=s[3];doc.lng=s[4]}
    try{await DB.collection('stats').doc('a_'+this.d+'_'+DEV).set(doc)}catch(_){}}};
STAT.zero();window.STAT=STAT;
(async function boot(){for(let i=0;i<60&&!DB;i++)await new Promise(r=>setTimeout(r,250));if(!DB){STAT.loaded=false;return}
  try{const s=await DB.collection('stats').doc('a_'+STAT.d+'_'+DEV).get();if(s.exists){const d=s.data();KEYS.forEach(k=>STAT.c[k]=(Number(d[k])||0)+(STAT.c[k]||0))}}catch(_){}
  STAT.loaded=true;STAT.touch();
  try{DB.doc('config/apple_precios').onSnapshot(s=>{try{if(!s.exists)return;const d=s.data();const it=typeof d.items==='string'?JSON.parse(d.items):d.items;
    if(Array.isArray(it)&&it.length>=20&&it.every(r=>Array.isArray(r)&&typeof r[0]==='string'&&r[2]>0)){window.APR={t:d.t||'',items:it};if(S.autoP)applyAuto(null);renderSide();renderCards();renderNeed();renderTable()}}catch(_){}},()=>{})}catch(_){}
  for(let i=0;i<60&&!CAN;i++)await new Promise(r=>setTimeout(r,250));if(CAN)$('dashB').hidden=false;})();
STAT.add('open');
document.addEventListener('click',e=>{const c=e.target.closest('.cat[data-grp]');if(c){const g=c.dataset.grp;if(KEYS.includes(g))STAT.add(g)}if(e.target.closest('button,a,input,select,label'))STAT.add('int')},true);
const _tq=window.trackQuote;
document.getElementById('inPrice').addEventListener('input',()=>{clearTimeout(window.__qT);window.__qT=setTimeout(()=>{if(S.price)STAT.once('q',mkey()+'|'+S.price)},4000)});
document.addEventListener('click',e=>{const b=e.target.closest('[data-cap],[data-mi],[data-n]');if(b)setTimeout(()=>{if(S.price)STAT.once('q',mkey()+'|'+S.price)},4000)});
/* Compra Protegida cotizada */
const cpObs=new MutationObserver(()=>{const p=$('cpPanel');if(p&&!p.hidden){const a=$('cpAmt');const v=a?dg(a.value):0;if(v)STAT.once('cpq',String(v))}});
cpObs.observe(document.body,{subtree:true,attributes:true,attributeFilter:['hidden']});
document.addEventListener('input',e=>{if(e.target&&e.target.id==='cpAmt'){clearTimeout(window.__cpT);window.__cpT=setTimeout(()=>{const v=dg(e.target.value);if(v)STAT.once('cpq',String(v))},3000)}});

/* ---------- Barra superior: tienda + panel ---------- */
const top=document.querySelector('header.top .wrap');
top.insertAdjacentHTML('beforeend',`<button class="storeb" type="button" id="storeB" title="Tienda de este equipo"></button><button class="icon-btn" type="button" id="dashB" hidden><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>Impacto</button>`);
paintStore();geo();
document.body.insertAdjacentHTML('beforeend',`<div class="ovl" id="stOvl" hidden><div class="mdl"><button class="x" type="button" data-close="stOvl" aria-label="Cerrar">×</button><h2>¿En qué tienda está este equipo?</h2><p class="note" style="margin:0;color:var(--ink-2)">Se usa para medir el impacto de la calculadora por tienda. Se guarda en este equipo.</p><label>Tienda<select id="stSel">${['Arica y Parinacota','Tarapacá','Antofagasta','Atacama','Coquimbo','Valparaíso','Metropolitana',"O'Higgins",'Maule','Ñuble','Biobío','La Araucanía','Los Ríos','Los Lagos','Aysén','Magallanes'].map(r=>`<optgroup label="${r}">${STORES.filter(s=>s[2]===r).map(s=>`<option value="${s[0]}">${esc(s[1])}</option>`).join('')}</optgroup>`).join('')}</select></label><div class="qact"><button class="pri" type="button" id="stOk">Guardar</button><button type="button" id="stGeo">Usar mi ubicación</button></div><p class="note" id="stMsg"></p></div></div>`);
$('storeB').addEventListener('click',()=>{$('stSel').value=STORE||'costanera';$('stOvl').hidden=false});
$('stOk').addEventListener('click',()=>{setStore($('stSel').value);$('stOvl').hidden=true});
$('stGeo').addEventListener('click',()=>{$('stMsg').textContent='Buscando ubicación…';try{navigator.geolocation.getCurrentPosition(p=>{const s=nearest(p.coords.latitude,p.coords.longitude);$('stSel').value=s[0];$('stMsg').textContent='Tienda más cercana: '+s[1]},()=>{$('stMsg').textContent='Este navegador no permitió la ubicación. Elige la tienda en la lista.'},{timeout:9000})}catch(_){$('stMsg').textContent='Ubicación no disponible. Elige la tienda en la lista.'}});
document.addEventListener('click',e=>{const b=e.target.closest('[data-close]');if(b)$(b.dataset.close).hidden=true});

/* ---------- Partes y piezas: mostrar / ocultar ---------- */
const pf=$('partsFolder'),pi=$('inParts');const pv=ls.get('parts');if(pv==='0'){pi.checked=false;pf.hidden=true}
pi.addEventListener('change',()=>{pf.hidden=!pi.checked;ls.set('parts',pi.checked?'1':'0')});

/* ---------- Beneficios para el cliente ---------- */
function topPart(){const c=cat(),m=model();if(!m)return null;let rows=[];
  if(c.id==='iphone'&&typeof IP_PARTS!=='undefined'&&IP_PARTS[m.name])rows=IP_PARTS[m.name].map(r=>({l:r[0],v:r[3]||r[2]}));
  else if(c.parts&&m.costs)rows=c.parts.map((p,i)=>({l:p[0],v:m.costs[i]||0}));
  rows=rows.filter(r=>r.v>0&&!/otros|reemplazo/i.test(r.l));if(!rows.length)return null;return rows.find(r=>/pantalla/i.test(r.l))||rows.reduce((a,b)=>b.v>a.v?b:a)}
const BEN={
 iphone:{name:'tu iPhone',ge:['Tu iPhone es tu cámara, tu billetera y tu agenda: si falla después del primer año, lo reparamos sin costo y con repuestos nuevos.','Si vuelve a fallar después de la segunda reparación, te devolvemos lo que pagaste en Gift Card.','Incluye daños por variaciones de voltaje al cargarlo.','Si lo regalas o lo vendes, la garantía sigue vigente.'],
  p1:['Si te lo roban con violencia o por la fuerza, no pierdes tu inversión.','Cubre caídas, golpes y líquidos: los accidentes más comunes del día a día.','Recuperas hasta el 70 % de lo que invertiste.','Una cuota pequeña al mes te evita un gasto grande e inesperado.'],
  p2:['Una caída o un vaso de agua no tienen por qué arruinar tu día.','La garantía de Apple no cubre accidentes; este seguro sí.','Recuperas hasta el 70 % de tu inversión.']},
 mac:{name:'tu Mac',ge:['Tu Mac es tu herramienta de trabajo y estudio: protégelo más allá del primer año.','Fallas de placa, teclado o pantalla fuera de garantía están entre las reparaciones más caras.','Repuestos nuevos en un servicio técnico seleccionado por Falabella y reparación en 10 días hábiles.','Incluye daños por variaciones de voltaje.'],
  p2:['Un café derramado sobre el teclado o una caída de la mochila pasan más de lo que crees.','La garantía de Apple no cubre accidentes; este seguro sí.','Recuperas hasta el 70 % de tu inversión.']},
 ipad:{name:'tu iPad',ge:['Tu iPad acompaña estudio, trabajo y entretención: protégelo por más tiempo.','Si falla fuera de la garantía de Apple, lo reparamos con repuestos nuevos.','Si no se puede reparar, te devolvemos lo pagado en Gift Card.','Incluye daños por variaciones de voltaje.'],
  p2:['Las pantallas grandes sufren con caídas y golpes: aquí estás cubierto.','Ideal si lo usan niños o lo llevas a todas partes.','Recuperas hasta el 70 % de tu inversión.']},
 watch:{name:'tu Watch',ge:['Tu Watch cuida tu salud todos los días: que una falla no te deje sin él.','Reparación con repuestos nuevos después de la garantía de Apple.','Si vuelve a fallar tras la segunda reparación, te devolvemos lo pagado en Gift Card.'],
  p2:['Entrenas, viajas y lo usas todo el día: los golpes contra superficies duras son frecuentes.','La garantía de Apple no cubre accidentes; este seguro sí.','Recuperas hasta el 70 % de tu inversión.']},
 airpods:{name:'tus AirPods',ge:['Los usas a diario: si fallan después del primer año, están cubiertos.','Reparación o reemplazo según el diagnóstico del servicio técnico.','La garantía sigue vigente si los regalas.'],p2:[]}};
const BT={ge:['ge','Garantía extendida','Recupera el 100 % de la inversión'],p1:['p1','Seguro Connect Daño y Robo','Recupera el 70 % de la inversión'],p2:['p2','Seguro Connect Daño','Recupera el 70 % de la inversión']};
window.renderBen=function(){const el=$('pBen');if(!el)return;const c=cat(),m=model(),b=BEN[c.id];if(!b){el.innerHTML='';return}const av=avail();const tp=topPart();
  const ord=['p1','p2','ge'].filter(k=>av.includes(k)&&(b[k]||[]).length);
  el.innerHTML=`<div class="ben"><h3 class="ben-h">Protege ${b.name} desde hoy</h3><p class="ben-sub">${tp?`Reparar la ${esc(tp.l.toLowerCase())} de un ${esc(m.name)} fuera de garantía cuesta referencialmente hasta <b>${clp(tp.v)}</b>. Con una protección pagas una fracción de eso.`:'Elige la protección que mejor se adapte a ti.'}</p>
   <div class="ben-g">${ord.map(k=>`<div class="ben-c ${k}"><h4>${BT[k][1]}</h4><span class="${k==='ge'?'rec100':'rec70'}">${BT[k][2]}</span><ul>${b[k].map(t=>`<li>${t}</li>`).join('')}</ul></div>`).join('')}</div></div>`};
const _rcs=renderCards;renderCards=function(){_rcs();if($('pBen')&&!$('pBen').hidden)renderBen()};

/* ---------- Cotizador por mail ---------- */
document.body.insertAdjacentHTML('beforeend',`<div class="ovl" id="qOvl" hidden><div class="mdl"><button class="x" type="button" data-close="qOvl" aria-label="Cerrar">×</button><h2>Cotización para el cliente</h2>
 <div class="row2"><label>Nombre del cliente<input id="qName" autocomplete="off" placeholder="Nombre"></label><label>Correo del cliente<input id="qMail" type="email" autocomplete="off" placeholder="cliente@correo.com"></label></div>
 <label>Atendido por (opcional)<input id="qSeller" autocomplete="off" placeholder="Nombre del asesor"></label>
 <div class="qprev" id="qPrev"></div>
 <p class="qsec">Escribe el correo</p>
 <label>Asunto<input id="qSubj" autocomplete="off"></label>
 <label>Mensaje<textarea id="qBody" class="qmsg" spellcheck="true"></textarea></label>
 <label class="sw" for="qAtt" style="font-size:14px;color:var(--ink-2)"><span>Adjuntar la cotización en PDF</span><input type="checkbox" id="qAtt" checked></label>
 <div class="qact"><button type="button" class="pri" id="qGo" hidden>Enviar ahora</button><a id="qSend" href="#" target="_blank" rel="noopener">Abrir en app de correo</a><button type="button" id="qPdf">Descargar PDF</button><button type="button" id="qCopy">Copiar texto</button><button type="button" id="qReset">Restablecer texto</button></div><p class="note" id="qMsg"></p></div></div>`);
const fdate=d=>d.toLocaleDateString('es-CL',{day:'2-digit',month:'2-digit',year:'numeric'}).replace(/-/g,'/');
function quoteData(){const rows=quoteRows();const by=k=>rows.find(r=>r.k===k);const ord=['p1','p2','ge','nor'].map(by).filter(Boolean);
  const NM={p1:'Seguro Connect Daño y Robo',p2:'Seguro Connect Daño',ge:'Garantía extendida '+YR(S.cov),nor:planOn()?'Equipo con plan (sin seguro)':'Garantía de fabricante (Apple, 12 meses)'};
  const acc=(typeof window.accLabel==='function'?accLabel():'').replace(/^ \+ /,'');const n=S.n;
  return {prod:mname(),price:S.price,ptype:S.autoP&&S.ptype==='cmr'?'precio CMR':'precio oferta',acc,total:bp()+(typeof window.accTotal==='function'?accTotal():0),nlab:n===1?'Contado':`${n} cuotas${S.si?' sin interés':''}`,
    opts:ord.map(r=>({k:r.k,name:NM[r.k],q:r.q,ctc:r.ctc,val:r.val})),date:new Date()}}
function quoteText(Q,name,seller){const L=[];L.push(`Hola${name?' '+name:''}:`,'',`Gracias por visitarnos en Falabella. Esta es tu cotización del ${fdate(Q.date)}:`,'',`Producto: ${Q.prod}`,`Precio: ${clp(Q.price)} (${Q.ptype})`);if(Q.acc)L.push(`Accesorios: ${Q.acc}`);L.push(`Financiamiento: ${Q.nlab} con tarjeta CMR`,'','Alternativas de protección:');
  Q.opts.forEach(o=>L.push(`• ${o.name}: ${Q.nlab==='Contado'?'total':Q.nlab.split(' ')[0]+' cuotas de'} ${clp(o.q)} · total ${clp(o.ctc)}${o.val?` (protección ${clp(o.val)})`:''}`));
  L.push('',`Cotización válida solo el ${fdate(Q.date)}.`,'','Términos y condiciones: los precios cotizados pueden cambiar sin previo aviso. Al dirigirte a la tienda puedes asesorarte con un asesor de ventas. Valores en cuotas referenciales, sujetos a la evaluación y condiciones de la tarjeta CMR.');if(seller)L.push('',`Te atendió: ${seller}`);L.push('Falabella');return L.join('\n')}
function quoteHTML(Q,name,seller){return `<h3>Cotización Falabella</h3><div><span class="vd">Válida solo el ${fdate(Q.date)}</span></div><p style="margin:10px 0 4px">${name?'Hola '+esc(name)+', g':'G'}racias por visitarnos. Esta es tu cotización:</p>
 <table><tr><th>Producto</th><th>Precio</th><th>Financiamiento</th></tr><tr><td>${esc(Q.prod)}${Q.acc?'<br><small>'+esc(Q.acc)+'</small>':''}</td><td>${clp(Q.price)}<br><small>${Q.ptype}</small></td><td>${Q.nlab}<br><small>tarjeta CMR</small></td></tr></table>
 <table><tr><th>Alternativa</th><th>${Q.nlab==='Contado'?'Total':'Cuota'}</th><th>Total</th></tr>${Q.opts.map((o,i)=>`<tr class="${i===0?'hl':''}"><td>${o.name}${o.val?`<br><small>protección ${clp(o.val)}</small>`:''}</td><td>${clp(o.q)}</td><td>${clp(o.ctc)}</td></tr>`).join('')}</table>
 <div class="tc"><b>Términos y condiciones:</b> los precios cotizados pueden cambiar sin previo aviso. Al dirigirte a la tienda puedes asesorarte con un asesor de ventas. Valores en cuotas referenciales, sujetos a la evaluación y condiciones de la tarjeta CMR. Cotización válida solo el día ${fdate(Q.date)}.${seller?'<br>Te atendió: '+esc(seller):''}</div>`}
function paintQ(){const Q=quoteData();const nm=$('qName').value.trim(),ml=$('qMail').value.trim(),sl=$('qSeller').value.trim();
  if(!Q.price){$('qPrev').innerHTML='<p>Escribe o elige el precio del producto para generar la cotización.</p>';return}
  $('qPrev').innerHTML=quoteHTML(Q,nm,sl);
  if(!QED.s)$('qSubj').value=`Tu cotización Falabella · ${Q.prod} · ${fdate(Q.date)}`;
  if(!QED.b)$('qBody').value=quoteText(Q,nm,sl);
  $('qSend').href=`mailto:${encodeURIComponent(ml)}?subject=${encodeURIComponent($('qSubj').value)}&body=${encodeURIComponent($('qBody').value)}`}
const QED={s:false,b:false};
$('qOpen').addEventListener('click',()=>{const s=ls.get('seller');if(s)$('qSeller').value=s;$('qMsg').textContent='';QED.s=false;QED.b=false;paintQ();$('qOvl').hidden=false;gmailCheck()});
$('qSubj').addEventListener('input',()=>{QED.s=true;paintQ()});$('qBody').addEventListener('input',()=>{QED.b=true;paintQ()});
$('qReset').addEventListener('click',()=>{QED.s=false;QED.b=false;paintQ();$('qMsg').textContent='Texto restablecido.'});
let MCP=null;async function gmailCheck(){try{if(MCP===null){MCP=window.claude&&claude.use?await claude.use('mcp'):false;MCP=MCP||false}$('qGo').hidden=!MCP}catch(_){MCP=false;$('qGo').hidden=true}}
const okMail=s=>/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(s);
const escH=s=>String(s).replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
$('qGo').addEventListener('click',async()=>{const to=$('qMail').value.trim();if(!okMail(to)){$('qMsg').textContent='Escribe un correo válido del cliente.';$('qMail').focus();return}
  const Q=quoteData();if(!Q.price){$('qMsg').textContent='Falta el precio del producto.';return}const btn=$('qGo');btn.disabled=true;$('qMsg').textContent='Enviando…';
  try{const body=$('qBody').value;const html='<div style="font-family:Helvetica,Arial,sans-serif;font-size:14px;color:#111">'+escH(body).split('\n').map(l=>l?'<p style="margin:0 0 6px">'+l+'</p>':'<br>').join('')+'</div>';
    const input={to:[to],subject:$('qSubj').value,body,htmlBody:html};
    if($('qAtt').checked){try{const doc=await makeQuotePdf(Q,$('qName').value.trim(),$('qSeller').value.trim());const b64=doc.output('datauristring').split(',')[1];input.attachments=[{content:b64,filename:'Cotizacion_Falabella_'+dstr(Q.date)+'.pdf',mimeType:'application/pdf'}]}catch(_){}}
    await MCP.callTool('Gmail','send_message',input,{cache:false});STAT.add('mail');$('qMsg').textContent='Correo enviado a '+to+' desde tu Gmail.'}
  catch(e){const c=e&&e.code;$('qMsg').textContent=c==='server_not_connected'||c==='server_not_found'?'Gmail no está conectado en esta cuenta: usa "Abrir en app de correo".':c==='needs_reauth'?'Vuelve a conectar Gmail en Claude y reintenta.':c==='not_granted'||c==='consent_required'?'No se dio permiso para enviar con Gmail.':'No se pudo enviar ('+(e&&e.message||'error')+'). Usa "Abrir en app de correo".'}
  finally{btn.disabled=false}});
['qName','qMail','qSeller'].forEach(id=>$(id).addEventListener('input',()=>{if(id==='qSeller')ls.set('seller',$(id).value);paintQ()}));
$('qSend').addEventListener('click',e=>{if(!S.price){e.preventDefault();return}STAT.add('mail');$('qMsg').textContent='Se abrió tu app de correo con la cotización lista para enviar.'});
$('qCopy').addEventListener('click',async()=>{try{await navigator.clipboard.writeText($('qBody').value);$('qMsg').textContent='Texto copiado.';STAT.add('mail')}catch(_){$('qMsg').textContent='No se pudo copiar en este navegador.'}});
function loadJS(src){return new Promise((ok,ko)=>{if(document.querySelector(`script[src="${src}"]`)){const t=setInterval(()=>{if(window.jspdf||window.Chart||window.XLSX){clearInterval(t);ok()}},100);setTimeout(()=>{clearInterval(t);ok()},4000);return}const s=document.createElement('script');s.src=src;s.onload=ok;s.onerror=ko;document.head.appendChild(s)})}
const JSPDF='https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js',AUTOT='https://cdn.jsdelivr.net/npm/jspdf-autotable@3.8.2/dist/jspdf.plugin.autotable.min.js',CHARTJS='https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.js',XLSXJS='https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js';
async function saveFile(name,blob){try{const d=window.claude&&claude.use?await claude.use('downloads'):null;if(d){await d.save({filename:name,data:blob});return true}}catch(e){if(e&&e.code==='declined')return false}
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove()},1500);return true}
const pdfNum=v=>'$'+Math.round(v||0).toLocaleString('es-CL');
async function makeQuotePdf(Q,nm,sl){await loadJS(JSPDF);await loadJS(AUTOT);const {jsPDF}=window.jspdf;const doc=new jsPDF({unit:'pt',format:'a4'});
    doc.setFillColor(0,0,0);doc.rect(0,0,595,80,'F');doc.setTextColor(255,255,255);doc.setFontSize(22);doc.text('Cotización Falabella',40,48);doc.setFontSize(10);doc.text('Válida solo el '+fdate(Q.date),40,66);
    doc.setTextColor(20,20,20);doc.setFontSize(12);doc.text(`${nm?'Hola '+nm+', g':'G'}racias por visitarnos. Esta es tu cotización:`,40,110);
    doc.autoTable({startY:124,head:[['Producto','Precio','Financiamiento']],body:[[Q.prod+(Q.acc?'\n'+Q.acc:''),pdfNum(Q.price)+'\n'+Q.ptype,Q.nlab+'\ntarjeta CMR']],theme:'grid',headStyles:{fillColor:[30,30,30]},styles:{fontSize:10}});
    doc.autoTable({startY:doc.lastAutoTable.finalY+14,head:[['Alternativa',Q.nlab==='Contado'?'Total':'Cuota','Total']],body:Q.opts.map(o=>[o.name+(o.val?'\nprotección '+pdfNum(o.val):''),pdfNum(o.q),pdfNum(o.ctc)]),theme:'grid',headStyles:{fillColor:[30,30,30]},styles:{fontSize:10},didParseCell:d=>{if(d.section==='body'&&d.row.index===0)d.cell.styles.fillColor=[231,246,234]}});
    doc.setFontSize(9);doc.setTextColor(90,90,90);doc.text(doc.splitTextToSize('Términos y condiciones: los precios cotizados pueden cambiar sin previo aviso. Al dirigirte a la tienda puedes asesorarte con un asesor de ventas. Valores en cuotas referenciales, sujetos a la evaluación y condiciones de la tarjeta CMR. Cotización válida solo el día '+fdate(Q.date)+'.'+(sl?' Te atendió: '+sl+'.':''),515),40,doc.lastAutoTable.finalY+24);
    return doc}
$('qPdf').addEventListener('click',async()=>{const Q=quoteData();if(!Q.price)return;$('qMsg').textContent='Generando PDF…';
  try{const doc=await makeQuotePdf(Q,$('qName').value.trim(),$('qSeller').value.trim());
    const ok=await saveFile(`Cotizacion_Falabella_${dstr(Q.date)}.pdf`,doc.output('blob'));if(ok){STAT.add('pdf');$('qMsg').textContent='PDF descargado: adjúntalo al correo del cliente.'}else $('qMsg').textContent='Descarga cancelada.'}catch(e){$('qMsg').textContent='No se pudo generar el PDF en este navegador.'}});

/* ---------- Panel de impacto ---------- */
