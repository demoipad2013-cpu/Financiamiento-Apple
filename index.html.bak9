", "c": [783491, 175525, 538344, 195137, 881550, 979610], "t": "Tecnología Ultra Retina Tandem OLED de doble capa. Chasis estructural ultra delgado con refuerzos de grafito."}, {"n": "iPad mini", "c": [342255, 116690, 293236, 97078, 440265, 489315], "t": "Pantalla completamente laminada de tamaño compacto. Arquitectura interna densa propensa a reemplazo completo de unidad."}], "Apple Watch": [{"n": "Apple Watch SE", "c": [175525, 77466, 146108, 97078, 224555], "t": "Caja trasera de material compuesto de nylon. Pantalla de vidrio Ion-X. Sellado básico contra agua."}, {"n": "Apple Watch S11", "c": [293236, 97078, 244167, 165720, 342255], "t": "Caja de aluminio o titanio ultra delgada. Cristal delantero de zafiro en versiones premium. Sensores de salud avanzados."}, {"n": "Apple Watch S12", "c": [312828, 97078, 263758, 185311, 361838], "t": "Evolución en delgadez estructural. Mayor integración de la antena en el chasis metálico. Sellado IP6X."}, {"n": "Apple Watch Ultra 3", "c": [489315, 116690, 391275, 244167, 587354], "t": "Caja de titanio aeroespacial de 49mm. Cristal de zafiro plano con borde protegido. Doble altavoz y sirena integrados."}, {"n": "Apple Watch Ultra 4", "c": [518748, 116690, 410867, 263758, 616791], "t": "Estructura reforzada de titanio con mayor resistencia a impactos submarinos. Sensores optimizados de buceo profundo."}], "AirPods": [{"n": "AirPods 4", "c": [87272, 97078, 48049, 0, 0, 146108], "t": "Diseño abierto. Baterías soldadas en microceldas no reparables externamente. Estuche con USB-C."}, {"n": "AirPods 5", "c": [97078, 106884, 48049, 0, 0, 165720], "t": "Evolución del modelo base con mejores sensores acústicos. Ensamblaje ultrasónico sellado de fábrica."}, {"n": "AirPods Pro 3", "c": [116690, 126496, 57854, 38243, 0, 244167], "t": "Diseño in-ear con almohadillas de silicona. Chip de audio avanzado y cancelación de ruido. Estuche MagSafe con bocina."}, {"n": "AirPods Max", "c": [0, 0, 97078, 77466, 244167, 391275], "t": "Diseño circumaural