<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="apple-mobile-web-app-capable" content="yes"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif}img{max-width:100%}[hidden]{display:none!important}</style></head><body>
<script>document.documentElement.setAttribute("data-theme","dark")</script>
<title>Calculadora Apple</title>
<meta name="claude:viewport-fit-sides" content="cover">
<style>
/* Layout: barra de vidrio con categorías (íconos), columna izquierda con la cotización y columna derecha con las 4 tarjetas en orden de venta + grilla de partes y piezas. */
:root{
  --bg:#f5f5f7; --surface:#ffffff; --surface-2:#ececf0; --ink:#1d1d1f; --ink-2:#424245; --ink-3:#6e6e73; --line:#d2d2d7;
  --blue:#0071e3; --link:#0066cc; --ge:#0a7a3e; --ge-soft:#e4f4ea; --ge-ink:#ffffff;
  --seg:#0058b8; --seg-soft:#e6f0fb; --dmg:#7a4dc4; --dmg-soft:#f0eafb; --warn:#b25000; --warn-soft:#fff1e3;
  --nav:rgba(255,255,255,.78); --shadow:0 4px 20px rgba(0,0,0,.06);
  --font:-apple-system,BlinkMacSystemFont,"SF Pro Text","Helvetica Neue",Helvetica,Arial,sans-serif;
  --font-d:-apple-system,BlinkMacSystemFont,"SF Pro Display","Helvetica Neue",Helvetica,Arial,sans-serif;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]):not([data-theme="sepia"]){
  --bg:#000000; --surface:#1c1c1e; --surface-2:#2c2c2e; --ink:#f5f5f7; --ink-2:#d2d2d7; --ink-3:#98989d; --line:#3a3a3c;
  --blue:#0a84ff; --link:#2997ff; --ge:#30d158; --ge-soft:#11331d; --ge-ink:#00210c;
  --seg:#64a8ff; --seg-soft:#132a45; --dmg:#bf9bff; --dmg-soft:#2a2040; --warn:#ffb340; --warn-soft:#3a2810;
  --nav:rgba(22,22,23,.8); --shadow:0 4px 20px rgba(0,0,0,.5); color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#000000; --surface:#1c1c1e; --surface-2:#2c2c2e; --ink:#f5f5f7; --ink-2:#d2d2d7; --ink-3:#98989d; --line:#3a3a3c;
  --blue:#0a84ff; --link:#2997ff; --ge:#30d158; --ge-soft:#11331d; --ge-ink:#00210c;
  --seg:#64a8ff; --seg-soft:#132a45; --dmg:#bf9bff; --dmg-soft:#2a2040; --warn:#ffb340; --warn-soft:#3a2810;
  --nav:rgba(22,22,23,.8); --shadow:0 4px 20px rgba(0,0,0,.5); color-scheme:dark}
*{box-sizing:border-box}
[hidden]{display:none!important}
body{background:var(--bg);color:var(--ink);font-family:var(--font);font-size:17px;line-height:1.47;letter-spacing:-.016em;-webkit-font-smoothing:antialiased}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:40;background:var(--bg)}
button,input,select,textarea{font:inherit;color:inherit;letter-spacing:inherit}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--blue);outline-offset:2px}
.wrap{max-width:1240px;margin:0 auto;padding-left:max(20px,env(safe-area-inset-left,0px));padding-right:max(20px,env(safe-area-inset-right,0px))}
.num{font-variant-numeric:tabular-nums}

/* barra */
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:30;background:var(--nav);backdrop-filter:saturate(180%) blur(20px);-webkit-backdrop-filter:saturate(180%) blur(20px);border-bottom:1px solid var(--line)}
.top .wrap{display:flex;align-items:center;gap:12px;min-height:52px}
.brand{font-family:var(--font-d);font-weight:600;font-size:19px;margin-right:auto;display:flex;align-items:center;gap:8px;background:none;border:0;padding:0}
.brand svg{width:22px;height:22px;color:var(--ge)}
.icon-btn{border:0;background:var(--surface-2);border-radius:980px;height:34px;padding:0 14px;font-size:13px;display:inline-flex;align-items:center;gap:6px}
.icon-btn svg{width:16px;height:16px}

/* héroe + categorías */
.hero{padding-block:34px 8px;text-align:center}
.hero h1{font-family:var(--font-d);font-size:clamp(34px,5.6vw,56px);line-height:1.06;font-weight:600;letter-spacing:-.02em;margin:0 0 8px;text-wrap:balance}
.hero p{margin:0 auto;max-width:620px;color:var(--ink-2);font-size:clamp(16px,2.2vw,20px);text-wrap:balance}
.cats{display:flex;justify-content:center;gap:clamp(6px,2vw,22px);flex-wrap:wrap;padding-block:26px 6px}
.cat{background:none;border:0;display:flex;flex-direction:column;align-items:center;gap:6px;padding:8px 10px;min-width:74px;color:var(--ink-2);border-radius:14px}
.cat svg{width:46px;height:46px;stroke:currentColor;fill:none;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;transition:transform .25s}
.cat span{font-size:13px;font-weight:500}
.cat:hover svg{transform:translateY(-2px)}
.cat[aria-pressed="true"]{color:var(--ink)}
.cat[aria-pressed="true"] span{border-bottom:2px solid var(--ink);padding-bottom:1px}
/* neón */
.hero h1{color:#39ff14;font-weight:400;-webkit-text-stroke:0;text-shadow:0 0 4px rgba(57,255,20,.6),0 0 14px rgba(57,255,20,.3)}
@media (prefers-color-scheme:light){.hero h1{color:#12c926;text-shadow:0 0 8px rgba(18,201,38,.3)}}
:root[data-theme="light"] .hero h1{color:#12c926;text-shadow:0 0 8px rgba(18,201,38,.3)}
:root[data-theme="sepia"]{
  --bg:#f3ead6; --surface:#fbf5e7; --surface-2:#eadfc5; --ink:#3a2e20; --ink-2:#5a4834; --ink-3:#7c6650; --line:#d9c7a4;
  --blue:#9a5b13; --link:#8a4f0f; --ge:#2f7a3a; --ge-soft:#e3ecd2; --ge-ink:#ffffff;
  --seg:#7a4f1c; --seg-soft:#f0e2c8; --dmg:#7b4a6e; --dmg-soft:#efdfe4; --warn:#a14a10; --warn-soft:#f8e3cc;
  --nav:rgba(243,234,214,.84); --shadow:0 4px 20px rgba(90,60,20,.10); color-scheme:light}
:root[data-theme="dark"] .hero h1{color:#39ff14;text-shadow:0 0 4px rgba(57,255,20,.6),0 0 14px rgba(57,255,20,.3)}
:root[data-theme="sepia"] .hero h1{color:#1f9d2e;text-shadow:0 0 6px rgba(31,157,46,.25)}
:root[data-theme="sepia"] img:not(.hlogo){filter:sepia(.25)}
.thm{display:inline-flex;gap:4px}
.thm button{border:0;background:var(--surface-2);border-radius:980px;width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;color:var(--ink-2);padding:0}
.thm button svg{width:17px;height:17px}
.thm button[aria-pressed="true"]{background:var(--ink);color:var(--bg)}
.hlogo{display:block;width:72px;height:72px;margin:0 auto 12px;border-radius:50%}
.cat[data-grp] svg{stroke:var(--neo);stroke-width:2;filter:drop-shadow(0 0 .6px #fff) drop-shadow(0 0 .6px #fff) drop-shadow(0 0 5px var(--neo)) drop-shadow(0 0 12px var(--neo))}
.cat[data-grp="tel"]{--neo:#ff8c1a}.cat[data-grp="comp"]{--neo:#a43bff}.cat[data-grp="tab"]{--neo:#ffe600}
.cat[data-grp="wear"]{--neo:#00e5ff}.cat[data-grp="aud"]{--neo:#d65cff}.cat[data-grp="vg"]{--neo:#ff2a3c}
.cat[data-grp][aria-pressed="true"] svg{filter:drop-shadow(0 0 .8px #fff) drop-shadow(0 0 .8px #fff) drop-shadow(0 0 8px var(--neo)) drop-shadow(0 0 18px var(--neo))}

.models{display:flex;gap:8px;overflow-x:auto;padding:10px 2px 16px;scrollbar-width:thin;justify-content:safe center}
.mchip{flex:none;border:1px solid var(--line);background:var(--surface);border-radius:980px;padding:7px 15px;font-size:14px;white-space:nowrap}
.mchip[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}

/* cuerpo */
.main{display:grid;grid-template-columns:minmax(0,380px) minmax(0,1fr);gap:24px;align-items:start;padding-block:10px 80px}
.side{position:sticky;top:calc(64px + env(safe-area-inset-top,0px));display:flex;flex-direction:column;gap:14px}
.panel{background:var(--surface);border-radius:20px;padding:20px;display:flex;flex-direction:column;gap:14px;min-width:0}
.panel h2{margin:0;font-family:var(--font-d);font-size:22px;font-weight:600;line-height:1.2}
.panel h2 small{display:block;font-size:13px;font-weight:400;color:var(--ink-3);margin-top:2px}
.lab{font-size:12px;color:var(--ink-3);font-weight:500;text-transform:uppercase;letter-spacing:.06em}
.price{display:flex;align-items:baseline;gap:4px;border-bottom:2px solid var(--line);padding-bottom:4px}
.price:focus-within{border-color:var(--blue)}
.price b{font-family:var(--font-d);font-size:34px;font-weight:600;color:var(--ink-3)}
.price input{border:0;background:none;font-family:var(--font-d);font-size:34px;font-weight:600;width:100%;min-width:0;outline:none;font-variant-numeric:tabular-nums}
.eg{font-size:12px;color:var(--warn);background:var(--warn-soft);border-radius:980px;padding:2px 9px;align-self:flex-start}
.nq{display:flex;align-items:baseline;justify-content:space-between}
.nq output{font-family:var(--font-d);font-size:28px;font-weight:600;font-variant-numeric:tabular-nums}
input[type=range]{width:100%;accent-color:var(--blue)}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chip{border:1px solid var(--line);background:var(--surface);border-radius:980px;padding:5px 12px;font-size:14px;font-variant-numeric:tabular-nums}
.chip[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.segc{display:grid;grid-template-columns:1fr 1fr;background:var(--surface-2);border-radius:12px;padding:3px}
.segc button{border:0;background:none;border-radius:9px;padding:8px;font-size:15px;font-weight:500;color:var(--ink-2)}
.segc button[aria-pressed="true"]{background:var(--surface);color:var(--ink);box-shadow:0 1px 4px rgba(0,0,0,.12)}
.sw{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:15px}
.sw input{width:44px;height:26px;appearance:none;-webkit-appearance:none;background:var(--line);border-radius:980px;position:relative;cursor:pointer;transition:background .2s;flex:none}
.sw input::after{content:"";position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.25);transition:transform .2s}
.sw input:checked{background:var(--ge)}
.sw input:checked::after{transform:translateX(18px)}
.minfo{font-size:13px;color:var(--ink-3);line-height:1.45}

/* tarjetas de resultado */
.res{display:flex;flex-direction:column;gap:14px;min-width:0}
.rh{display:flex;align-items:baseline;justify-content:space-between;gap:10px;flex-wrap:wrap}
.rh h2{margin:0;font-family:var(--font-d);font-size:clamp(24px,3vw,32px);font-weight:600;line-height:1.15;text-wrap:balance}
.rh span{color:var(--ink-3);font-size:14px}
.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.card{background:var(--surface);border-radius:20px;padding:20px;display:flex;flex-direction:column;gap:8px;min-width:0;box-shadow:var(--shadow);position:relative}
.card .k{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:600}
.card .k svg{width:22px;height:22px;flex:none;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.card h3{margin:0;font-family:var(--font-d);font-size:20px;font-weight:600;line-height:1.2}
.card .what{font-size:13px;color:var(--ink-3);line-height:1.4;margin:0}
.card .q{font-family:var(--font-d);font-weight:600;font-size:clamp(26px,3vw,34px);line-height:1.1;font-variant-numeric:tabular-nums;margin-top:auto}
.card .q small{display:block;font-size:13px;font-weight:400;color:var(--ink-3);font-family:var(--font)}
.card .meta{font-size:13px;color:var(--ink-3);font-variant-numeric:tabular-nums;display:flex;flex-direction:column;gap:1px}
.diff{align-self:flex-start;border-radius:980px;padding:4px 11px;font-size:14px;font-weight:600;font-variant-numeric:tabular-nums}
.card.ge{grid-column:1/-1;background:var(--ge-soft);box-shadow:none;border:2px solid var(--ge);display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:8px 24px;padding:24px}
.card.ge .k{color:var(--ge)}
.card.ge h3{font-size:clamp(24px,3vw,30px)}
.card.ge .q{font-size:clamp(38px,5vw,56px)}
.card.ge .l,.card.ge .r{display:flex;flex-direction:column;gap:8px;min-width:0}
.card.ge .r{justify-content:flex-end}
.card.ge .diff{background:var(--ge);color:var(--ge-ink)}
.tag{position:absolute;top:-11px;left:22px;background:var(--ge);color:var(--ge-ink);font-size:12px;font-weight:700;border-radius:980px;padding:3px 11px;letter-spacing:.02em}
.card.p1 .k{color:var(--seg)} .card.p1 .diff{background:var(--seg-soft);color:var(--seg)}
.card.p2 .k{color:var(--dmg)} .card.p2 .diff{background:var(--dmg-soft);color:var(--dmg)}
.card.nor .k{color:var(--ink-3)} .card.nor .diff{background:var(--surface-2);color:var(--ink-2)}
.card.off{opacity:.62;box-shadow:none;border:1px dashed var(--line)}
.card.off .q{font-size:17px;font-family:var(--font);font-weight:500;color:var(--ink-3)}
.gein{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.gein label{display:flex;flex-direction:column;gap:3px;font-size:12px;color:var(--ink-3)}
.gein input{border:1px solid var(--ge);background:var(--surface);border-radius:10px;padding:7px 10px;font-size:16px;font-variant-numeric:tabular-nums;min-width:0;width:100%}
.ptag{font-size:13px;color:var(--ink-2)}
.ptag b{font-variant-numeric:tabular-nums}

/* partes y piezas */
.need{background:var(--surface);border-radius:24px;padding:24px;display:flex;flex-direction:column;gap:16px;margin-top:6px}
.need h2{margin:0;font-family:var(--font-d);font-size:clamp(24px,3vw,32px);font-weight:600;line-height:1.15;text-wrap:balance}
.need .sub{margin:-8px 0 0;color:var(--ink-3);font-size:15px}
.parts{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
.part{border:1px solid var(--line);background:var(--bg);border-radius:16px;padding:14px;display:flex;flex-direction:column;gap:6px;text-align:left;min-width:0;transition:border-color .2s,transform .2s}
.part:hover{transform:translateY(-1px)}
.part{cursor:default}
.part svg{width:34px;height:34px;stroke:var(--ink-2);fill:none;stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round}
.part .pn{font-size:14px;font-weight:600;line-height:1.25}
.part .pc{font-family:var(--font-d);font-size:21px;font-weight:600;font-variant-numeric:tabular-nums}
.cov{display:flex;gap:4px;flex-wrap:wrap}
.cov i{font-style:normal;font-size:11px;font-weight:600;border-radius:6px;padding:1px 6px}
.cov .g{background:var(--ge-soft);color:var(--ge)} .cov .d{background:var(--dmg-soft);color:var(--dmg)} .cov .r{background:var(--seg-soft);color:var(--seg)}
.part.robo{border-style:dashed}
.verdict{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px}
.vbox{border-radius:18px;padding:18px;display:flex;flex-direction:column;gap:4px;min-width:0}
.vbox.no{background:var(--warn-soft)} .vbox.si{background:var(--ge-soft)}
.vbox .vl{font-size:13px;font-weight:600}
.vbox.no .vl{color:var(--warn)} .vbox.si .vl{color:var(--ge)}
.vbox .vv{font-family:var(--font-d);font-size:clamp(28px,4vw,40px);font-weight:600;line-height:1.1;font-variant-numeric:tabular-nums}
.vbox .vd{font-size:13px;color:var(--ink-2);line-height:1.45}
.claim{font-family:var(--font-d);font-size:clamp(19px,2.4vw,24px);font-weight:600;line-height:1.3;text-wrap:balance;margin:0}
.claim em{font-style:normal;color:var(--ge)}
.fine{font-size:11.5px;color:var(--ink-3);line-height:1.5}
.tech{font-size:13px;color:var(--ink-3);border-top:1px solid var(--line);padding-top:12px}

/* ajustes */
.ov{position:fixed;inset:0;z-index:60;background:rgba(0,0,0,.42);display:flex;justify-content:flex-end}
.sheet{background:var(--bg);width:min(720px,100%);height:100%;overflow:auto;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
.sheet-h{position:sticky;top:0;z-index:2;background:var(--nav);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-bottom:1px solid var(--line);display:flex;align-items:center;gap:10px;padding-block:10px;padding-left:max(20px,env(safe-area-inset-left,0px));padding-right:max(20px,env(safe-area-inset-right,0px))}
.sheet-h h2{margin:0;font-family:var(--font-d);font-size:21px;font-weight:600;flex:1}
.sheet-h h2 small{display:block;font-size:12px;font-weight:400;color:var(--ink-3)}
.sheet-b{padding:20px;display:flex;flex-direction:column;gap:14px}
.pill{border:0;border-radius:980px;padding:7px 15px;font-size:14px;background:var(--blue);color:#fff;white-space:nowrap}
.pill.gray{background:var(--surface-2);color:var(--ink)}
.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.fld{display:flex;flex-direction:column;gap:4px;min-width:0}
.inp{border:1px solid var(--line);background:var(--surface);border-radius:10px;padding:8px 10px;font-size:15px;min-width:0;width:100%;font-variant-numeric:tabular-nums}
textarea.inp{min-height:150px;font-size:13px;font-family:ui-monospace,Menlo,monospace;resize:vertical;line-height:1.5}
.hint{font-size:12px;color:var(--ink-3);line-height:1.45}
.state{font-size:12px;color:var(--ink-3);display:inline-flex;align-items:center;gap:6px}
.state i{width:7px;height:7px;border-radius:50%;background:var(--ink-3)}
.state.ok i{background:var(--ge)}
.toast{position:fixed;left:50%;bottom:calc(22px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:10px 18px;border-radius:980px;font-size:14px;z-index:80;max-width:calc(100% - 32px)}

/* ===== v2 horizontal ===== */
.hero{padding-block:22px 0}
.hero h1{font-size:clamp(28px,4vw,44px)}
.cats{padding-block:16px 2px}
.bar{background:var(--surface);border-radius:22px;padding:20px 24px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr) minmax(0,1.5fr) minmax(0,1fr);gap:28px;align-items:start;box-shadow:var(--shadow)}
.bar .fld{gap:8px}
.bar .f-model .mt{font-family:var(--font-d);font-size:26px;font-weight:600;line-height:1.15}
.bar .chips .chip{padding:4px 10px;font-size:13px}
.bar .sw{margin-top:4px}
.sec{padding-block:26px 0}
.sec:last-of-type{padding-bottom:80px}
.sec-h{display:flex;align-items:baseline;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:12px}
.sec-h h2{margin:0;font-family:var(--font-d);font-size:clamp(24px,3vw,32px);font-weight:600;display:flex;align-items:center;gap:10px}
.sec-h > span{color:var(--ink-3);font-size:14px}
.sn{width:30px;height:30px;border-radius:50%;background:var(--ink);color:var(--bg);font-size:15px;display:inline-flex;align-items:center;justify-content:center;flex:none}
.cmpwrap{overflow-x:auto;border-radius:22px;background:var(--surface);box-shadow:var(--shadow)}
.cmp{display:grid;grid-template-columns:minmax(150px,.75fr) repeat(4,minmax(175px,1fr));min-width:900px}
.cmp > div{padding:12px 18px;border-top:1px solid var(--line);display:flex;flex-direction:column;justify-content:center;gap:2px;min-width:0}
.cmp > .hd{border-top:0;padding-top:20px;padding-bottom:14px;justify-content:flex-end}
.cmp .rl{font-size:13px;color:var(--ink-3);font-weight:500}
.cmp .rl b{color:var(--ink);font-weight:600;font-size:14px}
.cmp .hd .k{display:flex;align-items:center;gap:8px;font-size:15px;font-weight:600;line-height:1.25}
.cmp .hd .k svg{width:24px;height:24px;flex:none;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.cmp .hd small{font-size:12px;color:var(--ink-3);font-weight:400}
.cmp .c-ge{background:var(--ge-soft);border-left:2px solid var(--ge);border-right:2px solid var(--ge)}
.cmp .c-ge.hd{border-top:2px solid var(--ge);border-radius:16px 16px 0 0}
.cmp .c-ge.last{border-bottom:2px solid var(--ge);border-radius:0 0 16px 16px}
.cmp .c-ge .k{color:var(--ge)} .cmp .c-p1 .k{color:var(--seg)} .cmp .c-p2 .k{color:var(--dmg)} .cmp .c-nor .k{color:var(--ink-2)}
.rec{align-self:flex-start;background:var(--ge);color:var(--ge-ink);font-size:11px;font-weight:700;border-radius:980px;padding:2px 9px;margin-bottom:4px}
.cmp .big{font-family:var(--font-d);font-weight:600;font-size:clamp(24px,2.4vw,32px);line-height:1.1;font-variant-numeric:tabular-nums}
.cmp .c-ge .big{font-size:clamp(28px,2.8vw,38px)}
.cmp .sm{font-size:13px;color:var(--ink-3)}
.cmp .val{font-size:16px;font-weight:600;font-variant-numeric:tabular-nums}
.cmp .na{color:var(--ink-3);font-size:14px}
.cmp .dv{font-size:18px;font-weight:600;font-variant-numeric:tabular-nums}
.cmp .c-ge .dv{color:var(--ge)} .cmp .c-p1 .dv{color:var(--seg)} .cmp .c-p2 .dv{color:var(--dmg)}
.cmp .base{font-size:13px;color:var(--ink-3);font-weight:500}
.cmp .what{font-size:12.5px;color:var(--ink-2);line-height:1.4}
.cmp .rowd{background:var(--bg)}
.cmp .rowd.c-ge{background:var(--ge-soft)}
.cmp .gein{grid-template-columns:1fr 1fr}
.cmp .gein input{padding:6px 9px;font-size:15px}
.need{margin-top:0}
.parts{grid-template-columns:repeat(auto-fit,minmax(138px,1fr))}
.part .row{display:flex;justify-content:space-between;gap:6px;font-size:12.5px;color:var(--ink-3);font-variant-numeric:tabular-nums}
.part .pc{font-size:22px}
.part .tl{font-size:11px;color:var(--ink-3);text-transform:uppercase;letter-spacing:.06em;margin-top:2px}
@media (max-width:1000px){.bar{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20px}}
@media (max-width:560px){.bar{grid-template-columns:minmax(0,1fr);padding:18px}}

/* ===== carpetas redondeadas ===== */
.tabs{display:flex;gap:6px;align-items:flex-end;padding-left:22px;padding-right:22px;overflow-x:auto;scrollbar-width:none}
.tab{border:0;background:var(--surface-2);color:var(--ink-3);border-radius:18px 18px 0 0;padding:11px 20px 10px;font-family:var(--font-d);font-size:17px;font-weight:600;display:inline-flex;align-items:center;gap:9px;white-space:nowrap;position:relative}
.tab .sn{width:24px;height:24px;font-size:13px;background:var(--ink-3)}
.tab[aria-selected="true"]{background:var(--surface);color:var(--ink);padding-top:14px}
.tab[aria-selected="true"] .sn{background:var(--ink)}
.tab[aria-selected="true"]::before,.tab[aria-selected="true"]::after{content:"";position:absolute;bottom:0;width:18px;height:18px;background:radial-gradient(circle at 0 0,transparent 17.5px,var(--surface) 18px)}
.tab[aria-selected="true"]::after{right:-18px}
.tab[aria-selected="true"]::before{left:-18px;background:radial-gradient(circle at 100% 0,transparent 17.5px,var(--surface) 18px)}
.tab.solo{cursor:default}
.folder{background:var(--surface);border-radius:26px;padding:18px;box-shadow:var(--shadow);display:flex;flex-direction:column;gap:12px;min-width:0}
.folder-h{display:flex;justify-content:flex-end;color:var(--ink-3);font-size:14px;padding:0 4px;text-align:right}
.folder .cmpwrap{box-shadow:none;border-radius:20px;border:1px solid var(--line)}
.folder .need{padding:0;background:none}
/* tabla tipo v5 */
.twrap{overflow-x:auto;border-radius:20px;border:1px solid var(--line)}
.qt{border-collapse:separate;border-spacing:0;width:100%;min-width:980px;font-variant-numeric:tabular-nums}
.qt th,.qt td{padding:12px 14px;text-align:left;border-bottom:1px solid var(--line);vertical-align:top}
.qt thead th{font-size:12.5px;font-weight:600;line-height:1.3;border-top:4px solid var(--fc,var(--ink-3));background:var(--surface)}
.qt thead th small{display:block;font-weight:400;color:var(--ink-3);font-size:12px}
.qt thead th b{display:block;font-size:13px;color:var(--fc,var(--ink));margin-top:2px}
.qt th:first-child,.qt td:first-child{position:sticky;left:0;z-index:1;background:var(--surface);text-align:center;width:84px;border-right:1px solid var(--line)}
.qt td:first-child{font-family:var(--font-d);font-size:22px;font-weight:600}
.qt td:first-child small{display:block;font-size:11px;font-weight:400;color:var(--ink-3);font-family:var(--font)}
.qt td .q{font-family:var(--font-d);font-size:19px;font-weight:600;display:block}
.qt td .d{font-size:12.5px;font-weight:600;color:var(--fc,var(--ink-3));display:block}
.qt td .t{font-size:11.5px;color:var(--ink-3);display:block}
.qt td.na{color:var(--ink-3);font-size:13px}
.qt tbody tr{cursor:pointer}
.qt tbody tr:hover td{background:var(--bg)}
.qt tbody tr.on td{background:var(--ge-soft)}
.qt tbody tr:last-child td{border-bottom:0}
.qt .f-nor{--fc:var(--ink-2)} .qt .f-ge{--fc:var(--ge)} .qt .f-p1{--fc:var(--seg)} .qt .f-p2{--fc:var(--dmg)}
@media (max-width:560px){.folder{padding:10px;border-radius:20px}.tab{font-size:15px;padding:9px 14px 8px}.tab[aria-selected="true"]{padding-top:12px}}

.pz{display:flex;align-items:center;gap:16px;background:var(--bg);border-radius:18px;padding:16px 20px}
.pz svg{width:40px;height:40px;stroke:var(--ink-2);fill:none;stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round;flex:none}
.pz-x{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}
.pz-l{font-size:16px;font-weight:600}
.pz-t{font-size:13px;color:var(--ink-3)}
.pz-v{font-family:var(--font-d);font-size:clamp(26px,3vw,34px);font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap}
@media (max-width:560px){.pz{flex-wrap:wrap}.pz-v{width:100%}}
/* ===== v3 ===== */
.acts{display:flex;gap:8px;flex-wrap:wrap;margin-top:6px}
.acts .pill{display:inline-flex;align-items:center;gap:6px;font-size:13px;padding:7px 13px}
.acts .pill svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.acts .pill.ge{background:var(--ge);color:var(--ge-ink)}
#caps{margin-top:2px}
#caps .chip{padding:3px 10px;font-size:12.5px}
.mcards{display:none;flex-direction:column;gap:10px}
.mc{background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:16px;display:flex;flex-direction:column;gap:10px;position:relative}
.mc.c-ge{background:var(--ge-soft);border:2px solid var(--ge)}
.mc .rec{position:absolute;top:-10px;left:16px}
.mc-h{display:flex;align-items:center;gap:10px}
.mc-h svg{width:26px;height:26px;flex:none;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.mc-h b{display:block;font-size:16px;line-height:1.2}.mc-h small{display:block;font-size:12px;color:var(--ink-3)}
.mc.c-ge .mc-h{color:var(--ge)} .mc.c-p1 .mc-h{color:var(--seg)} .mc.c-p2 .mc-h{color:var(--dmg)} .mc.c-nor .mc-h{color:var(--ink-2)}
.mc-h b{color:inherit}
.mc-q small{display:block;font-size:12.5px;color:var(--ink-3)}
.mc-q span{font-family:var(--font-d);font-weight:600;font-size:34px;line-height:1.1;font-variant-numeric:tabular-nums}
.mc.c-ge .mc-q span{font-size:40px}
.mc-f{display:flex;flex-direction:column;gap:2px;font-size:13px;color:var(--ink-3);font-variant-numeric:tabular-nums}
.mc-f .dv{font-size:17px;font-weight:600}
.mc.c-ge .dv{color:var(--ge)} .mc.c-p1 .dv{color:var(--seg)} .mc.c-p2 .dv{color:var(--dmg)}
@media (max-width:700px){#pRes .cmpwrap{display:none}.mcards{display:flex}}
/* estadísticas */
.st3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.st3 div{background:var(--bg);border-radius:14px;padding:12px;display:flex;flex-direction:column}
.st3 span{font-size:12px;color:var(--ink-3)}.st3 b{font-family:var(--font-d);font-size:28px;font-variant-numeric:tabular-nums}
.stl{display:flex;flex-direction:column;gap:6px;font-size:14px}
.stl div{display:grid;grid-template-columns:130px minmax(0,1fr) 40px;gap:10px;align-items:center}
.stl i{display:block;height:10px;border-radius:5px;background:var(--ge)}
.stl div b{text-align:right;font-variant-numeric:tabular-nums}

@media (max-width:560px){#sync{display:none}.brand{white-space:nowrap;font-size:17px}}
.stl{margin-top:6px}
.cov2{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.cv{border-radius:20px;padding:18px 20px;display:flex;flex-direction:column;gap:8px;min-width:0}
.cv.ok{background:var(--ge-soft)} .cv.no{background:var(--warn-soft)} .cv.how{background:var(--bg)}
.cv h3{margin:0;font-family:var(--font-d);font-size:20px;font-weight:600;display:flex;align-items:center;gap:8px}
.cv h3 svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
.cv.ok h3{color:var(--ge)} .cv.no h3{color:var(--warn)}
.cv ul{margin:0;padding-left:18px;display:flex;flex-direction:column;gap:7px;font-size:14px;line-height:1.45;color:var(--ink-2)}
.cv b{color:var(--ink)}
@media (max-width:900px){.cov2{grid-template-columns:minmax(0,1fr)}}
.pie{display:flex;flex-direction:column;gap:4px;margin-top:8px}
.pie-in{display:flex;align-items:baseline;gap:4px;border-bottom:1px solid var(--line);padding-bottom:2px}
.pie-in:focus-within{border-color:var(--blue)}
.pie-in b{font-size:20px;font-weight:600;color:var(--ink-3)}
.pie-in input{border:0;background:none;font-family:var(--font-d);font-size:22px;font-weight:600;width:100%;min-width:0;outline:none;font-variant-numeric:tabular-nums}
.evtsw span{display:flex;flex-direction:column}
.evtsw b{color:var(--ge)}
.evtsw small{font-size:11.5px;color:var(--ink-3)}
.aptype{display:grid;grid-template-columns:1fr 1fr}.aptype button{border:0;background:none;border-radius:9px;padding:7px 8px;font-weight:600;font-size:13px;color:var(--ink-2)}.aptype button[aria-pressed="true"]{background:var(--surface);color:var(--ink);box-shadow:0 1px 3px rgba(0,0,0,.12)}.aptype button[data-ptype="cmr"][aria-pressed="true"]{color:#d70015}.aptype button:disabled{opacity:.4}
#inPrice.cmr{color:#d70015}.capchips .chip.cmrc small{color:#d70015}
.apbox{margin-top:10px;display:flex;flex-direction:column;gap:8px}.apbox .sw{padding:0}
.capchips{display:flex;flex-wrap:wrap;gap:6px}.capchips .chip{display:flex;flex-direction:column;align-items:center;line-height:1.15;padding:6px 12px}.capchips .chip small{font-size:11px;color:var(--ink-3);font-weight:500}.capchips .chip[aria-pressed="true"] small{color:inherit;opacity:.85}
.pl70,.evtsw .pl70{color:#0a8a3a;font-weight:700}.plci,.evtsw .plci{color:#d70015;font-weight:700}.plop{color:var(--ink-3);font-weight:400}
.planci{margin-top:4px;font-size:12.5px!important;color:var(--ink-2)!important;line-height:1.45}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]):not([data-theme="sepia"]) .pl70,:root:not([data-theme="light"]):not([data-theme="sepia"]) .evtsw .pl70{color:#30d158}:root:not([data-theme="light"]):not([data-theme="sepia"]) .plci,:root:not([data-theme="light"]):not([data-theme="sepia"]) .evtsw .plci{color:#ff453a}}
.planci span.ln{display:block}.planci b{font-size:14px}
:root[data-theme="dark"] .pl70{color:#30d158}:root[data-theme="dark"] .plci{color:#ff453a}
.evt{display:inline-block;margin-top:4px;font-size:12px;font-weight:600;color:var(--ge-ink);background:var(--ge);border-radius:980px;padding:2px 9px;align-self:flex-start}
.rec100,.rec70{display:inline-block;align-self:flex-start;font-size:12px;font-weight:700;border-radius:980px;padding:2px 9px;margin-bottom:4px}
.rec100{background:var(--ge);color:var(--ge-ink)} .rec70{background:var(--seg-soft);color:var(--seg)}
.inv{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-bottom:12px}
.inv-c{border-radius:20px;padding:16px 20px;display:flex;align-items:center;gap:16px}
.inv-c.ge{background:var(--ge-soft)} .inv-c.seg{background:var(--seg-soft)}
.inv-c b{font-family:var(--font-d);font-size:40px;font-weight:700;line-height:1;flex:none}
.inv-c.ge b{color:var(--ge)} .inv-c.seg b{color:var(--seg)}
.inv-c span{font-size:14px;color:var(--ink-2);line-height:1.4}
@media (max-width:700px){.inv{grid-template-columns:minmax(0,1fr)}}
.part .pc.rg{font-size:17px;line-height:1.25}
.pnote{font-size:11.5px;color:var(--ink-3)}
.brands{display:none!important}
.bchip{flex:none;border:1.5px solid var(--line);background:var(--surface);border-radius:980px;padding:8px 18px;font-size:15px;font-weight:600;white-space:nowrap}
.bchip[aria-pressed="true"]{border-color:var(--blue);color:var(--blue);background:var(--seg-soft)}
@media (max-width:1060px){.cards{grid-template-columns:repeat(2,minmax(0,1fr))}.card.nor{grid-column:1/-1}}
@media (max-width:900px){.main{grid-template-columns:minmax(0,1fr)}.side{position:static}}
@media (max-width:620px){.cards{grid-template-columns:minmax(0,1fr)}.card.ge{grid-template-columns:minmax(0,1fr)}.verdict{grid-template-columns:minmax(0,1fr)}.grid2{grid-template-columns:minmax(0,1fr)}.models{justify-content:flex-start}.cat{min-width:60px;padding:6px}.cat svg{width:38px;height:38px}}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}

/* ===== Exchange Planes ===== */
.cat[data-grp="exc"]{--neo:#2bff88}
.xico{width:50px;height:50px;border-radius:50%;display:block;filter:drop-shadow(0 0 6px rgba(76,217,60,.55));transition:transform .25s}
@media (max-width:700px){.xico{width:42px;height:42px}}
.xgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:8px}
@media (max-width:760px){.xgrid{grid-template-columns:minmax(0,1fr)}}
.xbox{box-shadow:var(--shadow)}
.xh{font-family:var(--font-d);font-size:20px;font-weight:600;margin:0;display:flex;gap:10px;align-items:center}
.xh .sn{display:inline-grid;place-items:center;width:26px;height:26px;border-radius:50%;background:var(--ink);color:var(--bg);font-size:14px}
.xrow{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:10px}
.xf{display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--ink-3);font-weight:500;min-width:0}
.xf select,.xf input{font-size:17px;color:var(--ink);background:var(--surface-2);border:1px solid var(--line);border-radius:12px;padding:10px 12px;width:100%;min-width:0;font-variant-numeric:tabular-nums}
.xf input.xred{color:#d70015;font-weight:600}
.xsrc{font-size:12.5px;color:var(--ink-3);line-height:1.35}
.xsrc.warn{color:var(--warn)}
.xgift{display:flex;align-items:baseline;justify-content:space-between;gap:10px;background:var(--ge-soft);border-radius:14px;padding:12px 14px}
.xgift span{font-size:14px;color:var(--ink-2)}
.xgift b{font-family:var(--font-d);font-size:30px;color:var(--ge);font-variant-numeric:tabular-nums}
.xgift s{color:var(--ink-3);font-size:15px;margin-right:6px}
.xmsg{margin:0;font-size:14px;color:var(--ink-2)}
.xres{margin-top:16px;box-shadow:var(--shadow)}
.xeq{display:flex;flex-wrap:wrap;align-items:center;gap:10px 14px}
.xeq .t{display:flex;flex-direction:column;min-width:0}
.xeq .t small{font-size:12.5px;color:var(--ink-3)}
.xeq .t b{font-family:var(--font-d);font-size:24px;font-variant-numeric:tabular-nums}
.xeq .op{font-size:24px;color:var(--ink-3)}
.xeq .t.tot b{font-size:34px}
.xeq .t.gc b{color:var(--ge)}
.xnote{margin:6px 0 0;font-size:14px;color:var(--ink-2)}
.xfin{margin-top:16px;box-shadow:var(--shadow)}
.xctl{display:flex;flex-wrap:wrap;gap:12px 22px;align-items:center}
.xctl .chips{display:flex;flex-wrap:wrap;gap:6px}
.xctl .segc{min-width:240px}
.xt{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
.xc{border:1px solid var(--line);border-radius:16px;padding:14px;display:flex;flex-direction:column;gap:4px;min-width:0}
.xc.ge{border-color:var(--ge)}
.xc h3{margin:0;font-size:15px;font-weight:600}
.xc .q{font-family:var(--font-d);font-size:28px;font-variant-numeric:tabular-nums}
.xc small{font-size:12.5px;color:var(--ink-3)}
.xc .dv{color:var(--ge);font-weight:600;font-size:14px}

/* ===== Exchange v2 ===== */
.xc{position:relative}
.xc .rec{position:static;align-self:flex-start;margin-bottom:2px}
.xc.hi{background:var(--ge-soft);border:2px solid var(--ge)}
.xc.hi h3{color:var(--ge)}
.xc.hi .q{font-size:34px}
.xc .what{margin:4px 0 0;font-size:13px;color:var(--ink-2);line-height:1.4}
.xc .rec70{margin-top:4px}
.xleg{margin:0;font-size:13px;color:var(--ink-2);background:var(--surface-2);border-radius:10px;padding:8px 12px}
.xbk{background:var(--warn-soft);border:1px solid var(--warn);border-radius:18px;padding:14px 16px;margin-top:8px;display:flex;flex-direction:column;gap:8px}
.xbk.ok{background:var(--ge-soft);border-color:var(--ge)}
.xbk-h{display:flex;align-items:center;gap:12px}
.xbk-h svg{width:34px;height:34px;flex:none;fill:none;stroke:var(--warn);stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.xbk.ok .xbk-h svg{stroke:var(--ge)}
.xbk-t{display:flex;flex-direction:column;gap:2px;flex:1;min-width:0}
.xbk-t b{font-size:16px}.xbk-t small{font-size:13px;color:var(--ink-2)}
.xbk details summary{cursor:pointer;font-weight:600;font-size:14px;color:var(--link)}
.xbk ol{margin:8px 0 6px;padding-left:22px;display:flex;flex-direction:column;gap:4px;font-size:14px}
@media (max-width:600px){.xbk-h{flex-wrap:wrap}}
/* ===== Accesorios ===== */
.acc{grid-column:1/-1;border-top:1px solid var(--line);padding-top:16px;display:flex;flex-direction:column;gap:10px;min-width:0}
.acc[hidden]{display:none}
.acc-h{display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px}
.acc-h .lab{margin-right:auto}
.acc-h small{font-size:12.5px;color:var(--ink-3)}
.acc-h .segc{min-width:180px}
.acc-nav{border:1px solid var(--line);background:var(--surface);width:34px;height:34px;border-radius:50%;font-size:18px;line-height:1;color:var(--ink-2)}
.acc-rail{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;padding:2px 2px 8px;scrollbar-width:thin}
.ac{flex:0 0 210px;scroll-snap-align:start;border:1px solid var(--line);border-radius:16px;padding:12px;display:flex;flex-direction:column;gap:6px;background:var(--surface)}
.ac[aria-current="true"]{border:2px solid var(--ge);background:var(--ge-soft)}
.ac svg{width:40px;height:40px;fill:none;stroke:var(--ink);stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
.ac b{font-size:14.5px;line-height:1.25}
.ac .pr{display:flex;flex-direction:column;gap:1px;font-size:12.5px;color:var(--ink-3);font-variant-numeric:tabular-nums}
.ac .pr s{color:var(--ink-3)}
.ac .pr .of{font-size:16px;color:var(--ink);font-weight:600}
.ac .pr .cm{color:#d70015;font-weight:600}
.ac button.add{margin-top:auto;border:1px solid var(--ink);background:var(--surface);color:var(--ink);border-radius:980px;padding:6px 10px;font-size:13.5px;font-weight:600}
.ac button.add[aria-pressed="true"]{background:var(--ge);border-color:var(--ge);color:var(--ge-ink)}
.ac button.add:disabled{opacity:.4}
.acc-sum{font-size:14px;color:var(--ink-2)}
.acc-sum b{color:var(--ink)}

/* ===== Compra Protegida ===== */
.cpw{display:flex;flex-direction:column;gap:16px;margin-top:8px}
.cphero{display:flex;align-items:center;gap:18px;background:linear-gradient(120deg,#d9f26b,#b9e23a);color:#1d2a05;border-radius:24px;padding:22px 24px}
.cphero img{width:76px;height:76px;flex:none;border-radius:50%;box-shadow:0 0 0 4px rgba(255,255,255,.6)}
.cphero h2{margin:0;font-family:var(--font-d);font-size:30px;line-height:1.1}
.cphero p{margin:6px 0 0;font-size:17px}
.cphero p b{font-size:19px}
.cpsec{background:var(--surface);border-radius:22px;padding:20px 22px;box-shadow:var(--shadow)}
.cpsec>h3{margin:0 0 14px;font-family:var(--font-d);font-size:22px}
.cpcov{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.cpcov div{background:var(--surface-2);border-radius:16px;padding:16px;display:flex;flex-direction:column;gap:6px}
.cpcov svg{width:40px;height:40px;fill:none;stroke:#3e8f1a;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.cpcov b{font-size:18px}.cpcov span{font-size:15px;color:var(--ink-2)}
.cpamt{display:flex;flex-wrap:wrap;align-items:center;gap:10px 16px;margin-bottom:14px;font-size:15px;color:var(--ink-2)}
.cpamt input{font-size:20px;font-weight:600;width:200px;background:var(--surface-2);border:1px solid var(--line);border-radius:12px;padding:8px 12px;color:var(--ink)}
.cpamt .warn{color:var(--warn);font-weight:600}
.cpplans{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.cpp{border:2px solid var(--line);border-radius:20px;padding:18px;display:flex;flex-direction:column;gap:8px;position:relative}
.cpp.best{border-color:#5aa51f;background:color-mix(in srgb,#b9e23a 16%,var(--surface))}
.cpp .tag{align-self:flex-start;background:#3e8f1a;color:#fff;border-radius:980px;padding:3px 12px;font-size:13px;font-weight:700}
.cpp h4{margin:0;font-size:22px}
.cpp .pr{font-family:var(--font-d);font-size:40px;font-weight:600;line-height:1}
.cpp .pr small{font-size:17px;font-weight:500;color:var(--ink-2)}
.cpp .uf{font-size:14px;color:var(--ink-3)}
.cpp ul{margin:4px 0 0;padding:0;list-style:none;display:flex;flex-direction:column;gap:8px;font-size:16px}
.cpp li{display:flex;gap:8px;align-items:flex-start}
.cpp li::before{content:"✓";color:#3e8f1a;font-weight:800}
.cpp details{margin-top:auto;font-size:13px;color:var(--ink-3)}
.cpp details summary{cursor:pointer}
.cpp .bc{background:#fff;border-radius:10px;padding:8px;margin-top:6px;display:inline-block}
.cpuse{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.cpuse div{border-left:4px solid #8cc63f;padding:6px 12px;font-size:15px;color:var(--ink-2)}
.cpuse b{display:block;font-size:17px;color:var(--ink);margin-bottom:4px}
.cpdoc{width:100%;border-collapse:collapse;font-size:15px}
.cpdoc th,.cpdoc td{padding:9px 8px;border-bottom:1px solid var(--line);text-align:center}
.cpdoc th:first-child,.cpdoc td:first-child{text-align:left}
.cpdoc th{font-size:13px;color:var(--ink-3);font-weight:600}
.cpdoc td.y{color:#3e8f1a;font-weight:800;font-size:18px}
.cpgrid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.cpreq{margin:0;padding-left:20px;font-size:16px;display:flex;flex-direction:column;gap:6px}
.cpct{display:flex;flex-direction:column;gap:8px;font-size:16px}
.cpct a{color:var(--link);font-weight:600;text-decoration:none}
.cplegal{font-size:12px;color:var(--ink-3);line-height:1.45;margin:0}
@media (max-width:760px){.cpcov,.cpplans,.cpuse,.cpgrid2{grid-template-columns:minmax(0,1fr)}.cphero{flex-direction:column;text-align:center}.cphero h2{font-size:25px}.cpp .pr{font-size:34px}.cpdoc{font-size:13px}}
.cpico{width:50px;height:50px;border-radius:50%;display:block;filter:drop-shadow(0 0 6px rgba(76,217,60,.55));transition:transform .25s}
@media (max-width:700px){.cpico{width:42px;height:42px}}

/* ===== v6: negro, título blanco, tipografía categorías ===== */
.thm{display:none!important}
html,body{background:#000!important}
:root[data-theme="dark"]{--bg:#000}
.hero h1,:root[data-theme] .hero h1{color:#fff!important;text-shadow:none!important;font-weight:600!important;letter-spacing:-.025em;font-family:var(--font-d)}
.hlogo{box-shadow:0 0 0 1px rgba(255,255,255,.22)}
.cat span{font-family:var(--font-d);font-size:14.5px;font-weight:600;letter-spacing:.005em;color:rgba(255,255,255,.72);line-height:1.15;text-align:center}
.cat[aria-pressed="true"] span{color:#fff;border-bottom:2px solid #fff}
.cat:hover span{color:#fff}
@media (max-width:600px){.cat span{font-size:12.5px}}
/* Exchange con las mismas tarjetas de la calculadora */
.xt{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
.xt .mc.c-ge:not(.hi){background:var(--surface);border:1px solid var(--line)}
.xt .mc.c-ge:not(.hi) .mc-q span{font-size:34px}
.xt .mc.hi{background:var(--ge-soft);border:2px solid var(--ge)}
.xt .mc.hi .mc-h{color:var(--ge)}
.xt .mc.hi .mc-q span{font-size:40px}
.xt .mc.hi .dv{color:var(--ge)}
.xt .mc .what{font-size:13px;color:var(--ink-2);line-height:1.4}
.xt .mc .rec{position:absolute;top:-10px;left:16px}
.xt .mc{margin-top:8px}
/* Argumentos para el cliente */
.ben{display:flex;flex-direction:column;gap:14px;padding:18px 22px 22px}
.ben-h{font-family:var(--font-d);font-size:22px;font-weight:600;margin:0}
.ben-sub{margin:0;color:var(--ink-2);font-size:15px}
.ben-g{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:12px}
.ben-c{border:1px solid var(--line);border-radius:18px;padding:16px;display:flex;flex-direction:column;gap:8px;background:var(--surface)}
.ben-c.ge{border-color:var(--ge);background:var(--ge-soft)}
.ben-c h4{margin:0;font-size:18px;font-family:var(--font-d)}
.ben-c.ge h4{color:var(--ge)}.ben-c.p1 h4{color:var(--seg)}.ben-c.p2 h4{color:var(--dmg)}
.ben-c ul{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:8px;font-size:15px;line-height:1.4}
.ben-c li{display:flex;gap:8px}.ben-c li::before{content:"✓";font-weight:800;color:var(--ge)}
.ben-c .hook{font-size:14px;color:var(--ink-2);background:var(--surface-2);border-radius:10px;padding:8px 10px}
.xarg{margin-top:16px}
.xarg .ben-g{grid-template-columns:repeat(auto-fit,minmax(230px,1fr))}
.xarg .ben-c{background:var(--surface-2);border:0}
.xarg .ben-c b{font-size:16px}.xarg .ben-c span{font-size:14.5px;color:var(--ink-2);line-height:1.4}
/* repuestos on/off */
.tabs .tgl{margin-left:auto;align-self:center;display:flex;align-items:center;gap:8px;font-size:13px;color:var(--ink-2)}
/* botón cotizar */
.qbtn{margin-left:auto;align-self:center;border:0;background:var(--ge);color:var(--ge-ink);border-radius:980px;padding:8px 16px;font-weight:700;font-size:14px;display:inline-flex;gap:6px;align-items:center;white-space:nowrap}
.ovl{position:fixed;inset:0;background:rgba(0,0,0,.72);z-index:60;display:flex;align-items:flex-start;justify-content:center;overflow:auto;padding:24px 12px}
.ovl[hidden]{display:none}
.mdl{background:var(--surface);border:1px solid var(--line);border-radius:22px;max-width:760px;width:100%;padding:20px;display:flex;flex-direction:column;gap:14px}
.mdl h2{margin:0;font-family:var(--font-d);font-size:24px}
.mdl .row2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
@media (max-width:600px){.mdl .row2{grid-template-columns:1fr}}
.mdl label{display:flex;flex-direction:column;gap:6px;font-size:13px;color:var(--ink-3)}
.mdl input,.mdl select{font-size:16px;background:var(--surface-2);border:1px solid var(--line);border-radius:12px;padding:10px 12px;color:var(--ink)}
.qprev{background:#fff;color:#111;border-radius:16px;padding:18px;font-size:14px;line-height:1.45}
.qprev h3{margin:0 0 4px;font-size:20px;color:#111}
.qprev table{width:100%;border-collapse:collapse;margin:8px 0}
.qprev td,.qprev th{padding:7px 6px;border-bottom:1px solid #e5e5ea;text-align:left;font-variant-numeric:tabular-nums}
.qprev th{font-size:12px;color:#6e6e73}
.qprev tr.hl td{background:#e7f6ea;font-weight:600}
.qprev .tc{font-size:11.5px;color:#6e6e73;margin-top:8px}
.qprev .vd{display:inline-block;background:#111;color:#fff;border-radius:8px;padding:3px 9px;font-size:12px;font-weight:600}
.qact{display:flex;flex-wrap:wrap;gap:8px}
.qact a,.qact button{border:1px solid var(--line);background:var(--surface-2);color:var(--ink);border-radius:980px;padding:9px 16px;font-weight:600;font-size:14px;text-decoration:none}
.qact .pri{background:var(--ge);border-color:var(--ge);color:var(--ge-ink)}
.mdl .x{align-self:flex-end;border:0;background:var(--surface-2);color:var(--ink);border-radius:50%;width:34px;height:34px;font-size:18px}
/* tienda */
.storeb{border:0;background:var(--surface-2);color:var(--ink);border-radius:980px;height:34px;padding:0 12px;font-size:12.5px;display:inline-flex;align-items:center;gap:6px;max-width:220px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
/* panel de impacto */
.dash{max-width:1240px}
.dash .kp{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
.dash .kp div{background:var(--surface-2);border-radius:16px;padding:14px}
.dash .kp b{display:block;font-family:var(--font-d);font-size:30px;font-variant-numeric:tabular-nums}
.dash .kp span{font-size:13px;color:var(--ink-3)}
.dash .flt{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.dash .flt .segc{min-width:300px}
.dash .g2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
@media (max-width:760px){.dash .g2{grid-template-columns:minmax(0,1fr)}}
.dash .box{background:var(--surface-2);border-radius:16px;padding:14px;min-width:0}
.dash .box h3{margin:0 0 8px;font-size:15px;font-weight:600}
.dash canvas{width:100%!important;max-height:280px}
.dash .map{overflow-x:auto}
.dash .map svg{display:block;min-width:900px;width:100%;height:auto}
.dash table{width:100%;border-collapse:collapse;font-size:13.5px}
.dash td,.dash th{padding:7px 6px;border-bottom:1px solid var(--line);text-align:left;font-variant-numeric:tabular-nums}
.dash th{color:var(--ink-3);font-weight:600;font-size:12px}
.dash .note{font-size:12.5px;color:var(--ink-3);margin:0}

.cat[data-grp] svg.bigico{width:52px;height:52px;stroke:none;stroke-width:0;filter:drop-shadow(0 0 4px rgba(76,217,60,.55)) drop-shadow(0 0 12px rgba(76,217,60,.25))}
.cat[data-grp][aria-pressed="true"] svg.bigico{filter:drop-shadow(0 0 6px rgba(76,217,60,.8)) drop-shadow(0 0 16px rgba(76,217,60,.4))}
@media (max-width:700px){.cat[data-grp] svg.bigico{width:44px;height:44px}}
.qmsg{width:100%;min-height:210px;font:15px/1.45 var(--font-d);background:var(--surface-2);border:1px solid var(--line);border-radius:12px;padding:12px;color:var(--ink);resize:vertical}
.mdl label.sw{flex-direction:row;justify-content:space-between;align-items:center}
.qsec{font-size:13px;color:var(--ink-3);margin:2px 0 -6px;font-weight:600;letter-spacing:.02em;text-transform:uppercase}

/* ===== Planes ===== */
.plmode .cmp .c-p1{background:var(--ge-soft);border-left:2px solid var(--ge);border-right:2px solid var(--ge)}
.plmode .cmp .c-p1.hd{border-top:2px solid var(--ge);border-radius:16px 16px 0 0;position:relative}
.plmode .cmp .c-p1.last{border-bottom:2px solid var(--ge);border-radius:0 0 16px 16px}
.plmode .cmp .c-p1 .k,.plmode .cmp .c-p1 .dv{color:var(--ge)}
.plmode .cmp .c-p1 .big{font-size:clamp(28px,2.8vw,38px)}
.plmode .cmp .c-p1.hd::before{content:"Recomendado";position:absolute;top:10px;right:12px;background:var(--ge);color:var(--ge-ink);font-size:12px;font-weight:700;border-radius:980px;padding:2px 10px}
.plmode .mc.c-p1{background:var(--ge-soft);border:2px solid var(--ge)}
.plmode .mc.c-p1 .mc-h,.plmode .mc.c-p1 .dv{color:var(--ge)}
.plmode .mc.c-p1 .mc-q span{font-size:40px}

.plb{grid-column:1/-1;border-top:1px solid var(--line);padding-top:16px;display:flex;flex-direction:column;gap:12px;min-width:0}
.plb[hidden]{display:none}
.plb-h{display:flex;flex-wrap:wrap;gap:6px 14px;align-items:baseline}
.plb-h .lab{margin-right:auto}.plb-h small{font-size:12.5px;color:var(--ink-3)}
.plops{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
.plop-b{border:2px solid var(--line);background:var(--surface);color:var(--ink);border-radius:16px;padding:12px 14px;text-align:left;display:flex;flex-direction:column;gap:2px}
.plop-b b{font-size:18px;letter-spacing:.02em}
.plop-b span{font-size:13px;color:var(--ink-3)}
.plop-b[aria-pressed="true"]{border-color:#fff;background:var(--surface-2)}
.plop-b[data-op="CLARO"] b{color:#ff4d4d}.plop-b[data-op="ENTEL"] b{color:#3d8bff}.plop-b[data-op="WOM"] b{color:#c04dff}
.plgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px}
.plc{border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:16px;padding:12px 14px;text-align:left;display:flex;flex-direction:column;gap:4px}
.plc[aria-pressed="true"]{border:2px solid var(--ge);background:var(--ge-soft)}
.plc .pn{font-size:14px;font-weight:600}
.plc .fee{font-size:13px;color:var(--ink-2)}
.plc .ci{font-family:var(--font-d);font-size:26px;font-weight:600;color:#ff453a;font-variant-numeric:tabular-nums}
.plc small{font-size:12px;color:var(--ink-3)}
.pl70box{border:2px solid var(--ge);background:var(--ge-soft);border-radius:20px;padding:18px;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:16px}
.pl70box:empty{display:none}
@media (max-width:760px){.pl70box{grid-template-columns:minmax(0,1fr)}.plops{gap:6px}.plop-b{padding:10px 8px}.plop-b b{font-size:16px}.plop-b span{font-size:11.5px}.pl70box .big{font-size:38px}}
.pl70box .k{font-size:14px;color:var(--ink-2)}
.pl70box .big{display:block;font-family:var(--font-d);font-size:44px;font-weight:700;color:var(--ge);line-height:1.05;font-variant-numeric:tabular-nums}
.pl70box .eq{font-size:15px;margin-top:6px;line-height:1.5}
.pl70box .eq b{font-variant-numeric:tabular-nums}
.pl70box ul{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:8px;font-size:15px;line-height:1.4}
.pl70box li{display:flex;gap:8px}.pl70box li::before{content:"✓";font-weight:800;color:var(--ge)}
.pl70box h4{margin:0 0 4px;font-size:17px}
</style>

<header class="top"><div class="wrap">
  <button class="brand" type="button" id="home" aria-label="Volver al inicio"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.1 7.5 9.5 4.3-1.4 7.5-4.9 7.5-9.5V6L12 3Z"/><path d="m8.8 12 2.3 2.3 4.2-4.6"/></svg>Bienvenido</button>
  <span class="state" id="sync"><i></i><span>Tablas de este equipo</span></span>
  <span class="thm" role="group" aria-label="Apariencia"><button type="button" id="tDark" aria-pressed="false" title="Modo oscuro" aria-label="Modo oscuro"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"/></svg></button></span>
  <button class="icon-btn" type="button" id="bAj"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/></svg>Ajustes</button>
</div></header>

<section class="wrap hero">
  <img class="hlogo" src="data:image/png;base64," alt="Falabella" width="72" height="72">
  <h1>Financiamiento Falabella</h1>
  
  <nav class="cats" id="cats" aria-label="Categorías"></nav>
  <div class="models brands" id="brands" role="group" aria-label="Marcas"></div>
  <div class="models" id="models" role="group" aria-label="Modelos"></div>
</section>

<section class="wrap">
  <div class="bar" role="group" aria-label="Datos de la cotización">
    <div class="fld f-model"><span class="lab">Producto</span><b class="mt" id="mTitle">iPhone</b><span class="minfo" id="mNote"></span></div>
    <div class="fld f-price"><span class="lab"><label for="inPrice">Precio</label></span>
      <div class="price"><b>$</b><input id="inPrice" inputmode="numeric" autocomplete="off" placeholder="" aria-label="Precio del producto"></div>
      <span class="eg" id="eg" hidden>Precio de ejemplo. Escribe el de la etiqueta.</span>
      <div class="apbox" id="apBox" hidden><label class="sw evtsw" for="inAP"><span>Precio automático falabella.com<small id="apInfo"></small></span><input type="checkbox" id="inAP"></label><div class="segc aptype" id="apType" hidden></div><div class="chips capchips" id="apCaps" hidden></div></div></div>
    <div class="fld f-n"><div class="nq"><span class="lab"><label for="inN">Cuotas</label></span><output id="outN" for="inN">12</output></div>
      <input type="range" id="inN" min="1" max="48" step="1" value="12"><div class="chips" id="qn"></div></div>
    <div class="fld f-cov"><span class="lab">Cobertura de la protección</span>
      <div class="segc" role="group" aria-label="Meses de cobertura"><button type="button" data-m="12" aria-pressed="true">1 año · 12 m</button><button type="button" data-m="24" aria-pressed="false">2 años · 24 m</button></div>
      <label class="sw" for="inSI"><span>Sin interés</span><input type="checkbox" id="inSI"></label>
      <label class="sw evtsw" for="inEvt" id="evtRow" hidden><span>Evento garantía <b id="evtLab">−30 %</b><small>Descuento de falabella.com en garantía de 1 año</small></span><input type="checkbox" id="inEvt"></label>
      <label class="sw evtsw" for="inGe2" id="ge2Row" hidden><span>Evento garantía <b>2 años al precio de 1</b><small>Teléfonos prepago · válido del 9 al 22 de noviembre de 2026</small></span><input type="checkbox" id="inGe2"></label>
      <label class="sw evtsw" for="inPlan" id="planRow" hidden><span>Cotizar con plan <b>Claro · Entel · WOM</b><small>Cuota inicial, cargo fijo y Seguro Connect sobre el 70 % del precio oferta</small><small id="planCI" class="planci"></small></span><input type="checkbox" id="inPlan"></label></div>
    <div class="plb" id="plBox" hidden>
      <div class="plb-h"><span class="lab">Planes Falabella Connect</span><small id="plInfo"></small></div>
      <div class="chips" id="plCaps" role="group" aria-label="Capacidad"></div>
      <div class="plops" id="plOps" role="group" aria-label="Compañía"></div>
      <div class="plgrid" id="plList"></div>
      <div class="pl70box" id="pl70"></div>
    </div>
    <div class="acc" id="accBox" hidden>
      <div class="acc-h"><span class="lab">Accesorios</span><small id="accInfo">Agrega hasta 3 al cálculo</small>
        <div class="segc" role="group" aria-label="Precio de accesorios"><button type="button" data-accp="int" aria-pressed="true">Precio oferta</button><button type="button" data-accp="cmr" aria-pressed="false">Precio CMR</button></div>
        <button type="button" class="acc-nav" data-accnav="-1" aria-label="Accesorios anteriores">‹</button><button type="button" class="acc-nav" data-accnav="1" aria-label="Más accesorios">›</button></div>
      <div class="acc-rail" id="accRail" role="list"></div>
      <div class="acc-sum" id="accSum"></div>
    </div>
  </div>
</section>

<section class="wrap sec" aria-live="polite">
  <div class="tabs" role="tablist" aria-label="Cuotas">
    <button class="tab" type="button" role="tab" id="tb-res" data-tab="res" aria-selected="true"><span class="sn">1</span>Comparar cuotas</button>
    <button class="tab" type="button" role="tab" id="tb-cov" data-tab="cov" aria-selected="false">Qué cubre la garantía</button>
    <button class="tab" type="button" role="tab" id="tb-ben" data-tab="ben" aria-selected="false">Beneficios para ti</button>
    <button class="qbtn" type="button" id="qOpen"><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>Cotizar por mail</button>
